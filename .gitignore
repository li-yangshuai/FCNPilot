# Dependencies, compiled outputs and local workspaces are reproducible.
**/node_modules/
**/.venv/
**/build/
**/build-*/
**/.next/
**/.next-*/
**/__pycache__/
*.py[cod]
*.so
*.o
*.a
*.tsbuildinfo
**/.pytest_cache/
**/.ruff_cache/
**/.cache/
**/.DS_Store
# Generated Pi registrations are installed from integrations/pi.
**/.pi/
**/output/
experiments/runs/
.local/
.env
.env.*
!.env.example
*.log
!experiments/archive/**/*.log
# Keep publication sources and frozen evidence, not TeX build products.
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.out
paper/*.toc
paper/*.lof
paper/*.lot
paper/*.fls
paper/*.fdb_latexmk
paper/*.synctex.gz
paper/main.pdf
paper/supplementary.pdf
paper/.build/
