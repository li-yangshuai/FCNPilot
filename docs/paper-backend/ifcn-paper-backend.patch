@@ -0,0 +1,169 @@
+"""Independent Boolean source/DAG equivalence by an optional Z3 miter.
+
+This never enumerates 2**inputs or validates physical waveforms. An UNSAT
+output-difference miter proves the supported scalar combinational semantics;
+SAT supplies an input counterexample, and timeout/unknown never grants approval.
+"""
+from __future__ import annotations
+
+import graphlib
+import hashlib
+import json
+import math
+from pathlib import Path
+import re
+import time
+
+from ifcn.logic import expression_tree, canonicalize_identifiers
+from ifcn.verify_logic import SEMANTICS, Unsupported, compile_graph
+
+IDENT = r"[A-Za-z_]\w*"
+CONSTANTS = {"0", "1", "1'b0", "1'b1"}
+
+
+def source_structure(data):
+    """Parse original expressions without the synthesis frontend's rewrites."""
+    text, identifier_map = canonicalize_identifiers(data.decode("utf-8-sig"))
+    module = re.fullmatch(rf"\s*module\s+({IDENT})\s*\(([^)]*)\)\s*;(.*?)\bendmodule\s*", text, re.S)
+    if not module:
+        raise Unsupported("Expected one scalar continuous-assignment module")
+    header, body = module[2], module[3]
+    declarations = {"input": [], "output": [], "wire": []}
+    header_names = []
+    if re.search(r"\b(input|output)\b", header):
+        direction = None
+        for field in header.split(","):
+            port = re.fullmatch(rf"\s*(?:(input|output)\s+(?:wire\s+)?)?({IDENT})\s*", field)
+            if not port or not (port[1] or direction):
+                raise Unsupported("Only scalar ANSI ports are supported")
+            direction = port[1] or direction
+            declarations[direction].append(port[2])
+            header_names.append(port[2])
+    else:
+        header_names = [name.strip() for name in header.split(",")]
+    assignments = {}
+    statements = body.split(";")
+    if statements[-1].strip():
+        raise Unsupported("Missing statement semicolon")
+    for statement in statements[:-1]:
+        declaration = re.fullmatch(r"\s*(input|output|wire)\s+(.+?)\s*", statement, re.S)
+        assignment = re.fullmatch(rf"\s*assign\s+({IDENT})\s*=\s*(.+?)\s*", statement, re.S)
+        if declaration:
+            names = [name.strip() for name in declaration[2].split(",")]
+            if any(not re.fullmatch(IDENT, name) for name in names):
+                raise Unsupported("Only scalar named declarations are supported")
+            declarations[declaration[1]].extend(names)
+        elif assignment:
+            if assignment[1] in assignments:
+                raise Unsupported("Multiple assignment drivers")
+            assignments[assignment[1]] = expression_tree(assignment[2])
+        elif statement.strip():
+            raise Unsupported("Unsupported statement in original source")
+    ports = declarations["input"] + declarations["output"]
+    if len(ports) != len(set(ports)) or len(declarations["wire"]) != len(set(declarations["wire"])):
+        raise Unsupported("Duplicate signal or port declaration")
+    port_names = set(ports)
+    declarations["wire"] = [name for name in declarations["wire"] if name not in port_names]
+    names = sum(declarations.values(), [])
+    if len(names) != len(set(names)) or not declarations["input"] or not declarations["output"]:
+        raise Unsupported("Missing or duplicate input/output/declaration names")
+    inputs, declared = set(declarations["input"]), set(names)
+
+    def references(tree):
+        if tree[0] == "value":
+            return set() if tree[1] in CONSTANTS else {tree[1]}
+        return set().union(*(references(child) for child in tree[1:]))
+
+    dependencies = {}
+    for target, tree in assignments.items():
+        refs = references(tree)
+        if target not in declared or target in inputs or not refs <= declared:
+            raise Unsupported("Undeclared signal or assignment to primary input")
+        if not refs <= inputs | assignments.keys():
+            raise Unsupported("Undriven source signal")
+        dependencies[target] = refs - inputs
+    if not set(declarations["output"]) <= assignments.keys():
+        raise Unsupported("An output has no continuous-assignment driver")
+    try:
+        order = list(graphlib.TopologicalSorter(dependencies).static_order())
+    except graphlib.CycleError as error:
+        raise Unsupported("Combinational source cycle") from error
+    return {"module": module[1], "input_ports": declarations["input"], "identifier_map": identifier_map,
+            "output_ports": declarations["output"], "assignments": assignments, "order": order,
+            "header_matches_declarations": set(header_names) == inputs | set(declarations["output"]),
+            "pure_aliases": {name: tree[1] for name, tree in assignments.items()
+                             if tree[0] == "value" and tree[1] not in CONSTANTS}}
+
+
+def verify_sat_bytes(source_bytes, dag_bytes, *, z3_root=None, timeout_seconds=30.0):
+    started = time.monotonic()
+    digest = lambda data: hashlib.sha256(data).hexdigest()
+    report = {"schema": "ifcn.routed_logic_audit.v1", "method": "z3_boolean_miter",
+              "scope": "Exact Boolean source/DAG equivalence; excludes physical waveforms and clock latency",
+              "source_sha256": digest(source_bytes), "routed_dag_sha256": digest(dag_bytes),
+              "status": "unsupported", "equivalent": None, "vectors_checked": 0,
+              "counterexamples": [], "timeout_seconds": timeout_seconds}
+    try:
+        if not math.isfinite(timeout_seconds) or timeout_seconds <= 0:
+            raise ValueError("SAT timeout must be finite and positive")
+        source = source_structure(source_bytes)
+        dag = json.loads(dag_bytes)
+        nodes, incoming, order, input_nodes, output_mapping = compile_graph(dag, source)
+        report.update(input_ports=source["input_ports"], output_ports=source["output_ports"],
+                      source_identifier_map=source["identifier_map"],
+                      source_header_matches_declarations=source["header_matches_declarations"],
+                      input_mapping=[{"source_port": name, "dag_node_id": input_nodes[name], "basis": "exact_name"}
+                                     for name in source["input_ports"]], output_mapping=output_mapping,
+                      gate_semantics={kind: SEMANTICS[kind] for kind in sorted({n['type'].lower() for n in nodes.values()})})
+        from ifcn.sequential.solve_global_clock_z3 import DEFAULT_Z3_ROOT, load_z3
+        z3 = load_z3(Path(z3_root) if z3_root else DEFAULT_Z3_ROOT)
+        report["solver_version"] = z3.get_version_string()
+        values = {name: z3.Bool("input_" + str(i)) for i, name in enumerate(source["input_ports"])}
+
+        def expression(tree):
+            op = tree[0]
+            if op == "value":
+                return z3.BoolVal(tree[1] in {"1", "1'b1"}) if tree[1] in CONSTANTS else values[tree[1]]
+            if op == "~":
+                return z3.Not(expression(tree[1]))
+            return {"&": z3.And, "|": z3.Or, "^": z3.Xor}[op](expression(tree[1]), expression(tree[2]))
+
+        for name in source["order"]:
+            values[name] = expression(source["assignments"][name])
+        routed = {input_nodes[name]: values[name] for name in source["input_ports"]}
+        for node_id in order:
+            kind = nodes[node_id]["type"].lower()
+            if kind == "input":
+                continue
+            args = [routed[parent] for parent in incoming[node_id]]
+            if kind == "and": result = z3.And(*args)
+            elif kind == "or": result = z3.Or(*args)
+            elif kind == "not": result = z3.Not(args[0])
+            elif kind in ("maj", "majority"):
+                result = z3.Or(z3.And(args[0], args[1]), z3.And(args[0], args[2]), z3.And(args[1], args[2]))
+            else: result = args[0]
+            routed[node_id] = result
+        remaining = timeout_seconds - (time.monotonic() - started)
+        if remaining <= 0:
+            report.update(status="unknown", reason="SAT preparation exhausted time budget")
+            return report
+        solver = z3.Solver()
+        solver.set(timeout=max(1, int(remaining * 1000)))
+        solver.add(z3.Or(*[z3.Xor(values[item["source_port"]], routed[item["dag_node_id"]]) for item in output_mapping]))
+        answer = solver.check()
+        if answer == z3.unsat:
+            report.update(status="equivalent", equivalent=True, proof="output_difference_miter_unsat")
+        elif answer == z3.sat:
+            model = solver.model()
+            bit = lambda term: int(z3.is_true(model.eval(term, model_completion=True)))
+            report.update(status="not_equivalent", equivalent=False,
+                          counterexamples=[{"inputs": {name: bit(values[name]) for name in source["input_ports"]},
+                                            "source_outputs": {name: bit(values[name]) for name in source["output_ports"]},
+                                            "dag_outputs": {item["source_port"]: bit(routed[item["dag_node_id"]]) for item in output_mapping}}])
+        else:
+            report.update(status="unknown", reason=solver.reason_unknown())
+    except (ValueError, KeyError, TypeError, UnicodeError, ImportError, RuntimeError) as error:
+        report["reason"] = str(error)
+    finally:
+        report["seconds"] = round(time.monotonic() - started, 6)
+    return report
