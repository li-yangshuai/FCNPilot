+class ContactWindowTests(unittest.TestCase):
+    def test_shared_contact_detects_conflict_hidden_by_endpoint_window(self):
+        points = [(0, 0), (4, 0), (2, 0), (9, 9)]
+        contract = anchored_contract(points, {0: 0, 1: 4, 2: 3})
+        windows = clock_repair.ContactWindows(contract)
+        self.assertEqual(windows.upper(0, 1), 4)
+        self.assertEqual(windows.upper(1, 0), -4)
