+import assert from "node:assert/strict";
+import test from "node:test";
+import { buildPrompt, decide, validateDecision, buildCooperationPrompt,
+  validateCooperationDecision } from "../scripts/ifcn_multi_agent_model.mjs";
+
+const request = { role: "placement", context: { available_actions: ["explore", "compact"],
+  best_metrics: { area_tiles: 12 }, last_feedback: "legal incumbent" }, timeout_ms: 1000, max_tokens: 128 };
+const decision = { schema: "ifcn.agent_decision.v1", action: "compact", rationale: "Try reducing measured area." };
+const factory = answer => async () => ({ provider: "offline-test", model: "fake", complete: async (prompt, options) => {
+  assert.deepEqual(prompt.tools, []);
+  assert.equal(options.maxRetries, 0);
+  assert.equal(options.maxTokens, 128);
+  return answer;
+} });
+
+test("four specialist prompts are distinct, bounded and tool-free", () => {
+  const prompts = ["placement", "routing", "clock", "validation"].map(role => buildPrompt({ ...request, role }));
+  assert.equal(new Set(prompts.map(prompt => prompt.systemPrompt)).size, 4);
+  assert.ok(prompts.every(prompt => prompt.tools.length === 0));
+});
+
+test("one completion produces an allowlisted structured decision and usage", async () => {
+  const result = await decide(request, { runtimeFactory: factory({ stopReason: "stop",
+    content: [{ type: "text", text: JSON.stringify(decision) }], usage: { input: 20, output: 5, secret: "not copied" } }) });
+  assert.equal(result.status, "ok");
+  assert.deepEqual(result.decision, decision);
+  assert.equal(result.model_call_started, true);
+  assert.equal(result.usage.input, 20);
+  assert.ok(!JSON.stringify(result).includes("not copied"));
+});
+
+test("unknown action, extra execution fields and markdown are rejected", async () => {
+  assert.throws(() => validateDecision({ ...decision, action: "shell" }, ["explore", "compact"]));
+  assert.throws(() => validateDecision({ ...decision, code: "unsafe" }, ["explore", "compact"]));
+  const result = await decide(request, { runtimeFactory: factory({ stopReason: "stop",
+    content: [{ type: "text", text: "```json\n" + JSON.stringify(decision) + "\n```" }] }) });
+  assert.equal(result.error.code, "invalid_response");
+  assert.equal(result.decision, null);
+});
+
+test("provider exceptions and error content never expose raw diagnostics", async () => {
+  const result = await decide(request, { runtimeFactory: async () => { throw new Error("SECRET_provider_key"); } });
+  assert.equal(result.status, "error");
+  assert.equal(result.model_call_started, false);
+  assert.ok(!JSON.stringify(result).includes("SECRET"));
+  const rejected = await decide(request, { runtimeFactory: factory({ stopReason: "error", errorMessage: "SECRET",
+    content: [{ type: "text", text: "SECRET" }] }) });
+  assert.equal(rejected.error.code, "provider_error");
+  assert.ok(!JSON.stringify(rejected).includes("SECRET"));
+});
+
+test("timeout returns an audited failure even if the transport never settles", async () => {
+  const result = await decide({ ...request, timeout_ms: 10 }, { runtimeFactory: async () => ({
+    provider: "offline-test", model: "fake", complete: async () => new Promise(() => {}),
+  }) });
+  assert.equal(result.status, "error");
+  assert.equal(result.error.code, "timeout");
+  assert.equal(result.model_call_started, true);
+});
+
+test("tool calls and truncated completions cannot authorize an action", async () => {
+  for (const answer of [{ stopReason: "length", content: [{ type: "text", text: JSON.stringify(decision) }] },
+    { stopReason: "stop", content: [{ type: "toolCall", name: "execute" }] }]) {
+    const result = await decide(request, { runtimeFactory: factory(answer) });
+    assert.equal(result.status, "error");
+    assert.equal(result.decision, null);
+  }
+});
+
+const cooperationRequest = {
+  schema: "ifcn.cooperation_model_request.v1", snapshot_id: "frozen-geometry-17", role: "routing",
+  context: { options: [
+    { option_id: "route-branch-a", priority_edges: [[2, 9], [4, 9]], required_free_cells: [[5, 3]],
+      conditions: { clock_branch: "conflict-a" } },
+    { option_id: "route-branch-b", priority_edges: [[4, 9], [2, 9]], required_free_cells: [[6, 3]],
+      conditions: { clock_branch: "conflict-b" } },
+  ], conflict_witness: { status: "infeasible_fixed_geometry", routes: [2, 4] } },
+  prior_messages: [{ snapshot_id: "frozen-geometry-17", role: "clock", option_id: "conflict-a",
+    rationale: "Reconstruct the first branch's conflicting path constraints." }],
+  timeout_ms: 1000, max_tokens: 128,
+};
+const cooperationDecision = { schema: "ifcn.cooperation_decision.v1", snapshot_id: "frozen-geometry-17",
+  role: "routing", option_id: "route-branch-a", rationale: "Request the free cell required by the clock-selected branch." };
+
+test("cooperation prompts preserve snapshot-bound peer conditions and immutable options", () => {
+  const before = structuredClone(cooperationRequest);
+  const prompts = ["clock", "routing", "placement", "planner"].map(role =>
+    buildCooperationPrompt({ ...cooperationRequest, role }));
+  assert.equal(new Set(prompts.map(prompt => prompt.systemPrompt)).size, 4);
+  for (const prompt of prompts) {
+    assert.deepEqual(prompt.tools, []);
