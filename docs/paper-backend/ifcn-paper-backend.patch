+def and_candidate(width=3, output_epoch=1):
+    target = width - 1
+    nodes = [
+        {"id": 0, "name": "a", "type": "input", "x": 0, "y": 0,
+         "is_input": True, "is_output": False},
+        {"id": 1, "name": "b", "type": "input", "x": 0, "y": 2,
+         "is_input": True, "is_output": False},
+        {"id": 2, "name": "y", "type": "and", "x": target, "y": 1,
+         "is_input": False, "is_output": True},
+    ]
+    paths = [[[x, y] for x in range(width)] + [[target, 1]] for y in (0, 2)]
+    cells = []
+    for x, y in sorted({tuple(p) for path in paths for p in path}):
+        phase = output_epoch + 1 if (x, y) == (target, 1) else 1
+        if output_epoch == 2 and x == target and y != 1:
+            phase = 2
+        cells.append({"x": x, "y": y, "phase": phase})
+    return {"schema": "ifcn.native_candidate.v1", "algorithm": "offline_protocol_fixture",
+            "routed": True, "native_mapping_valid": True, "phase_count": 4,
+            "nodes": nodes, "edges": [[0, 2], [1, 2]], "layers": [[0, 1], [2]],
+            "routes": [{"source": source, "target": 2, "path": path}
+                       for source, path in enumerate(paths)], "cells": cells,
+            "metrics": {"physical_cells": 20 + width * 10},
+            "evaluation": {"status": "valid"}}
+
+
