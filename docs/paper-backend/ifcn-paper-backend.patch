+                {"op": "move", "node": 2, "x": 1, "y": 1}]
+        result = cooperation.apply_edits(self.base, swap, allow_port_moves=False)
+        self.assertEqual((result[1], result[2]), ((2, 1), (1, 1)))
+        self.assertEqual(self.base, saved)
+        with self.assertRaises(ValueError):
+            cooperation.apply_edits(self.base, swap[:1], allow_port_moves=False)
+        with self.assertRaises(ValueError):
