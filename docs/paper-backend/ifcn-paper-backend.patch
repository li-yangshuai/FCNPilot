+            if (window.upperBounded) value["upper"] = window.upper;
+            windows.push_back(value);
+        }
+        for (auto edge : order) releasedEdges.push_back(json::array{edge.first, edge.second});
+        for (auto edge : declaredEdges) if (!orderSet.count(edge)) frozenEdges.push_back(json::array{edge.first, edge.second});
