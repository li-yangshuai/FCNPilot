+        if (!validateJuneFanoutTrees(routes, ownershipError)) return fail(ownershipError);
+        for (auto& entry : links)
+            for (auto* ports : {&entry.second.first, &entry.second.second}) {
+                std::sort(ports->begin(), ports->end());
+                ports->erase(std::unique(ports->begin(), ports->end()), ports->end());
+            }
+        if (cancellationRequested()) return fail("provided-route validation cancelled");
+        Mapping mapping;
+        mapping.node_mapping(links, MappingMode::Combinational);
+        mapping.mapping_line(geometry, MappingMode::Combinational);
+        std::string crossoverError;
+        if (!mapping.validate_crossovers(&crossoverError)) return fail("device crossover: " + crossoverError);
+        if (cancellationRequested()) return fail("provided-route validation cancelled");
+        return true;
+    }
+
+    bool CircuitGraph::validateProvidedIrregularRoutes(
+        const ProvidedRoutes& fullRoutes, int phaseCount, int maxSamePhase, std::string* error)
+    {
+        if (phaseCount != 4 || maxSamePhase != 4)
+            throw std::invalid_argument("provided routes require the current four-phase clock model");
+        if (!loadProvidedIrregularRoutes(fullRoutes, error)) return false;
+        const bool valid = validateJuneRandomClockRoutedLayout(phaseCount, maxSamePhase);
+        if (!valid && error && error->empty())
+            *error = clockFeedbackAvailable ? clockFeedback.message : "provided routes failed native validation";
+        return valid;
+    }
