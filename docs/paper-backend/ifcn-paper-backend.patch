+"""Frozen-geometry route repair using conditional absolute-clock contracts.
+
+Clock and routing specialists exchange checkable constraints and concrete paths.
+Optional model policies select concrete contract queries and path bundles; the
+deterministic centralized policy has the same tools. Filter ablations enumerate
+the same finite geometric pool. A window only
+rejects a necessary-condition violation; native global validation is mandatory.
+"""
+from __future__ import annotations
+
+from collections import Counter, defaultdict
+import hashlib
+import heapq
+import itertools
+import json
+from pathlib import Path
+import subprocess
+import time
+
+from .cooperation import bounds, checked, digest, metrics, positions, write_json
+
+CONDITIONS = ("path_geometry", "endpoint_window", "clock_window", "no_fanout", "centralized",
+              "llm_single", "llm_independent", "llm_negotiated")
+
+
+def path_epoch_range(length, primary_input=False, max_same_phase=4):
+    """Exact advance range of one isolated path (length counts edges)."""
+    if type(length) is not int or length < 1 or max_same_phase < 1:
+        raise ValueError("A path needs at least one edge and a positive phase-run limit")
+    if length == 1:
+        return 1, 1
+    lower = ((length + max_same_phase - 1) // max_same_phase if primary_input else
+             1 + (length - 1 + max_same_phase - 1) // max_same_phase)
+    return lower, length
+
+
+def routes_of(snapshot):
+    return {(r["source"], r["target"]): tuple(map(tuple, r["path"]))
+            for r in snapshot["routes"]}
+
+
+def orientation(a, b, c):
+    return "H" if a[1] == b[1] == c[1] else "V" if a[0] == b[0] == c[0] else "B"
+
+
+class FrozenGeometry:
+    """Cheap necessary ownership checks; native cell mapping is authoritative."""
+    def __init__(self, snapshot, release_edges=()):
+        self.nodes = positions(snapshot)
+        self.gates = set(self.nodes.values())
+        self.box = bounds(list(self.gates) + [p for r in routes_of(snapshot).values() for p in r])
+        self.incoming = {}
+        self.uses = defaultdict(lambda: defaultdict(set))
+        release = set(map(tuple, release_edges))
+        for edge, path in routes_of(snapshot).items():
+            if edge not in release:
+                self.add(edge, path)
+
+    def add(self, edge, path):
+        for a, b in zip(path, path[1:]):
+            self.incoming[(edge[0], b)] = a
+        for a, b, c in zip(path, path[1:], path[2:]):
+            self.uses[b][edge[0]].add(orientation(a, b, c))
+
+    def accepts(self, edge, path):
+        if (len(path) < 2 or path[0] != self.nodes[edge[0]] or path[-1] != self.nodes[edge[1]]
+                or len(set(path)) != len(path) or any(p in self.gates for p in path[1:-1])):
+            return False
+        x0, y0, x1, y1 = self.box
+        if any(not (x0 <= x <= x1 and y0 <= y <= y1) for x, y in path):
+            return False
+        for a, b in zip(path, path[1:]):
+            if abs(a[0] - b[0]) + abs(a[1] - b[1]) != 1:
+                return False
+            previous = self.incoming.get((edge[0], b))
+            if previous is not None and previous != a:
+                return False  # A source tree must not split and rejoin.
+        for a, b, c in zip(path, path[1:], path[2:]):
+            uses = self.uses.get(b, {})
+            foreign = [v for source, v in uses.items() if source != edge[0]]
+            if foreign:
+                own = uses.get(edge[0], set()) | {orientation(a, b, c)}
+                if (len(foreign) != 1 or len(own) != 1 or
+                        not ((own == {"H"} and foreign[0] == {"V"}) or
+                             (own == {"V"} and foreign[0] == {"H"}))):
+                    return False
+        return True
+
+
+def _polyline(corners):
+    result = [corners[0]]
+    for a, b in zip(corners, corners[1:]):
+        if a[0] != b[0] and a[1] != b[1]:
+            raise ValueError("Polyline must be rectilinear")
+        axis = 0 if a[0] != b[0] else 1
+        step = 1 if b[axis] > a[axis] else -1
+        for v in range(a[axis] + step, b[axis] + step, step):
+            result.append((v, a[1]) if axis == 0 else (a[0], v))
+    return tuple(result)
+
+
+def _route_pool(snapshot, edge, frozen, max_paths):
+    """Bounded local rectangular splices, independent of all clock feedback."""
+    old = routes_of(snapshot)[edge]
+    found = {old}
+    # Up to 24 evenly spaced contacts plus all endpoints. No clock-derived
+    # contacts enter the generator: pool hashes must match the hidden control.
+    indices = sorted({round(i * (len(old) - 1) / min(23, len(old) - 1))
+                      for i in range(min(24, len(old)))})
+    x0, y0, x1, y1 = frozen.box
+    for i, j in itertools.combinations(indices, 2):
+        a, b = old[i], old[j]
+        xs = sorted({a[0], b[0], (a[0] + b[0]) // 2,
+                     *[p + d for p in (a[0], b[0]) for d in (-3, -2, -1, 1, 2, 3)]})
+        ys = sorted({a[1], b[1], (a[1] + b[1]) // 2,
+                     *[p + d for p in (a[1], b[1]) for d in (-3, -2, -1, 1, 2, 3)]})
+        shapes = ((a, (x, a[1]), (x, b[1]), b) for x in xs if x0 <= x <= x1)
+        shapes_y = ((a, (a[0], y), (b[0], y), b) for y in ys if y0 <= y <= y1)
+        for corners in itertools.chain(shapes, shapes_y):
+            path = old[:i] + _polyline(corners) + old[j + 1:]
+            if path not in found and frozen.accepts(edge, path):
+                found.add(path)
+    # Keep different lengths, then geometries. Long paths can repair an early
+    # arrival, so taking only the shortest alternatives would bias the pool.
+    buckets = defaultdict(list)
+    for path in found - {old}:
+        buckets[len(path)].append(path)
+    for paths in buckets.values():
+        paths.sort(key=lambda p: (len(set(p) ^ set(old)), p))
+    order = []
+    while buckets and len(order) < max_paths - 1:
+        for length in sorted(list(buckets)):
+            order.append(buckets[length].pop(0))
+            if not buckets[length]:
+                del buckets[length]
+            if len(order) >= max_paths - 1:
+                break
+    return [old] + order
+
+
+def generate_path_pool(snapshot, release_edges, max_paths=12):
+    """Return exact replacement bundles, all inside the original occupied box."""
+    release = tuple(sorted(map(tuple, release_edges)))
+    if not 1 <= len(release) <= 3 or len(set(release)) != len(release) or max_paths < 2:
+        raise ValueError("Release one to three unique edges; allow at least two paths")
+    old = routes_of(snapshot)
+    if any(e not in old for e in release):
+        raise ValueError("Unknown released edge")
+    frozen = FrozenGeometry(snapshot, release)
+    paths = [_route_pool(snapshot, e, frozen, max_paths) for e in release]
+    combinations = sorted(itertools.product(*paths), key=lambda group:
+                          (sum(len(p) for p in group), sum(p != old[e] for e, p in zip(release, group)), group))
+    pool = []
+    # Candidate enumeration is bounded independently of the evaluation budget.
+    for group in combinations:
+        changed = [e for e, p in zip(release, group) if p != old[e]]
+        if not changed:
+            continue
+        geometry = FrozenGeometry(snapshot, release)
+        for edge, path in zip(release, group):
+            if not geometry.accepts(edge, path):
+                break
+            geometry.add(edge, path)
+        else:
+            replacements = [{"source": e[0], "target": e[1], "path": [list(p) for p in path]}
+                            for e, path in zip(release, group)]
+            pool.append({"option_id": digest(replacements), "release_edges": [list(e) for e in release],
+                         "route_replacements": replacements, "changed_edges": [list(e) for e in changed],
+                         "wire_delta": sum(len(p) - len(old[e]) for e, p in zip(release, group))})
+        if len(pool) >= 256:
+            break
+    return pool
+
+
+class ContactWindows:
+    """Tight frozen-system differences at route contacts, cached per source.
+
+    Reweighting by a feasible potential makes every retained edge nonnegative.
+    A shortest-path bound has exactly the same meaning as an endpoint window;
+    it also detects incompatible contacts at crossings and shared fanout tiles.
+    """
+    def __init__(self, contract):
+        self.points = {tuple(p): i for i, p in enumerate(contract["positions"])}
+        count = len(self.points) + 1
+        self.adj = [[] for _ in range(count)]
+        constraints = contract["retained_constraints"]
+        # Do not depend on a serialized potential's convention for virtual zero.
+        potential = [0] * count
+        for _ in range(count):
+            changed = False
+            for c in constraints:
+                a, b, w = c["from"], c["to"], c["upper"]
+                if potential[b] > potential[a] + w:
+                    potential[b] = potential[a] + w
+                    changed = True
+            if not changed:
+                break
+        else:
+            raise ValueError("Feasible contract contains a negative cycle")
+        self.potential = potential
+        for c in constraints:
+            a, b, w = c["from"], c["to"], c["upper"]
+            self.adj[a].append((b, w + potential[a] - potential[b]))
+        self.cache = {}
+
+    def upper(self, a, b):
+        if a not in self.cache:
+            dist = {a: 0}
+            queue = [(0, a)]
+            while queue:
+                d, v = heapq.heappop(queue)
+                if d != dist[v]:
+                    continue
+                for target, weight in self.adj[v]:
+                    value = d + weight
+                    if value < dist.get(target, float("inf")):
+                        dist[target] = value
+                        heapq.heappush(queue, (value, target))
+            self.cache[a] = dist
+        d = self.cache[a].get(b)
+        return None if d is None else d - self.potential[a] + self.potential[b]
+
+    def reject(self, path, primary_input):
+        contacts = [(i, self.points[p]) for i, p in enumerate(map(tuple, path)) if p in self.points]
+        for (i, a), (j, b) in itertools.combinations(contacts, 2):
+            length = j - i
+            first = i == 0 and not primary_input
+            last = j == len(path) - 1
+            lower = length // 4
+            if first or last:
+                lower = (length + 3) // 4
+            if first and last:
+                lower = path_epoch_range(length)[0]
+            upper = self.upper(a, b)
+            reverse = self.upper(b, a)
+            if (upper is not None and lower > upper) or (reverse is not None and length < -reverse):
+                return {"kind": "contact_window_disjoint", "segment": [i, j],
+                        "tiles": [a, b], "path_range": [lower, length],
+                        "frozen_range": [None if reverse is None else -reverse, upper]}
+        return None
+
+
+def window_filter(snapshot, group_options, contract):
+    """Return (option, rejection-or-None); passing is never a certificate."""
+    if contract.get("status") == "infeasible_fixed_geometry":
+        return [(o, {"kind": "remaining_constraints_infeasible"}) for o in group_options]
+    if contract.get("status") != "feasible":
+        return [(o, {"kind": "contract_unavailable"}) for o in group_options]
+    inputs = {n["id"] for n in snapshot["nodes"] if n.get("is_input")}
+    contacts = ContactWindows(contract)
+    result = []
+    for option in group_options:
+        reason = None
+        for route in option["route_replacements"]:
+            reason = contacts.reject(route["path"], route["source"] in inputs)
+            if reason:
+                reason = dict(reason, edge=[route["source"], route["target"]])
+                break
+        result.append((option, reason))
+    return result
+
+
+def endpoint_filter(snapshot, group_options, contract):
+    """Endpoint-only ablation; never changes shared pool generation."""
+    if contract.get("status") == "infeasible_fixed_geometry":
+        return [(o, {"kind": "remaining_constraints_infeasible"}) for o in group_options]
+    if contract.get("status") != "feasible":
+        return [(o, {"kind": "contract_unavailable"}) for o in group_options]
+    windows = {tuple(w["edge"]): w for w in contract.get("windows", [])}
+    inputs = {n["id"] for n in snapshot["nodes"] if n.get("is_input")}
+    result = []
+    for option in group_options:
+        rejection = None
+        for route in option["route_replacements"]:
+            edge = (route["source"], route["target"])
+            window = windows.get(edge)
+            # Missing projected endpoints give no evidence for rejection.
+            if window is None:
+                continue
+            low, high = path_epoch_range(len(route["path"]) - 1, edge[0] in inputs)
+            lo, hi = window.get("lower"), window.get("upper")
+            if (hi is not None and low > hi) or (lo is not None and high < lo):
+                rejection = {"kind": "endpoint_window_disjoint", "edge": list(edge),
+                             "path_range": [low, high], "frozen_range": [lo, hi]}
+                break
+        result.append((option, rejection))
+    return result
+
+
+def _witness_edges(feedback):
+    route_edges = feedback.get("route_edges", [])
+    counts = Counter()
+    for c in feedback.get("conflict_witness", []):
+        edge = c.get("route")
+        index = c.get("route_index")
+        if edge is None and type(index) is int and 0 <= index < len(route_edges):
+            edge = route_edges[index]
+        if edge is not None:
+            counts[tuple(edge)] += 1
+    return sorted(counts, key=lambda e: (-counts[e], e))
+
+
+def fanout_release_requests(snapshot, release_edges):
+    """Routing requests a frozen sibling whose shared trunk limits an edit.
+
+    This is a geometric dependency, not a proof that releasing it suffices.
+    Clock must recompute the contract for the larger release set.
+    """
+    paths = routes_of(snapshot)
+    release = set(map(tuple, release_edges))
+    scores = Counter()
+    for edge in release:
+        path = paths[edge]
+        for other, sibling in paths.items():
+            if other in release or edge[0] != other[0]:
+                continue
+            shared = 0
+            for a, b in zip(path, sibling):
+                if a != b:
+                    break
+                shared += 1
+            if shared > 1:
+                scores[other] += shared - 1
+    return [{"edge": list(e), "shared_trunk_edges": scores[e],
+             "reason": "frozen_same_source_trunk"} for e in sorted(scores, key=lambda e: (-scores[e], e))]
+
+
+def _native(command, directory, seconds):
+    start = time.monotonic()
+    try:
+        p = subprocess.run(command, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE,
+                           timeout=max(0.01, seconds) + 3)
+        (directory / "native.stderr").write_bytes(p.stderr[:16384])
+        code = p.returncode
+    except subprocess.TimeoutExpired:
+        code = -1
+    return code, time.monotonic() - start
+
+
+def frozen_candidate_matches(base, candidate, replacements):
+    before, after = routes_of(base), routes_of(candidate)
+    proposed = {(r["source"], r["target"]): tuple(map(tuple, r["path"])) for r in replacements}
+    return (candidate["nodes"] == base["nodes"] and candidate["edges"] == base["edges"]
+            and candidate.get("layers") == base.get("layers")
+            and set(before) == set(after) and all(after[e] == proposed.get(e, p) for e, p in before.items()))
+
+
+def run_clock_contract_repair(binary, source, snapshot, output, *, condition="clock_window",
+                              max_evaluations=24, evaluation_seconds=1, contract_seconds=2,
+                              max_contracts=12, max_paths=12, reference=None, wall_seconds=120,
+                              model_config=None):
+    """Repair one failed snapshot. Every control has identical frozen geometry."""
+    if condition not in CONDITIONS:
+        raise ValueError("Unknown clock-repair condition")
+    if min(max_evaluations, evaluation_seconds, contract_seconds, max_contracts, wall_seconds) <= 0:
+        raise ValueError("Budgets must be positive")
+    binary, source, snapshot, output = map(lambda p: Path(p).resolve(), (binary, source, snapshot, output))
+    output.mkdir(parents=True, exist_ok=False)
+    started = time.monotonic()
+    deadline = started + wall_seconds
+    base = json.loads(snapshot.read_text())
+    sid = hashlib.sha256(snapshot.read_bytes()).hexdigest()
+    old = routes_of(base)
+    if not 1 <= len(base["nodes"]) <= 149 or set(old) != set(map(tuple, base["edges"])):
+        raise ValueError("Repair requires a complete routed DAG with fewer than 150 nodes")
+    caps = None
+    if reference is not None:
+        ref = json.loads(Path(reference).read_text())
+        valid, caps, _ = checked(ref)
+        if not valid:
+            raise ValueError("Reference for output epoch caps must be legal")
+        identity = lambda d: sorted((n["id"], n.get("name"), n.get("type"),
+                                     n.get("is_input"), n.get("is_output")) for n in d["nodes"])
+        if identity(base) != identity(ref) or sorted(base["edges"]) != sorted(ref["edges"]):
+            raise ValueError("Reference DAG differs from failed snapshot")
+    initial_status = base.get("clock_feedback", {}).get("status")
+    pool, events, contracts = [], [], []
+    native_seconds = analysis_seconds = 0.0
+    generation_seconds = window_seconds = model_seconds = 0.0
+    model_calls, policy_decisions = [], []
+    model_condition = condition.startswith("llm_")
+    if model_condition and (not model_config or model_config.get("max_calls", 0) < 1):
+        raise ValueError("Model conditions require a positive explicit model call budget")
+    allowance = int((model_config or {}).get("max_calls", 0))
+    stage_allowances = {"contract": allowance // 2, "path": allowance - allowance // 2}
+    stage_used = {"contract": 0, "path": 0}
+    def choose(stage, options, context, history=()):
+        nonlocal model_seconds
+        if (not model_condition or len(options) < 2 or
