+            event = {"evaluation": calls, "cycle": cycle, "round": round_index, "snapshot_id": sid,
+                     "parent_path": str(base_path), "proposal_sha256": key, "command": command,
+                     "messages": current_messages, "native_seconds": elapsed, "exit_code": exit_code,
+                     "candidate_path": str(candidate_path) if candidate else None,
+                     "status": (candidate or {}).get("evaluation", {}).get("status", "process_failed"),
