+            break
+        seconds = min(evaluation_seconds, remaining)
+        command = [str(binary), "evaluate", str(source), str(snapshot), str(folder / "proposal.json"),
+                   str(candidate_path), "--budget", str(seconds)]
+        code, elapsed = _native(command, folder, seconds)
+        native_seconds += elapsed
+        event = {"evaluation": calls, "option_id": option["option_id"], "contract_index": option["contract_index"],
+                 "release_edges": option["release_edges"], "changed_edges": option["changed_edges"],
+                 "window_rejection": option["window_rejection"], "native_seconds": elapsed,
+                 "candidate_path": str(candidate_path) if candidate_path.exists() else None,
+                 "exit_code": code, "accepted": False, "status": "process_failed"}
+        if candidate_path.exists():
+            candidate = json.loads(candidate_path.read_text())
+            event["status"] = candidate.get("evaluation", {}).get("status", "unknown")
+            valid, epochs, validation = checked(candidate, caps)
+            exact = (candidate.get("evaluation", {}).get("snapshot_id") == sid and
+                     frozen_candidate_matches(base, candidate, proposal["route_replacements"]) and
+                     metrics(candidate)["area_tiles"] <= metrics(base)["area_tiles"])
+            event.update(valid=valid and exact, geometry_fixed=exact, output_epochs=epochs)
+            if not exact:
+                validation = {"passed": False, "errors": ["Frozen snapshot or exact path contract violated"]}
+            write_json(folder / "validation.json", validation)
+            if valid and exact and time.monotonic() <= deadline:
