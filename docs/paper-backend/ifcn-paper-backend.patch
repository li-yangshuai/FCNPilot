+    CombinationalClockWindowFeedback result;
+    result.tileCount = feedback.tileCount;
+    const auto fail = [&](const char *message, Status status = Status::Invalid) {
+        result.status = status;
+        result.message = message;
+        result.absoluteEpochs.clear();
+        result.windows.clear();
+        if (status != Status::InfeasibleFixedGeometry) {
+            result.conflictWitness.clear();
+            result.witnessUpperSum = 0;
+        }
+        if (status == Status::Invalid) result.retainedConstraints.clear();
+        return result;
+    };
+    const auto interrupted = [&]() { return cancelled && cancelled(); };
+    if (interrupted()) return fail("conditional clock search cancelled", Status::Cancelled);
+    if ((feedback.status != Status::Feasible && feedback.status != Status::InfeasibleFixedGeometry) ||
+        feedback.fixedPhaseValidation || !feedback.constraintsComplete ||
+        feedback.tileCount != feedback.sourceProblem.tileCount || feedback.tileCount == 0 ||
+        feedback.tileCount >= feedback.constraints.size())
+        return fail("conditional clock input lacks complete, unfixed authoritative feedback");
+
+    std::vector<CombinationalClockBound> rebuilt;
+    std::string constructionError;
+    bool constructionCancelled = false;
+    if (!combinational_clock_detail::buildBounds(feedback.sourceProblem, rebuilt,
+                                                constructionError, nullptr, 4, cancelled,
+                                                constructionCancelled))
+        return fail(constructionError.c_str(), constructionCancelled ? Status::Cancelled : Status::Invalid);
+    if (rebuilt.size() != feedback.constraints.size())
+        return fail("conditional clock input is incomplete or stale");
+    for (std::size_t i = 0; i < rebuilt.size(); ++i) {
+        if (i % 256 == 0 && interrupted()) return fail("conditional clock search cancelled", Status::Cancelled);
+        if (!combinational_clock_detail::sameBound(rebuilt[i], feedback.constraints[i]))
+            return fail("conditional clock input changed an exact bound or its provenance");
