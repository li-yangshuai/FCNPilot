@@ -0,0 +1,628 @@
+"""Bounded, snapshot-bound collaboration for exact FCN layout edits.
+
+The native evaluator executes one explicit route order, with no hidden repair
+portfolio. Specialists own clock-conflict selection, route order/space requests,
+and exact placement edits. Model decisions select concrete, tool-generated
+partials; they cannot certify a candidate or relax design rules.
+"""
+from __future__ import annotations
+
+import hashlib
+import itertools
+import json
+import math
+from pathlib import Path
+import subprocess
+import time
+
+from .layout_validation import validate_candidate
+from .multi_agent import stop_process, parse_json
+
+CONDITIONS = ("greedy", "independent", "negotiated", "no_witness",
+              "llm_single", "llm_independent", "llm_negotiated",
+              "negotiated_quotes", "quotes_hidden", "llm_negotiated_quotes", "llm_quotes_hidden")
+ROOT = Path(__file__).resolve().parents[3]
+
+
+def write_json(path, value):
+    path = Path(path)
+    temporary = path.with_suffix(path.suffix + ".part")
+    temporary.write_text(json.dumps(value, indent=2, ensure_ascii=False, allow_nan=False) + "\n")
+    temporary.replace(path)
+
+
+def digest(value):
+    return hashlib.sha256(json.dumps(value, sort_keys=True, separators=(",", ":"),
+                                     allow_nan=False).encode()).hexdigest()
+
+
+def positions(candidate):
+    return {int(n["id"]): (int(n["x"]), int(n["y"])) for n in candidate["nodes"]}
+
+
+def bounds(points):
+    points = list(points)
+    return (min(p[0] for p in points), min(p[1] for p in points),
+            max(p[0] for p in points), max(p[1] for p in points))
+
+
+def area(points):
+    x0, y0, x1, y1 = bounds(points)
+    return (x1 - x0 + 1) * (y1 - y0 + 1)
+
+
+def edits_between(before, after):
+    return [{"op": "move", "node": node, "x": after[node][0], "y": after[node][1]}
+            for node in sorted(before) if before[node] != after[node]]
+
+
+def apply_edits(candidate, operations, *, allow_port_moves):
+    result = positions(candidate)
+    locked = {n["id"] for n in candidate["nodes"] if n.get("is_input") or n.get("is_output")}
+    seen = set()
+    for edit in operations:
+        node = edit["node"]
+        if (edit.get("op") != "move" or type(node) is not int or node not in result
+                or node in seen or (node in locked and not allow_port_moves)):
+            raise ValueError("Invalid, duplicate, or locked placement edit")
+        if any(type(edit[k]) is not int or not 0 <= edit[k] <= 4095 for k in ("x", "y")):
+            raise ValueError("Placement coordinates outside native bounds")
+        result[node] = (edit["x"], edit["y"])
+        seen.add(node)
+    if len(set(result.values())) != len(result):
+        raise ValueError("Joint edits collide")
+    return result
+
+
+def metrics(candidate):
+    points = list(positions(candidate).values())
+    points += [tuple(p) for route in candidate.get("routes", []) for p in route["path"]]
+    m = candidate.get("metrics", {})
+    return {"area_tiles": area(points), "physical_cells": int(m.get("physical_cells", 0)),
+            "route_length": sum(max(0, len(r["path"]) - 1) for r in candidate.get("routes", []))}
+
+
+def score(value):
+    return tuple(value[k] for k in ("area_tiles", "physical_cells", "route_length"))
+
+
+def output_epochs(candidate, validation):
+    epochs = validation["clock_timing"]["node_epochs"]
+    return {str(n["id"]): epochs.get(n["id"], epochs.get(str(n["id"])))
+            for n in candidate["nodes"] if n.get("is_output")}
+
+
+def checked(candidate, caps=None):
+    if not candidate.get("routed") or not candidate.get("native_mapping_valid"):
+        return False, {}, {"passed": False, "errors": ["Native evaluator rejected candidate"]}
+    validation = validate_candidate(candidate, source_crossings=False)
+    if not validation["passed"]:
+        return False, {}, validation
+    phases = {(c["x"], c["y"]): c["phase"] for c in candidate["cells"]}
+    if any(phases[(n["x"], n["y"])] != 1 for n in candidate["nodes"] if n.get("is_input")):
+        return False, {}, {"passed": False, "errors": ["Native PI launch phase must be one"]}
+    epochs = output_epochs(candidate, validation)
+    if caps is not None and (set(epochs) != set(caps) or
+                            any(epochs[k] is None or epochs[k] > caps[k] for k in caps)):
+        return False, epochs, {"passed": False, "errors": ["Output absolute epoch cap exceeded"]}
+    return True, epochs, validation
+
+
+def anchors(candidate, allow_port_moves):
+    """Shared finite action generator: single row/column contractions + moves.
+
+    A contraction moves nodes atomically and leaves rerouting to the exact
+    executor. It is only a search proposal, not a routability guarantee.
+    """
+    before = positions(candidate)
+    locked = {n["id"] for n in candidate["nodes"] if n.get("is_input") or n.get("is_output")}
+    result, seen = [], set()
+    def add(after, label):
+        if len(set(after.values())) != len(after):
+            return
+        operations = edits_between(before, after)
+        if not operations or (not allow_port_moves and any(e["node"] in locked for e in operations)):
+            return
+        key = digest(operations)
+        if key in seen:
+            return
+        seen.add(key)
+        result.append({"option_id": label, "operations": operations,
+                       "estimated_node_area": area(after.values())})
+    for axis in (0, 1):
+        values = sorted(set(p[axis] for p in before.values()))
+        for cut in range(values[0] + 1, values[-1] + 1):
+            after = {n: tuple(p[k] - (k == axis and p[k] >= cut) for k in (0, 1))
+                     for n, p in before.items()}
+            add(after, f"contract_{axis}_{cut}")
+    # Fixed ports may already determine the area; internal moves still target
+    # routes/cells and can recover a failed compression without moving ports.
+    for node, p in sorted(before.items()):
+        if node in locked and not allow_port_moves:
+            continue
+        neighbors = [before[b if a == node else a] for a, b in candidate["edges"] if node in (a, b)]
+        if not neighbors:
+            continue
+        center = tuple(sum(p[k] for p in neighbors) / len(neighbors) for k in (0, 1))
+        for axis in (0, 1):
+            delta = 1 if center[axis] > p[axis] else -1
+            target = tuple(p[k] + (delta if k == axis else 0) for k in (0, 1))
+            if min(target) < 0:
+                continue
+            after = dict(before)
+            after[node] = target
+            add(after, f"move_{node}_{axis}_{delta}")
+    result.sort(key=lambda x: (x["estimated_node_area"], len(x["operations"]), x["option_id"]))
+    return result
+
+
+def clock_options(base, feedback, use_witness=True):
+    """Choose structural repair targets, never invent epoch assignments."""
+    counts = {}
+    clock = (feedback or {}).get("clock_feedback", {}) if use_witness else {}
+    edges = clock.get("route_edges", [])
+    witness = clock.get("conflict_witness", []) if clock.get("status") == "infeasible_fixed_geometry" else []
+    for bound in witness:
+        index = bound.get("route_index", bound.get("routeIndex"))
+        if type(index) is int and 0 <= index < len(edges):
+            raw = edges[index]
+            edge = tuple(raw) if isinstance(raw, list) else (raw["source"], raw["target"])
+            if list(edge) in base["edges"]:
+                counts[edge] = counts.get(edge, 0) + 1
+    has_clock_sources = bool(counts)
+    if not counts:
+        # Unrouted nets are observed missing, not proved clock conflicts.
+        routed = {(r["source"], r["target"]) for r in (feedback or {}).get("routes", [])}
+        for e in base["edges"]:
+            if tuple(e) not in routed:
+                counts[tuple(e)] = 1
+    if not counts:
+        counts = {tuple(e): 1 for e in base["edges"]}
+    pos = positions(feedback) if feedback and feedback.get("nodes") else positions(base)
+    ranked = sorted(counts, key=lambda e: (-counts[e],
+                    -(abs(pos[e[0]][0] - pos[e[1]][0]) + abs(pos[e[0]][1] - pos[e[1]][1])), e))
+    return [{"option_id": f"net_{e[0]}_{e[1]}", "focus_edge": list(e),
+             "witness_occurrences": counts[e] if has_clock_sources else 0,
+             "evidence_kind": "negative_cycle_source" if has_clock_sources else "routing_or_length_heuristic",
+             "requires_geometry_change": has_clock_sources} for e in ranked[:4]]
+
+
+def corridor(a, b, horizontal_first):
+    bend = (b[0], a[1]) if horizontal_first else (a[0], b[1])
+    points = []
+    for p, q in ((a, bend), (bend, b)):
+        axis = 0 if p[0] != q[0] else 1
+        delta = 1 if q[axis] >= p[axis] else -1
+        for v in range(p[axis], q[axis] + delta, delta):
+            point = (v, p[1]) if axis == 0 else (p[0], v)
+            if not points or point != points[-1]:
+                points.append(point)
+    return points[1:-1]
+
+
+def routing_options(base, proposed_positions, focus_options):
+    edges = [tuple(e) for e in base["edges"]]
+    result, seen = [], set()
+    for focus in focus_options:
+        e = tuple(focus["focus_edge"])
+        for first in (True, False):
+            # Priority changes are concrete full route permutations. A node-
+            # free L corridor is a heuristic request, not an enforced path.
+            path = corridor(proposed_positions[e[0]], proposed_positions[e[1]], first)
+            occupied = [list(p) for p in path if p in proposed_positions.values()]
+            order = [e] + sorted((x for x in edges if x != e),
+                                 key=lambda x: (x[0] != e[0], x[1] != e[1], x))
+            key = digest([order, occupied, path])
+            if key not in seen:
+                seen.add(key)
+                result.append({"option_id": f"route_{e[0]}_{e[1]}_{int(first)}", "focus_edge": list(e),
+                               "routing_order": [list(x) for x in order], "node_free_cells": occupied,
+                               "corridor": [list(p) for p in path],
+                               "guarantee": "node_vacancy_only; native A* chooses actual path"})
+    return result
+
+
+def placement_options(base, anchor, request, allow_port_moves):
+    before = positions(base)
+    proposed = apply_edits(base, anchor["operations"], allow_port_moves=allow_port_moves)
+    blocked = {tuple(p) for p in request.get("node_free_cells", [])}
+    moving = [n for n, p in proposed.items() if p in blocked]
+    locked = {n["id"] for n in base["nodes"] if n.get("is_input") or n.get("is_output")}
+    if len(moving) > 3 or (not allow_port_moves and set(moving) & locked):
+        return []
+    x0, y0, x1, y1 = bounds(proposed.values())
+    alternatives = []
+    for node in moving:
+        p = proposed[node]
+        free = []
+        for dx, dy in ((0, 1), (0, -1), (1, 0), (-1, 0), (0, 2), (0, -2), (2, 0), (-2, 0)):
+            q = (p[0] + dx, p[1] + dy)
+            if x0 <= q[0] <= x1 and y0 <= q[1] <= y1 and q not in proposed.values() and q not in blocked:
+                free.append(q)
+        if not free:
+            return []
+        alternatives.append(free[:4])
+    result = []
+    for targets in itertools.islice(itertools.product(*alternatives), 24):
+        after = dict(proposed)
+        after.update(zip(moving, targets))
+        if len(set(after.values())) != len(after):
+            continue
+        operations = edits_between(before, after)
+        result.append({"option_id": "place_" + digest(operations)[:12], "operations": operations,
+                       "released_cells": [list(proposed[n]) for n in moving],
+                       "estimated_node_area": area(after.values()), "responds_to": request["option_id"]})
+    result.sort(key=lambda x: (x["estimated_node_area"], len(x["operations"]), x["option_id"]))
+    return result[:4]
+
+
+def compatible(base, placement, routing, allow_port_moves):
+    proposed = apply_edits(base, placement["operations"], allow_port_moves=allow_port_moves)
+    return not ({tuple(p) for p in routing.get("node_free_cells", [])} & set(proposed.values()))
+
+
+def spatial_quotes(base, anchor, focus, bundles, allow_port_moves):
+    """Quote realizable joint edits before committing clock-repair ownership.
+
+    All fields of a quote describe ONE concrete bundle, not independently
+    minimized metrics from incompatible edits. No native evaluation is used.
+    """
+    proposed = apply_edits(base, anchor["operations"], allow_port_moves=allow_port_moves)
+    result = []
+    for option in focus:
+        alternatives = []
+        for bundle in bundles:
+            if bundle["routing"]["focus_edge"] != option["focus_edge"]:
+                continue
+            place = bundle["placement"]
+            after = apply_edits(base, place["operations"], allow_port_moves=allow_port_moves)
+            extra = [n for n in after if after[n] != proposed[n]]
+            cost = (area(after.values()), len(extra),
+                    sum(abs(after[n][k] - proposed[n][k]) for n in extra for k in (0, 1)),
+                    bundle["option_id"])
+            alternatives.append((cost, bundle))
+        if alternatives:
+            cost, representative = min(alternatives, key=lambda pair: pair[0])
+            result.append({**option, "spatial_quote": {
+                "bundle_id": representative["option_id"], "compatible_bundle_count": len(alternatives),
+                "estimated_node_area": cost[0], "extra_moved_nodes": cost[1], "extra_displacement": cost[2],
+                "released_cells": representative["placement"]["released_cells"],
+                "guarantee": "minimum geometric edit cost among these generated bundles only; "
+                             "not a bound on routed area or timing and not a binding downstream offer"}})
+    return result
+
+
+def witness_change(previous, current):
+    """Audit exact physical-coordinate inequalities, not route-name changes."""
+    old = (previous or {}).get("clock_feedback", {})
+    new = current.get("clock_feedback", {})
+    witness = old.get("conflict_witness", [])
+    if (old.get("status") != "infeasible_fixed_geometry" or not witness or
+            new.get("status") not in ("feasible", "infeasible_fixed_geometry")):
+        return {"old_witness_preserved": None, "old_witness_changed_bounds": None}
+    def key(bound):
+        return (tuple(bound["from_position"]) if bound.get("from_position") is not None else None,
+                tuple(bound["to_position"]) if bound.get("to_position") is not None else None,
+                bound["upper"])
+    present = {key(b) for b in new.get("constraints", [])}
+    changed = sum(key(b) not in present for b in witness)
+    return {"old_witness_preserved": changed == 0, "old_witness_changed_bounds": changed}
+
+
+def model_choice(config, role, snapshot_id, options, context, messages, timeout):
+    request = {"schema": "ifcn.cooperation_model_request.v1", "snapshot_id": snapshot_id,
+               "role": role, "context": {**context, "options": options},
+               "prior_messages": messages[-12:], "fcnpilot_root": str(config["fcnpilot_root"]),
+               "max_tokens": config.get("max_tokens", 512),
+               "timeout_ms": max(1, int(timeout * 1000 - 100))}
+    if config.get("model"):
+        provider, model_id = config["model"].split("/", 1)
+        request["model"] = {"provider": provider, "modelId": model_id}
+    started = time.monotonic()
+    process = None
+    result = {"status": "error", "error": {"code": "adapter_failed"}, "model_call_started": False}
+    try:
+        process = subprocess.Popen([config.get("node", "node"),
+                                    str(config.get("adapter", ROOT / "scripts/ifcn_multi_agent_model.mjs"))],
+                                   stdin=subprocess.PIPE, stdout=subprocess.PIPE,
+                                   stderr=subprocess.DEVNULL, start_new_session=True)
+        raw, _ = process.communicate(json.dumps(request, allow_nan=False).encode(), timeout=timeout)
+        if len(raw) > 65536:
+            raise ValueError("Oversized model result")
+        answer = parse_json(raw)
+        # Only the adapter's sanitized fields are persisted; never provider
+        # bodies, authentication configuration, raw stderr or SDK exceptions.
+        for key in ("schema", "status", "role", "provider", "model", "decision", "usage", "latency_ms",
+                    "model_call_started", "response_sha256", "error", "parameters", "tools_enabled"):
+            if key in answer:
+                result[key] = answer[key]
+        decision = result.get("decision")
+        if (result.get("schema") != "ifcn.cooperation_model_result.v1" or
+                result.get("status") != "ok" or process.returncode != 0 or
+                result.get("tools_enabled") != [] or not result.get("model_call_started") or
+                not isinstance(decision, dict) or
+                decision.get("schema") != "ifcn.cooperation_decision.v1" or
+                set(decision) != {"schema", "snapshot_id", "role", "option_id", "rationale"} or
+                not isinstance(decision.get("rationale"), str) or not 0 < len(decision["rationale"]) <= 500 or
+                decision.get("snapshot_id") != snapshot_id or decision.get("role") != role or
+                decision.get("option_id") not in {o["option_id"] for o in options}):
+            result["status"] = "error"
+            result["decision"] = None
+    except subprocess.TimeoutExpired:
+        result.update(status="error", error={"code": "adapter_timeout"})
+    except (OSError, ValueError, TypeError, UnicodeError):
+        result.update(status="error", error={"code": "adapter_failed"})
+    finally:
+        if process is not None:
+            stop_process(process)
+            for stream in (process.stdin, process.stdout):
+                if stream:
+                    stream.close()
+    result.update(role=role, snapshot_id=snapshot_id, elapsed_seconds=time.monotonic() - started,
+                  options_sha256=digest(options))
+    return result
+
+
+def run_cooperation(binary, source, baseline, output, *, condition="negotiated", max_evaluations=12,
+                    evaluation_seconds=2.0, allow_port_moves=False, model_config=None, wall_seconds=120.0):
+    if condition not in CONDITIONS or not 1 <= max_evaluations <= 1000:
+        raise ValueError("Invalid cooperation condition or evaluation budget")
+    if any(not math.isfinite(v) or v <= 0 for v in (evaluation_seconds, wall_seconds)):
+        raise ValueError("Budgets must be positive and finite")
+    if condition.startswith("llm_") and model_config is None:
+        raise ValueError("Model condition requires explicit configured runtime")
+    output = Path(output).resolve()
+    output.mkdir(parents=True, exist_ok=True)
+    if any(output.iterdir()):
+        raise ValueError("Cooperation output must be empty; refusing to overwrite")
+    source, baseline, binary = (Path(p).resolve() for p in (source, baseline, binary))
+    initial = parse_json(baseline.read_bytes())
+    if not 1 <= len(initial["nodes"]) <= 149:
+        raise ValueError("Cooperation requires 1..149 actual nodes")
+    valid, caps, initial_validation = checked(initial)
+    if not valid:
+        raise ValueError("Optimization requires a validated initial snapshot")
+    (output / "baseline.json").write_bytes(baseline.read_bytes())
+    best, best_path = initial, output / "baseline.json"
+    initial_metrics, best_metrics = metrics(initial), metrics(initial)
+    events, model_calls, evaluated = [], [], set()
+    started = time.monotonic()
+    deadline = started + wall_seconds
+    native_seconds, calls, updates, cycle = 0.0, 0, 0, 0
+    max_model_calls = (model_config or {}).get("max_calls", max_evaluations * 3)
+
+    def choose(role, options, snapshot_id, context, messages, offset=0, preferred_index=None):
+        default = options[(offset if preferred_index is None else preferred_index) % len(options)]
+        call = None
+        if condition.startswith("llm_") and len(model_calls) < max_model_calls:
+            remaining = deadline - time.monotonic()
+            timeout = min((model_config or {}).get("timeout_seconds", 15.0), remaining - 0.2)
+            if timeout > 0.5:
+                call = model_choice(model_config, role, snapshot_id, options, context, messages, timeout)
+                model_calls.append(call)
+                if call.get("status") == "ok":
+                    default = next(o for o in options if o["option_id"] == call["decision"]["option_id"])
+        return default, {"snapshot_id": snapshot_id, "role": role,
+                         "option_id": default["option_id"], "partial": default,
+                         "selection": "model" if call and call.get("status") == "ok" else "deterministic"}
+
+    while calls < max_evaluations and cycle < max_evaluations * 4 and time.monotonic() < deadline:
+        base, base_path = best, best_path
+        sid = hashlib.sha256(base_path.read_bytes()).hexdigest()
+        options = anchors(base, allow_port_moves)
+        if not options:
+            break
+        anchor = options[cycle % len(options)]
+        cycle += 1
+        feedback = None
+        messages = []
+        # Every condition begins with the same exact contraction proposal.
+        # Up to two revisions then use the same immutable parent snapshot.
+        for round_index in range(3):
+            if calls >= max_evaluations or time.monotonic() >= deadline:
+                break
+            context = {"round": round_index, "parent_metrics": metrics(base),
+                       "output_epoch_caps": caps, "allow_port_moves": allow_port_moves,
+                       "anchor": anchor, "evidence_snapshot_id": digest(feedback) if feedback else None,
+                       "failure_status": (feedback or {}).get("evaluation", {}).get("status"),
+                       "clock_evidence": {k: v for k, v in (feedback or {}).get("clock_feedback", {}).items()
+                                          if k in ("status", "conflict_witness", "witness_upper_sum", "node_epochs")}
+                                         if condition != "no_witness" else {},
+                       "nodes": base["nodes"]}
+            current_messages = []
+            if round_index == 0:
+                proposal = {"schema": "ifcn.cooperation_proposal.v1", "snapshot_id": sid,
+                            "operations": anchor["operations"],
+                            "routing_order": sorted(base["edges"]), "rationale": "shared initial contraction"}
+                released = []
+            else:
+                focus = clock_options(base, feedback, condition != "no_witness")
+                is_independent = condition in ("independent", "llm_independent")
+                quote_mode = condition in ("negotiated_quotes", "quotes_hidden",
+                                           "llm_negotiated_quotes", "llm_quotes_hidden")
+                if condition in ("greedy", "llm_single") or quote_mode:
+                    clock = focus[(round_index - 1) % len(focus)]
+                else:
+                    clock, message = choose("clock", focus, sid, context,
+                                            [] if is_independent else messages, round_index - 1)
+                    current_messages.append(message)
+                proposed = apply_edits(base, anchor["operations"], allow_port_moves=allow_port_moves)
+                routes = routing_options(base, proposed,
+                                         focus if is_independent or condition in ("greedy", "llm_single") or quote_mode else [clock])
+                bundles = []
+                for route in routes:
+                    for place in placement_options(base, anchor, route, allow_port_moves):
+                        bundles.append({"option_id": "joint_" + digest([route, place])[:12],
+                                        "routing": route, "placement": place})
+                if not bundles:
+                    events.append({"cycle": cycle, "round": round_index, "snapshot_id": sid,
+                                   "status": "no_compatible_partials", "messages": current_messages})
+                    break
+                if quote_mode:
+                    quoted = spatial_quotes(base, anchor, focus, bundles, allow_port_moves)
+                    # Hidden-quote control has exactly the same nonempty
+                    # responsibility options and joint action pool. Only the
+                    # spatial prices seen by Clock and its ranking differ.
+                    hidden = condition in ("quotes_hidden", "llm_quotes_hidden")
+                    if hidden:
+                        priced = [{k: v for k, v in o.items() if k != "spatial_quote"} for o in quoted]
+                        preferred_index = (round_index - 1) % len(quoted)
+                    else:
+                        # Model option order is identical in both arms. Cost
+                        # affects only the deterministic fallback preference;
+                        # equal prices preserve the original witness order.
+                        priced = quoted
+                        ranked_indices = sorted(range(len(quoted)), key=lambda i: (
+                            quoted[i]["spatial_quote"]["estimated_node_area"],
+                            quoted[i]["spatial_quote"]["extra_moved_nodes"],
+                            quoted[i]["spatial_quote"]["extra_displacement"], i))
