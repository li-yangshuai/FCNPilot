+namespace json = boost::json;
+
+int exactInteger(const json::value& value, int lower, int upper) {
+    if (!value.is_int64() || value.as_int64() < lower || value.as_int64() > upper)
+        throw std::invalid_argument("integer outside the exact-evaluation range");
+    return static_cast<int>(value.as_int64());
+}
+
+std::string exactString(const json::value& value) {
+    if (!value.is_string()) throw std::invalid_argument("expected a JSON string");
+    return std::string(value.as_string());
+}
+
+json::object readExactObject(const std::filesystem::path& path) {
+    if (std::filesystem::file_size(path) > 16 * 1024 * 1024)
+        throw std::invalid_argument("candidate/proposal exceeds 16 MiB");
+    std::ifstream input(path);
+    if (!input) throw std::runtime_error("cannot read evaluation input");
+    std::ostringstream buffer;
+    buffer << input.rdbuf();
+    return json::parse(buffer.str()).as_object();
+}
+
+void exactKeys(const json::object& value, const std::set<std::string>& allowed) {
+    for (const auto& item : value)
+        if (!allowed.count(std::string(item.key())))
+            throw std::invalid_argument("unsupported exact proposal field: " + std::string(item.key()));
+}
+
+json::array pointJson(position point) { return {point.first, point.second}; }
+
+json::object clockFeedbackJson(const CircuitGraph& graph) {
+    if (!graph.hasClockFeedback()) return {{"status", "not_run"}, {"message", "clock solving not reached"},
+        {"fixed_phase_validation", false}, {"constraints_complete", false}, {"tile_count", 0}, {"zero_variable", nullptr},
+        {"witness_upper_sum", 0}, {"node_epochs", json::object{}}, {"constraints", json::array{}},
+        {"conflict_witness", json::array{}}, {"positions", json::array{}},
+        {"route_edges", json::array{}}, {"absolute_epochs", json::array{}}};
+    const auto& feedback = graph.getClockFeedback();
+    const auto& positions = graph.getClockPositions();
+    const auto& edges = graph.getClockRouteEdges();
+    const auto boundJson = [&](const CombinationalClockBound& bound) {
+        json::object result{{"bound_id", bound.boundId}, {"from", bound.from}, {"to", bound.to},
+            {"upper", bound.upper}, {"kind", combinationalClockConstraintKindName(bound.kind)},
+            {"route_index", nullptr}, {"route", nullptr}, {"segment_begin", nullptr},
+            {"segment_end", nullptr}, {"from_position", nullptr}, {"to_position", nullptr}};
+        if (bound.from < positions.size()) result["from_position"] = pointJson(positions[bound.from]);
+        if (bound.to < positions.size()) result["to_position"] = pointJson(positions[bound.to]);
+        if (bound.routeIndex != CombinationalClockBound::noIndex) {
+            result["route_index"] = bound.routeIndex;
+            if (bound.routeIndex < edges.size())
+                result["route"] = json::array{edges[bound.routeIndex].first, edges[bound.routeIndex].second};
+        }
+        if (bound.segmentBegin != CombinationalClockBound::noIndex) result["segment_begin"] = bound.segmentBegin;
+        if (bound.segmentEnd != CombinationalClockBound::noIndex) result["segment_end"] = bound.segmentEnd;
+        return result;
+    };
+    json::array points, routeEdges, bounds, witness, epochs;
+    for (auto point : positions) points.push_back(pointJson(point));
+    for (auto edge : edges) routeEdges.push_back(json::array{edge.first, edge.second});
+    for (const auto& bound : feedback.constraints) bounds.push_back(boundJson(bound));
+    for (const auto& bound : feedback.conflictWitness) witness.push_back(boundJson(bound));
+    for (auto epoch : feedback.absoluteEpochs) epochs.push_back(epoch);
+    json::object nodeEpochs;
+    if (feedback.absoluteEpochs.size() == positions.size()) {
+        std::map<position, std::int64_t> byPosition;
+        for (std::size_t i = 0; i < positions.size(); ++i) byPosition[positions[i]] = feedback.absoluteEpochs[i];
+        for (const auto& node : graph.nodeIndex_pos)
+            nodeEpochs[std::to_string(node.first)] = byPosition.at(node.second);
+    }
+    return {{"status", combinationalClockStatusName(feedback.status)}, {"message", feedback.message},
+        {"fixed_phase_validation", feedback.fixedPhaseValidation}, {"constraints_complete", feedback.constraintsComplete},
+        {"tile_count", feedback.tileCount},
+        {"zero_variable", feedback.tileCount}, {"constraints", bounds}, {"conflict_witness", witness},
+        {"witness_upper_sum", feedback.witnessUpperSum}, {"positions", points},
+        {"route_edges", routeEdges}, {"absolute_epochs", epochs}, {"node_epochs", nodeEpochs},
+        {"scope", "Exact constraints of this geometry; a negative cycle is not a minimum conflict core."}};
+}
+
+// Bounded transactional tools for research controllers. Source identities are
+// checked before exact-order rerouting, explicit path replacement or conditional
+// clock contracts; failed evaluations remain inspectable immutable artifacts.
+int evaluateExactCandidate(int argc, char** argv) {
+    const bool contractMode = std::string(argv[1]) == "clock-contract";
+    if (argc < 6)
+        throw std::invalid_argument("evaluate requires source, baseline, proposal and output paths");
+    double budget = 3.0;
+    bool allowPortMoves = false;
+    for (int index = 6; index < argc; ++index) {
+        const std::string flag = argv[index];
+        if (flag == "--allow-port-moves" && !contractMode) { allowPortMoves = true; continue; }
+        if (flag != "--budget" || ++index >= argc) throw std::invalid_argument("unknown evaluation option");
+        std::size_t parsed = 0;
+        const std::string value = argv[index];
+        budget = std::stod(value, &parsed);
+        if (parsed != value.size() || !std::isfinite(budget) || budget <= 0.0 || budget > 300.0)
+            throw std::invalid_argument("evaluation budget must be in (0, 300] seconds");
+    }
+    const std::filesystem::path output(argv[5]);
+    if (std::filesystem::exists(output)) throw std::invalid_argument("evaluation output already exists");
+    const auto baseline = readExactObject(argv[3]);
+    const auto proposal = readExactObject(argv[4]);
+    if (exactString(baseline.at("schema")) != "ifcn.native_candidate.v1" ||
+        exactString(proposal.at("schema")) != (contractMode ? "ifcn.clock_contract_request.v1" : "ifcn.cooperation_proposal.v1"))
+        throw std::invalid_argument("unknown exact-evaluation schema");
+    if (contractMode) exactKeys(proposal, {"schema", "snapshot_id", "release_edges"});
+    else exactKeys(proposal, {"schema", "snapshot_id", "operations", "routing_order", "rationale", "route_replacements"});
+    const bool replacementMode = !contractMode && proposal.if_contains("route_replacements");
+    const auto snapshotId = exactString(proposal.at("snapshot_id"));
+    if (snapshotId.empty() || snapshotId.size() > 256) throw std::invalid_argument("invalid snapshot identity");
+    if (proposal.if_contains("rationale")) static_cast<void>(exactString(proposal.at("rationale")));
+    const auto& baselineNodes = baseline.at("nodes").as_array();
+    if (baselineNodes.empty() || baselineNodes.size() > 149)
+        throw std::invalid_argument("exact evaluation supports 1..149 effective nodes");
+    std::map<int, position> before;
+    std::set<position> baselinePositions;
+    for (const auto& value : baselineNodes) {
+        const auto& node = value.as_object();
+        const int id = exactInteger(node.at("id"), 0, 1000000);
+        const position pos{exactInteger(node.at("x"), 0, 4095), exactInteger(node.at("y"), 0, 4095)};
+        if (!before.emplace(id, pos).second || !baselinePositions.insert(pos).second)
+            throw std::invalid_argument("duplicate baseline node or position");
+    }
+    using Edge = std::pair<int, int>;
+    std::set<Edge> declaredEdges;
+    for (const auto& value : baseline.at("edges").as_array()) {
+        const auto& edge = value.as_array();
+        if (edge.size() != 2 || !declaredEdges.emplace(exactInteger(edge[0], 0, 1000000),
+                                                     exactInteger(edge[1], 0, 1000000)).second)
+            throw std::invalid_argument("duplicate or malformed baseline edge");
+    }
+    std::vector<std::set<int>> declaredLayers;
+    for (const auto& value : baseline.at("layers").as_array()) {
+        std::set<int> layer;
+        for (const auto& member : value.as_array())
+            if (!layer.insert(exactInteger(member, 0, 1000000)).second)
+                throw std::invalid_argument("duplicate node in baseline layer");
+        declaredLayers.push_back(std::move(layer));
+    }
+    std::unique_ptr<Parse> parser;
+    std::string topology;
+    for (bool buffered : {false, true}) {
+        auto trial = std::make_unique<Parse>();
+        trial->parseVerilog(argv[2]);
+        if (!trial->get_input_num() || !trial->get_output_num())
+            throw std::invalid_argument("source requires primary inputs and outputs");
+        trial->optimizeAIOG_DRC(2, 2, 2, 2, 2, 2);
+        if (buffered) trial->addLayerRedundancyNode(); else trial->optimizeBufferNode();
+        trial->caculateSameLayerNodeRoutePair();
+        const auto effectiveEdges = trial->getEffectiveEdges();
+        if (std::set<Edge>(effectiveEdges.begin(), effectiveEdges.end()) != declaredEdges ||
+            trial->getlayerNodeDivVec() != declaredLayers) continue;
+        std::set<int> expected;
+        for (const auto& layer : trial->getlayerNodeDivVec()) expected.insert(layer.begin(), layer.end());
+        bool matches = expected.size() == before.size();
+        for (const auto& value : baselineNodes) {
+            const auto& node = value.as_object();
+            const int id = exactInteger(node.at("id"), 0, 1000000);
+            matches = matches && expected.count(id) &&
+                exactString(node.at("name")) == trial->getNodeName(id) &&
+                exactString(node.at("type")) == trial->getNodeType(id) &&
+                node.at("is_input").as_bool() == (trial->getNodeType(id) == "input") &&
+                node.at("is_output").as_bool() == (trial->getOutputNodesIndex().count(id) != 0);
+        }
