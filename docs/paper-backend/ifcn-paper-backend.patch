+            return fail("conditional clock input negative-cycle sum is invalid");
+    }
+    std::vector<bool> released(feedback.sourceProblem.routes.size(), false);
+    for (const auto route : releasedRoutes) {
+        if (route >= released.size() || released[route])
+            return fail("conditional clock release contains an unknown or duplicate route");
+        released[route] = true;
+    }
+    for (const auto &query : queries)
+        if (query.source > zero || query.sink > zero)
+            return fail("conditional clock query refers to an unknown tile");
+    for (const auto &bound : feedback.constraints)
+        if (bound.routeIndex == noIndex || !released[bound.routeIndex])
+            result.retainedConstraints.push_back(bound);
+
+    // Bellman-Ford from an implicit super-source establishes feasibility and
+    // supplies Johnson potentials for nonnegative shortest-path searches.
+    std::vector<std::int64_t> potential(vertexCount, 0);
+    std::vector<std::size_t> predecessor(vertexCount, noIndex);
+    std::size_t lastRelaxed = noIndex;
+    bool changed = false;
+    for (std::size_t pass = 0; pass < vertexCount; ++pass) {
+        if (interrupted()) return fail("conditional clock search cancelled", Status::Cancelled);
+        changed = false;
+        for (std::size_t i = 0; i < result.retainedConstraints.size(); ++i) {
+            if (i % 256 == 0 && interrupted()) return fail("conditional clock search cancelled", Status::Cancelled);
+            const auto &bound = result.retainedConstraints[i];
+            std::int64_t candidate;
+            if (!checkedAdd(potential[bound.from], bound.upper, candidate))
+                return fail("conditional clock arithmetic overflow");
+            if (potential[bound.to] > candidate) {
+                potential[bound.to] = candidate;
+                predecessor[bound.to] = i;
+                lastRelaxed = bound.to;
+                changed = true;
+            }
+        }
+        if (!changed) break;
+    }
+    if (changed) {
+        auto vertex = lastRelaxed;
+        for (std::size_t i = 0; i < vertexCount; ++i) {
+            if (vertex >= vertexCount || predecessor[vertex] == noIndex)
+                return fail("conditional clock could not reconstruct a negative cycle");
+            vertex = result.retainedConstraints[predecessor[vertex]].from;
+        }
+        const auto first = vertex;
+        do {
+            if (interrupted()) return fail("conditional clock search cancelled", Status::Cancelled);
+            if (vertex >= vertexCount || predecessor[vertex] == noIndex ||
+                result.conflictWitness.size() >= vertexCount)
+                return fail("conditional clock could not reconstruct a negative cycle");
+            const auto &bound = result.retainedConstraints[predecessor[vertex]];
+            result.conflictWitness.push_back(bound);
+            if (!checkedAdd(result.witnessUpperSum, bound.upper, result.witnessUpperSum))
+                return fail("conditional clock witness arithmetic overflow");
+            vertex = bound.from;
+        } while (vertex != first);
+        std::reverse(result.conflictWitness.begin(), result.conflictWitness.end());
+        if (result.witnessUpperSum >= 0)
+            return fail("conditional clock witness is not a negative cycle");
+        return fail("frozen routes still contain incompatible absolute-clock constraints",
+                    Status::InfeasibleFixedGeometry);
+    }
+    if (potential[zero] == std::numeric_limits<std::int64_t>::min())
+        return fail("conditional clock epoch arithmetic overflow");
+    result.absoluteEpochs.resize(zero);
+    for (std::size_t tile = 0; tile < zero; ++tile)
+        if (!checkedAdd(potential[tile], -potential[zero], result.absoluteEpochs[tile]))
+            return fail("conditional clock epoch arithmetic overflow");
+
+    using Edge = std::pair<std::size_t, std::int64_t>;
+    std::vector<std::vector<Edge>> adjacency(vertexCount);
+    for (const auto &bound : result.retainedConstraints) {
+        std::int64_t weight;
+        if (potential[bound.to] == std::numeric_limits<std::int64_t>::min() ||
+            !checkedAdd(bound.upper, potential[bound.from], weight) ||
+            !checkedAdd(weight, -potential[bound.to], weight) || weight < 0)
+            return fail("conditional clock reduced-cost arithmetic overflow");
+        adjacency[bound.from].push_back({bound.to, weight});
+    }
+    struct Distances {
+        std::vector<std::int64_t> values;
+        std::vector<bool> reached;
+    };
+    // Cache each distinct queried endpoint, so repeated arrival queries do
+    // not run an additional graph search. Reachability has its own bit: no
+    // finite sentinel is ever exposed as an infinite clock bound.
+    std::vector<std::size_t> cacheIndex(vertexCount, noIndex);
+    std::vector<Distances> cache;
+    const auto shortestPaths = [&](std::size_t source) {
+        if (cacheIndex[source] != noIndex) return true;
+        Distances distances{std::vector<std::int64_t>(vertexCount, 0),
+                            std::vector<bool>(vertexCount, false)};
+        using Entry = std::pair<std::int64_t, std::size_t>;
+        std::priority_queue<Entry, std::vector<Entry>, std::greater<Entry>> queue;
+        distances.reached[source] = true;
+        queue.push({0, source});
+        std::size_t work = 0;
+        while (!queue.empty()) {
+            if (interrupted()) { result.status = Status::Cancelled; return false; }
+            const auto current = queue.top();
+            queue.pop();
+            if (current.first != distances.values[current.second]) continue;
+            for (const auto &edge : adjacency[current.second]) {
+                if (++work % 256 == 0 && interrupted()) { result.status = Status::Cancelled; return false; }
+                std::int64_t candidate;
+                if (!checkedAdd(current.first, edge.second, candidate)) return false;
+                if (!distances.reached[edge.first] || candidate < distances.values[edge.first]) {
+                    distances.reached[edge.first] = true;
+                    distances.values[edge.first] = candidate;
+                    queue.push({candidate, edge.first});
+                }
+            }
+        }
+        if (potential[source] == std::numeric_limits<std::int64_t>::min()) return false;
+        for (std::size_t tile = 0; tile < vertexCount; ++tile) {
+            if (tile % 256 == 0 && interrupted()) { result.status = Status::Cancelled; return false; }
+            if (distances.reached[tile] &&
+                (!checkedAdd(distances.values[tile], potential[tile], distances.values[tile]) ||
+                 !checkedAdd(distances.values[tile], -potential[source], distances.values[tile])))
+                return false;
+        }
+        cacheIndex[source] = cache.size();
+        cache.push_back(std::move(distances));
+        return true;
+    };
+    for (const auto &query : queries) {
+        if (!shortestPaths(query.source) || !shortestPaths(query.sink))
+            return fail(result.status == Status::Cancelled ? "conditional clock search cancelled" :
+                        "conditional clock shortest-path arithmetic overflow", result.status);
+        const auto &forward = cache[cacheIndex[query.source]];
+        const auto &backward = cache[cacheIndex[query.sink]];
+        CombinationalClockArrivalWindow window;
+        window.source = query.source;
+        window.sink = query.sink;
+        window.upperBounded = forward.reached[query.sink];
+        window.lowerBounded = backward.reached[query.source];
+        if (window.upperBounded) window.upper = forward.values[query.sink];
+        if (window.lowerBounded) {
+            if (backward.values[query.source] == std::numeric_limits<std::int64_t>::min())
+                return fail("conditional clock lower-bound arithmetic overflow");
+            window.lower = -backward.values[query.source];
+        }
+        result.windows.push_back(window);
+    }
+    if (interrupted()) return fail("conditional clock search cancelled", Status::Cancelled);
+    result.status = Status::Feasible;
+    return result;
+}
 } // namespace fcngraph
