+        const auto& fullBounds = fullClock.at("constraints").as_array();
+        for (const auto& bound : contract.retainedConstraints) retained.push_back(fullBounds.at(bound.boundId));
+        for (const auto& bound : contract.conflictWitness) witness.push_back(fullBounds.at(bound.boundId));
+        for (auto epoch : contract.absoluteEpochs) epochs.push_back(epoch);
