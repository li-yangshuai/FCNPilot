+@unittest.skipUnless(HAS_Z3, "Optional Z3 unavailable; set IFCN_TEST_Z3_ROOT for SAT regressions")
+class SatTests(unittest.TestCase):
+    def test_numeric_source_names_and_port_wire_redeclaration_are_audited(self):
+        source = b'module m(1,2,22); input 1,2; output 22; wire 22; assign 22=1 & 2; endmodule'
+        dag = {'schema': 'ifcn.dag.v1', 'input_count': 2, 'output_count': 1,
+               'nodes': [{'id': 0, 'name': 'ifcn_name_31', 'type': 'input', 'is_input': True, 'is_output': False},
+                         {'id': 1, 'name': 'ifcn_name_32', 'type': 'input', 'is_input': True, 'is_output': False},
+                         {'id': 2, 'name': 'ifcn_name_3232', 'type': 'and', 'is_input': False, 'is_output': True}],
+               'edges': [[0, 2], [1, 2]]}
+        result = verify_sat_bytes(source, json.dumps(dag).encode(), z3_root=Z3_ROOT)
+        self.assertEqual(result['status'], 'equivalent', result)
+        self.assertEqual(result['source_identifier_map'], {'1': 'ifcn_name_31', '2': 'ifcn_name_32', '22': 'ifcn_name_3232'})
+        dag['nodes'][-1]['type'] = 'or'
+        result = verify_sat_bytes(source, json.dumps(dag).encode(), z3_root=Z3_ROOT)
+        self.assertEqual(result['status'], 'not_equivalent', result)
+
+    def test_32_input_equivalence_without_enumeration(self):
+        source, dag = chain()
+        report = verify_sat_bytes(source, json.dumps(dag).encode(), z3_root=Z3_ROOT)
+        self.assertEqual(report["status"], "equivalent", report)
+        self.assertEqual(report["vectors_checked"], 0)
+        self.assertEqual(report["proof"], "output_difference_miter_unsat")
+        self.assertEqual(len(report["input_mapping"]), 32)
+
+    def test_wrong_gate_returns_named_counterexample(self):
+        source, dag = chain()
+        dag["nodes"][-1]["type"] = "or"
+        report = verify_sat_bytes(source, json.dumps(dag).encode(), z3_root=Z3_ROOT)
+        self.assertEqual(report["status"], "not_equivalent", report)
+        example = report["counterexamples"][0]
+        self.assertEqual(len(example["inputs"]), 32)
+        self.assertNotEqual(example["source_outputs"], example["dag_outputs"])
+
+    def test_port_mismatch_never_passes(self):
+        source, dag = chain()
+        dag["nodes"][-1]["name"] = "different_output"
+        report = verify_sat_bytes(source, json.dumps(dag).encode(), z3_root=Z3_ROOT)
+        self.assertEqual(report["status"], "unsupported")
+        self.assertIsNone(report["equivalent"])
+
+    def test_expired_budget_is_not_equivalence(self):
+        source, dag = chain()
+        report = verify_sat_bytes(source, json.dumps(dag).encode(), z3_root=Z3_ROOT, timeout_seconds=1e-12)
+        self.assertEqual(report["status"], "unknown", report)
+        self.assertIsNone(report["equivalent"])
