+    const double seconds = std::chrono::duration<double>(std::chrono::steady_clock::now() - started).count();
+    const bool valid = status == "feasible";
+    json::array nodes, edges, routes, cells, layers, changes, requestedOrder, executedOrder;
+    for (const auto& layer : parse.getlayerNodeDivVec()) {
+        json::array members; for (int id : layer) members.push_back(id); layers.push_back(members);
+    }
+    std::uint64_t minX = 4095, minY = 4095, maxX = 0, maxY = 0;
+    const auto include = [&](position point) {
+        minX = std::min(minX, static_cast<std::uint64_t>(point.first)); minY = std::min(minY, static_cast<std::uint64_t>(point.second));
+        maxX = std::max(maxX, static_cast<std::uint64_t>(point.first)); maxY = std::max(maxY, static_cast<std::uint64_t>(point.second));
+    };
+    for (const auto& node : graph.nodeIndex_pos) {
+        const auto id = node.first; const auto pos = node.second; include(pos);
+        nodes.push_back(json::object{{"id", id}, {"name", parse.getNodeName(id)}, {"type", parse.getNodeType(id)},
+            {"is_input", parse.getNodeType(id) == "input"}, {"is_output", parse.getOutputNodesIndex().count(id) != 0},
+            {"x", pos.first}, {"y", pos.second}});
+        if (pos != before.at(id)) changes.push_back(json::object{{"node", id}, {"from", pointJson(before.at(id))}, {"to", pointJson(pos)}});
+    }
+    std::size_t routeLength = 0;
+    for (auto edge : declaredEdges) edges.push_back(json::array{edge.first, edge.second});
+    for (const auto& route : graph.routes) {
+        json::array path;
+        for (auto point : route.second) { include(point); path.push_back(pointJson(point)); }
+        if (!route.second.empty()) routeLength += route.second.size() - 1;
+        routes.push_back(json::object{{"source", route.first.first}, {"target", route.first.second}, {"path", path}});
+    }
+    for (const auto& cell : board.gridMap)
+        if (cell.second.get_current_weight() != 0)
+            cells.push_back(json::object{{"x", cell.first.first}, {"y", cell.first.second}, {"phase", cell.second.getPhase()}});
+    const auto& trace = graph.getExactRoutingTrace();
+    for (auto edge : order) requestedOrder.push_back(json::array{edge.first, edge.second});
+    for (auto edge : trace.executedOrder) executedOrder.push_back(json::array{edge.first, edge.second});
