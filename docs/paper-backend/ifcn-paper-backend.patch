+                   "evaluation_budget_exhausted" if calls >= max_evaluations else
+                   "no_geometric_candidate" if not pool else "finite_pool_exhausted")
+    summary = {"schema": "ifcn.clock_repair_run.v1", "condition": condition,
+               "status": "recovered" if selected_path else "unrecovered" if applicable else "not_applicable",
+               "selected_path": str(selected_path) if selected_path else None,
+               "initial_status": initial_status, "termination_reason": termination,
+               "snapshot_sha256": sid, "pool_sha256": pool_sha,
+               "source_sha256": hashlib.sha256(source.read_bytes()).hexdigest(),
+               "binary_sha256": hashlib.sha256(binary.read_bytes()).hexdigest(),
+               "evaluations": calls, "first_success_evaluation": first_success,
+               "evaluation_budget": max_evaluations, "evaluation_seconds": evaluation_seconds,
+               "contract_calls": len(contracts), "contract_budget": max_contracts,
+               "contract_seconds": contract_seconds, "contract_native_seconds": analysis_seconds,
+               "native_seconds": native_seconds, "total_seconds": elapsed_total,
+               "wall_budget_seconds": wall_seconds, "max_paths": max_paths, "pool_count": len(pool),
+               "window_rejections": sum(o["window_rejection"] is not None for o in pool),
+               "baseline_metrics": metrics(base), "final_metrics": selected_metrics,
+               "reference_output_epochs": caps, "final_output_epochs": selected_epochs,
+               "events": events, "contracts": contracts, "model_calls": model_calls,
+               "model_call_count": len(model_calls), "model_allowance": allowance,
+               "model_stage_allowances": stage_allowances, "model_stage_used": stage_used,
+               "model_seconds": model_seconds, "generation_seconds": generation_seconds,
+               "window_seconds": window_seconds, "policy_decisions": policy_decisions,
+               "first_success_seconds": events[-1]["elapsed_seconds"] if selected_path else None,
+               "centralized_policy": "Same exact tools, witnesses, candidate generation, fanout feedback and full-window filtering as clock_window; deterministic policy alias.",
+               "scope": "Fixed nodes and unreleased paths; no area growth; conditional contact windows are necessary only; "
