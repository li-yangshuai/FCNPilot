+#!/usr/bin/env python3
+"""Exact-order evaluation, artifact provenance and clock-conflict regression."""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "src/python"))
+from ifcn.layout_validation import validate_candidate
+
+SOURCE = "module example(a,b,y); input a,b; output y; assign y=a&b; endmodule\n"
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--binary", type=Path, required=True)
+    args = parser.parse_args()
+    binary = args.binary.resolve()
+    with tempfile.TemporaryDirectory(prefix="ifcn-cooperation-evaluate-") as temporary:
+        root = Path(temporary)
+        source = root / "source.v"
+        source.write_text(SOURCE)
+        baseline = root / "baseline.json"
+        generated = subprocess.run([str(binary), "multi_agent", str(source), str(baseline),
+                                    "--budget", "2", "--attempts", "12"],
+                                   capture_output=True, text=True, timeout=15)
+        assert generated.returncode == 0, generated.stdout + generated.stderr
+        original = baseline.read_bytes()
+        candidate = json.loads(original)
+        assert validate_candidate(candidate)["passed"]
+        snapshot = hashlib.sha256(original).hexdigest()
+        order = sorted(candidate["edges"])
+        proposal = {"schema": "ifcn.cooperation_proposal.v1", "snapshot_id": snapshot,
+                    "operations": [], "routing_order": order, "rationale": "regression"}
+        counter = 0
+
+        def run(value, *extra, base=baseline, command="evaluate", source_file=source):
+            nonlocal counter
+            counter += 1
+            plan = root / f"proposal-{counter}.json"
+            output = root / f"candidate-{counter}.json"
+            plan.write_text(json.dumps(value))
+            result = subprocess.run([str(binary), command, str(source_file), str(base), str(plan),
+                                     str(output), "--budget", "2", *map(str, extra)],
+                                    capture_output=True, text=True, timeout=10)
+            return result, output, plan
+
+        result, output, plan = run(proposal)
+        assert result.returncode == 0, result.stdout + result.stderr
+        evaluated = json.loads(output.read_text())
+        assert evaluated["evaluation"]["snapshot_id"] == snapshot
+        assert evaluated["evaluation"]["route_attempts"] == 1
+        assert evaluated["evaluation"]["requested_routing_order"] == order
+        assert evaluated["evaluation"]["executed_prefix"] == order
+        assert not evaluated["evaluation"]["fallback_used"]
+        assert evaluated["evaluation"]["node_changes"] == []
+        assert validate_candidate(evaluated)["passed"]
+        clock = evaluated["clock_feedback"]
+        assert clock["status"] == "feasible"
+        assert len(clock["absolute_epochs"]) == len(clock["positions"]) == clock["tile_count"]
+        assert clock["constraints"] and not clock["conflict_witness"]
+        for node in evaluated["nodes"]:
+            if node["is_input"]:
+                assert clock["node_epochs"][str(node["id"]) ] == 0
+        for bound in clock["constraints"]:
+            epochs = clock["absolute_epochs"] + [0]
+            assert epochs[bound["to"]] - epochs[bound["from"]] <= bound["upper"]
+            if bound["route_index"] is not None:
+                assert bound["route"] == clock["route_edges"][bound["route_index"]]
+
+        # Existing snapshots/results and caller inputs are immutable.
+        preserved = output.read_bytes()
+        again = subprocess.run([str(binary), "evaluate", str(source), str(baseline), str(plan), str(output)],
+                               capture_output=True, text=True, timeout=5)
+        assert again.returncode != 0 and output.read_bytes() == preserved
+        assert baseline.read_bytes() == original
+
+        inputs = [n for n in candidate["nodes"] if n["is_input"]]
+        port = inputs[0]
+        move = {"op": "move", "node": port["id"], "x": port["x"] + 10, "y": port["y"]}
+        result, output, _ = run({**proposal, "operations": [move]})
+        assert result.returncode != 0 and not output.exists()
+        assert "locked" in result.stderr
+
+        # Atomic coordinate moves permit a swap; no intermediate collision is
+        # mistaken for a collision in the final joint placement.
+        a, b = inputs[:2]
+        swap = [{"op": "move", "node": a["id"], "x": b["x"], "y": b["y"]},
+                {"op": "move", "node": b["id"], "x": a["x"], "y": a["y"]}]
+        result, output, _ = run({**proposal, "operations": swap}, "--allow-port-moves")
+        assert output.exists(), result.stderr
+        swapped = json.loads(output.read_text())
+        positions = {n["id"]: (n["x"], n["y"]) for n in swapped["nodes"]}
+        assert positions[a["id"]] == (b["x"], b["y"])
+        assert positions[b["id"]] == (a["x"], a["y"])
+        assert swapped["evaluation"]["allow_port_moves"]
+        assert swapped["evaluation"]["route_attempts"] == 1
+
+        # A contradictory fixed geometry: both PI epochs are zero, one direct
+        # input route has one step, while the other requires many advances.
+        sink = next(n for n in candidate["nodes"] if n["is_output"])
+        assert len(candidate["nodes"]) == 3
+        moves = [{"op": "move", "node": a["id"], "x": 4, "y": 4},
+                 {"op": "move", "node": b["id"], "x": 40, "y": 4},
+                 {"op": "move", "node": sink["id"], "x": 5, "y": 4}]
+        result, output, _ = run({**proposal, "operations": moves}, "--allow-port-moves")
+        assert result.returncode == 10 and output.exists(), result.stderr
+        failed = json.loads(output.read_text())
+        assert failed["evaluation"]["status"] == "clock_infeasible", failed["evaluation"]
+        assert len(failed["routes"]) == len(candidate["edges"])
+        assert not failed["routed"] and not failed["native_mapping_valid"]
+        witness = failed["clock_feedback"]["conflict_witness"]
+        assert witness and sum(bound["upper"] for bound in witness) < 0
+        assert sum(bound["upper"] for bound in witness) == failed["clock_feedback"]["witness_upper_sum"]
+        for index, bound in enumerate(witness):
+            assert bound["to"] == witness[(index + 1) % len(witness)]["from"]
+            assert bound in failed["clock_feedback"]["constraints"]
+        assert failed["clock_feedback"]["absolute_epochs"] == []
+        failed_path = output
+
+        # Release real contradictory path bounds while freezing every other
+        # path: one released PI net has a bounded arrival window; releasing
+        # both leaves the output upper arrival unbounded.
+        short_edge = [a["id"], sink["id"]]
+        long_edge = [b["id"], sink["id"]]
+        request = {"schema": "ifcn.clock_contract_request.v1", "snapshot_id": snapshot,
+                   "release_edges": [short_edge]}
+        result, contract_path, request_path = run(request, base=failed_path, command="clock-contract")
+        assert result.returncode == 0, result.stderr
+        contract = json.loads(contract_path.read_text())
+        assert contract["status"] == "feasible" and contract["geometry_valid"]
+        assert contract["full_clock_status"] == "infeasible_fixed_geometry"
+        assert contract["route_attempts"] == 0 and contract["explicit_path_validations"] == 1
+        window = contract["windows"][0]
+        assert window["edge"] == short_edge and 1 < window["lower"] <= window["upper"]
+        assert contract["frozen_edges"] == [long_edge]
+        for bound in contract["retained_constraints"]:
+            assert bound["route"] != short_edge
+            epochs = contract["absolute_epochs"] + [0]
+            assert epochs[bound["to"]] - epochs[bound["from"]] <= bound["upper"]
+        result, two_path, _ = run({**request, "release_edges": [short_edge, long_edge]},
+                                 base=failed_path, command="clock-contract")
+        both = json.loads(two_path.read_text())
+        assert result.returncode == 0 and len(both["windows"]) == 2
+        assert all(w["lower"] == 0 and w["upper"] is None for w in both["windows"])
+        assert both["frozen_edges"] == []
+        preserved_contract = contract_path.read_bytes()
+        again = subprocess.run([str(binary), "clock-contract", str(source), str(failed_path),
+                                str(request_path), str(contract_path)], capture_output=True, text=True, timeout=5)
+        assert again.returncode != 0 and contract_path.read_bytes() == preserved_contract
+
+        # A single explicit detour repairs the actual negative cycle. The long
+        # path and all nodes are unchanged, and the native router is never run.
+        detour = [[4, y] for y in range(4, 15)] + [[5, y] for y in range(14, 3, -1)]
+        replacement = {"source": a["id"], "target": sink["id"], "path": detour}
+        replace_proposal = {**proposal, "route_replacements": [replacement]}
+        result, repaired_path, _ = run(replace_proposal, base=failed_path)
+        assert result.returncode == 0, result.stderr + repaired_path.read_text()
+        repaired = json.loads(repaired_path.read_text())
+        assert repaired["evaluation"]["mode"] == "route_replacement"
+        assert repaired["evaluation"]["route_attempts"] == 0
+        assert repaired["evaluation"]["explicit_path_validations"] == 1
+        assert repaired["evaluation"]["executed_prefix"] == []
+        assert repaired["evaluation"]["replaced_edges"] == [short_edge]
+        assert repaired["evaluation"]["changed_edges"] == [short_edge]
+        assert repaired["evaluation"]["preserved_route_edges"] == [long_edge]
+        assert repaired["nodes"] == failed["nodes"]
+        assert next(r for r in repaired["routes"] if r["source"] == b["id"]) == next(
+            r for r in failed["routes"] if r["source"] == b["id"])
+        assert validate_candidate(repaired)["passed"]
+
+        # Even an identical replacement runs fresh clock validation, rather
+        # than trusting a parent's routed flag or cached phase evidence.
+        old_short = next(r for r in failed["routes"] if r["source"] == a["id"])
+        result, unchanged_path, _ = run({**proposal, "route_replacements": [old_short]}, base=failed_path)
+        unchanged = json.loads(unchanged_path.read_text())
+        assert result.returncode == 10 and unchanged["evaluation"]["status"] == "clock_infeasible"
+        assert unchanged["evaluation"]["changed_edges"] == []
+
+        invalid_paths = [
+            ([[4, 4], [6, 4], [5, 4]], "four-connected"),
+            ([[4, 4], [4, 5], [4, 4], [5, 4]], "repeats"),
+            ([[4, 4], [4, 5]], "endpoints"),
+            # Simple and four-connected, but crosses the other input gate.
+            ([[4, 4], [4, 5]] + [[x, 5] for x in range(5, 41)] +
+             [[40, 4], [40, 3]] + [[x, 3] for x in range(39, 4, -1)] + [[5, 4]], "intermediate gate"),
+        ]
+        for path, reason in invalid_paths:
+            result, invalid_path, _ = run({**proposal, "route_replacements": [{**replacement, "path": path}]},
+                                          base=failed_path)
+            invalid = json.loads(invalid_path.read_text())
+            assert result.returncode == 10 and invalid["evaluation"]["status"] == "validation_failed"
+            assert reason in invalid["native_validation_error"], invalid["native_validation_error"]
+            assert not invalid["clock_feedback"]["conflict_witness"]
+            assert invalid["nodes"] == failed["nodes"]
+
+        for invalid_request in ({**request, "release_edges": []},
+                                {**request, "release_edges": [short_edge, short_edge]},
+                                {**request, "release_edges": [[9999, sink["id"]]]}):
+            result, invalid_path, _ = run(invalid_request, base=failed_path, command="clock-contract")
+            assert result.returncode != 0 and not invalid_path.exists()
+        for invalid_proposal in ({**replace_proposal, "operations": [move]},
+                                 {**replace_proposal, "route_replacements": [replacement, replacement]},
+                                 {**replace_proposal, "route_replacements": []},
+                                 {**replace_proposal, "route_replacements": [{**replacement, "path": [[-1, 4], [5, 4]]}]}):
+            result, invalid_path, _ = run(invalid_proposal, base=failed_path)
+            assert result.returncode != 0 and not invalid_path.exists()
+
+        result, stopped_path, _ = run(request, "--budget", "0.000000001", base=failed_path, command="clock-contract")
+        stopped_contract = json.loads(stopped_path.read_text())
+        assert result.returncode == 10 and stopped_contract["status"] == "cancelled"
+        assert not stopped_contract["windows"] and not stopped_contract["conflict_witness"]
+
+        # Geometrically invalid complete parents cannot manufacture a clock
+        # proof. A gate-traversing path has no admissible retained contract.
+        malformed_geometry = json.loads(failed_path.read_text())
+        for route in malformed_geometry["routes"]:
+            if route["source"] == a["id"]:
+                route["path"] = invalid_paths[-1][0]
+        malformed_path = root / "gate-traversal.json"
+        malformed_path.write_text(json.dumps(malformed_geometry))
+        result, invalid_contract_path, _ = run(request, base=malformed_path, command="clock-contract")
+        invalid_contract = json.loads(invalid_contract_path.read_text())
+        assert result.returncode == 10 and invalid_contract["status"] == "invalid"
+        assert not invalid_contract["geometry_valid"] and invalid_contract["full_clock_status"] == "not_run"
+        assert not invalid_contract["windows"] and not invalid_contract["conflict_witness"]
+
+        # Shared fanout trunks occupy one wire per source, and a fanout tree
+        # cannot split and then reconverge. Different trees may cross only as
+        # strict straight H/V routes, not share a segment or a crossing bend.
+        fanout_source = root / "fanout.v"
+        fanout_source.write_text("module fanout(a,b,y,z); input a,b; output y,z; "
+                                 "assign y=a&b; assign z=a|b; endmodule\n")
+        fanout_path = root / "fanout.json"
+        generated = subprocess.run([str(binary), "multi_agent", str(fanout_source), str(fanout_path),
+                                    "--budget", "2", "--attempts", "12"],
+                                   capture_output=True, text=True, timeout=15)
+        assert generated.returncode == 0, generated.stderr
+        fanout = json.loads(fanout_path.read_text())
+        fanout_ids = {n["name"]: n["id"] for n in fanout["nodes"]}
+        assert set(fanout_ids) == {"a", "b", "y", "z"}
+        fanout_positions = {"a": (4, 4), "b": (12, 4), "y": (6, 10), "z": (10, 10)}
+        for node in fanout["nodes"]:
+            node["x"], node["y"] = fanout_positions[node["name"]]
+
+        def polyline(*corners):
+            points = [list(corners[0])]
+            for x, y in corners[1:]:
+                px, py = points[-1]
+                assert px == x or py == y
+                while (px, py) != (x, y):
+                    px += (x > px) - (x < px)
+                    py += (y > py) - (y < py)
+                    points.append([px, py])
+            return points
+
+        paths = {("a", "y"): polyline((4, 4), (4, 8), (6, 8), (6, 10)),
+                 ("a", "z"): polyline((4, 4), (4, 8), (10, 8), (10, 10)),
+                 ("b", "y"): polyline((12, 4), (12, 12), (6, 12), (6, 10)),
+                 ("b", "z"): polyline((12, 4), (12, 12), (10, 12), (10, 10))}
+        fanout["routes"] = [{"source": fanout_ids[s], "target": fanout_ids[t], "path": path}
+                            for (s, t), path in paths.items()]
+        fanout_path.write_text(json.dumps(fanout))
+        fanout_proposal = {**proposal, "routing_order": sorted(fanout["edges"]),
+                           "route_replacements": [fanout["routes"][0]]}
+        result, shared_path, _ = run(fanout_proposal, base=fanout_path, source_file=fanout_source)
+        assert result.returncode == 0, result.stderr + shared_path.read_text()
+        shared = json.loads(shared_path.read_text())
+        assert validate_candidate(shared)["passed"] and shared["evaluation"]["changed_edges"] == []
+        for edge, path, reason in [
+                (("a", "z"), polyline((4, 4), (3, 4), (3, 8), (4, 8), (10, 8), (10, 10)), "reconverges"),
+                (("b", "y"), polyline((12, 4), (12, 8), (5, 8), (5, 10), (6, 10)), "straight H/V")]:
+            route = {"source": fanout_ids[edge[0]], "target": fanout_ids[edge[1]], "path": path}
+            result, overlap_path, _ = run({**fanout_proposal, "route_replacements": [route]},
+                                          base=fanout_path, source_file=fanout_source)
+            overlap = json.loads(overlap_path.read_text())
+            assert result.returncode == 10 and overlap["evaluation"]["status"] == "validation_failed"
+            assert reason in overlap["native_validation_error"], overlap["native_validation_error"]
+            assert not overlap["clock_feedback"]["conflict_witness"]
+
+        # Two distinct reconvergent outputs are contradictory independently.
+        # Releasing only one short path must retain an auditable negative
+        # cycle; releasing both yields windows but no joint repair claim.
+        independent_positions = {"a": (4, 4), "b": (40, 4), "y": (5, 4), "z": (4, 5)}
+        for node in fanout["nodes"]:
+            node["x"], node["y"] = independent_positions[node["name"]]
+        independent_paths = {
+            ("a", "y"): polyline((4, 4), (5, 4)),
+            ("a", "z"): polyline((4, 4), (4, 5)),
+            ("b", "y"): polyline((40, 4), (5, 4)),
+            ("b", "z"): polyline((40, 4), (40, 5), (4, 5)),
+        }
+        fanout["routes"] = [{"source": fanout_ids[s], "target": fanout_ids[t], "path": path}
+                            for (s, t), path in independent_paths.items()]
+        fanout_path.write_text(json.dumps(fanout))
+        released = [[fanout_ids["a"], fanout_ids["y"]], [fanout_ids["a"], fanout_ids["z"]]]
+        result, one_path, _ = run({**request, "release_edges": released[:1]}, base=fanout_path,
+                                  source_file=fanout_source, command="clock-contract")
+        one = json.loads(one_path.read_text())
+        assert result.returncode == 10 and one["status"] == "infeasible_fixed_geometry", one
+        assert one["geometry_valid"] and not one["windows"]
+        witness = one["conflict_witness"]
+        assert witness and sum(bound["upper"] for bound in witness) == one["witness_upper_sum"] < 0
+        for index, bound in enumerate(witness):
+            assert bound in one["retained_constraints"] and bound["route"] not in released[:1]
+            assert bound["to"] == witness[(index + 1) % len(witness)]["from"]
+        result, two_path, _ = run({**request, "release_edges": released}, base=fanout_path,
+                                  source_file=fanout_source, command="clock-contract")
+        two = json.loads(two_path.read_text())
+        assert result.returncode == 0 and two["status"] == "feasible" and len(two["windows"]) == 2, two
+        assert all(window["lower"] > 1 and window["upper"] is not None for window in two["windows"])
+        assert not two["conflict_witness"]
+
+        # A failed snapshot can be the same geometry parent of another exact
+        # proposal without importing stale occupancy or stale clock evidence.
+        restore = [{"op": "move", "node": n["id"], "x": n["x"], "y": n["y"]}
+                   for n in candidate["nodes"]]
+        result, output, _ = run({**proposal, "operations": restore}, "--allow-port-moves", base=failed_path)
+        assert result.returncode == 0, result.stderr
+        assert json.loads(output.read_text())["clock_feedback"]["conflict_witness"] == []
+
+        # Cancellation is a failed artifact, never an infeasibility proof.
+        result, output, _ = run(proposal, "--budget", "0.000000001")
+        assert result.returncode == 10 and output.exists(), result.stderr
+        stopped = json.loads(output.read_text())
+        assert stopped["evaluation"]["status"] == "cancelled"
+        assert stopped["evaluation"]["route_attempts"] == 0
+        assert not stopped["clock_feedback"]["conflict_witness"]
+
+        bad_order = {**proposal, "routing_order": order + order[:1]}
+        result, output, _ = run(bad_order)
+        assert result.returncode != 0 and not output.exists()
+        collision = {**proposal, "operations": [{"op": "move", "node": a["id"], "x": b["x"], "y": b["y"]}]}
+        result, output, _ = run(collision, "--allow-port-moves")
+        assert result.returncode != 0 and not output.exists()
+        modified = json.loads(original)
+        modified["nodes"][0]["name"] = "wrong_identity"
+        bad_baseline = root / "wrong.json"
+        bad_baseline.write_text(json.dumps(modified))
+        result, output, _ = run(proposal, base=bad_baseline)
+        assert result.returncode != 0 and not output.exists()
+        result, output, _ = run(request, base=bad_baseline, command="clock-contract")
+        assert result.returncode != 0 and not output.exists()
+        partial = json.loads(original)
+        partial["routes"] = partial["routes"][:-1]
+        bad_baseline.write_text(json.dumps(partial))
+        for command, value in (("clock-contract", request), ("evaluate", replace_proposal)):
+            result, output, _ = run(value, base=bad_baseline, command=command)
+            assert result.returncode != 0 and not output.exists()
+        assert baseline.read_bytes() == original
+        print("Exact evaluator: source identity, atomic edits, exact order, conditional clock contracts, "
+              "explicit path repair, frozen geometry, fanout ownership and cancellation passed")
+
+
+if __name__ == "__main__":
+    main()
