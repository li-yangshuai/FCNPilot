--- /dev/null
+++ b/tests/test_multi_agent_llm.py
@@ -0,0 +1,314 @@
+"""Offline tests: real subprocess protocol, fake model transport, real DRC/truth."""
+from contextlib import redirect_stderr, redirect_stdout
+import io
+import json
+import os
+from pathlib import Path
+import signal
+import sys
+import tempfile
+import time
+import unittest
+from unittest.mock import patch
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT / "src/python"))
+from ifcn import multi_agent
+
+
+class MultiAgentLlmTests(unittest.TestCase):
+    def setUp(self):
+        self.temporary = tempfile.TemporaryDirectory(prefix="ifcn-llm-offline-")
+        self.addCleanup(self.temporary.cleanup)
+        self.root = Path(self.temporary.name)
+        self.source = self.root / "xor.v"
+        self.source.write_text("module top(input a,input b,output y); assign y=a^b; endmodule\n")
+        self.candidate = json.loads((ROOT / "tests/fixtures/routing/xor2_fixed_clock.json").read_text())
+        for node in self.candidate["nodes"]:
+            if node["is_output"]:
+                node["name"] = "y"
+        self.candidate.update(schema="ifcn.native_candidate.v1", algorithm="multi_agent",
+                              routed=True, native_mapping_valid=True, run_time_s=0.5)
+        self.binary = self.root / "native"
+        self.adapter = self.root / "adapter.py"
+        self.output = self.root / "run"
+        self.make_native()
+        self.make_adapter()
+
+    def make_native(self, *, sleep=False, requests=6, ignore_actions=False):
+        self.binary.write_text("#!" + sys.executable + "\n"
+            "import json,pathlib,sys,time\n"
+            "assert sys.argv[1]=='multi_agent' and '--agent-control' in sys.argv\n"
+            "replies=[]; controls=[]; events=[]\n"
+            f"for attempt in range(1,{requests + 1}):\n"
+            "    context={'schema':'ifcn.agent_control.v1','attempt':attempt,'has_incumbent':attempt>1,"
+            "'available_actions':['explore','compact','reroute','repair'],'suggested_action':'explore',"
+            "'remaining_seconds':10,'last_feedback':'accepted legal candidate' if attempt>1 else '',"
+            "'best_metrics':{'area_tiles':12,'physical_cells':80,'route_length':15}}\n"
+            "    print('IFCN_AGENT_REQUEST '+json.dumps(context),flush=True)\n"
+            "    replies.append(sys.stdin.readline().strip())\n"
+            "    action=replies[-1].split()[-1]\n"
+            "    controls.append({'attempt':attempt,'action':action,'status':'selected' if action!='all' else 'default_requested'})\n"
+            "    events.append({'attempt':attempt,'actor':'placement'})\n"
+            "pathlib.Path('replies.json').write_text(json.dumps(replies))\n"
+            + ("time.sleep(10)\n" if sleep else "")
+            + "candidate=json.loads(" + repr(json.dumps(self.candidate)) + ")\n"
+            + ("for event in controls: event['status']='timeout_fallback'\n" if ignore_actions else "")
+            + "candidate['multi_agent']={'control_events':controls,'events':events}\n"
+            + "pathlib.Path(sys.argv[3]).write_text(json.dumps(candidate))\n")
+        self.binary.chmod(0o755)
+
+    def make_adapter(self, mode="ok"):
+        self.adapter.write_text("import json,sys,time\n"
+            "request=json.load(sys.stdin)\n"
+            f"mode={mode!r}\n"
+            "if mode=='timeout': time.sleep(10)\n"
+            "decision={'schema':'ifcn.agent_decision.v1','action':'compact','rationale':'Try bounded refinement.'}\n"
+            "if mode=='invalid': decision['action']='__import__(os).system(unsafe)'\n"
+            "result={'schema':'ifcn.agent_model_result.v1','status':'error' if mode=='error' else 'ok',"
+            "'role':request['role'],'provider':'offline-test','model':'fake','model_call_started':True,"
+            "'decision':decision,'usage':{'input':12,'output':4},'tools_enabled':[],"
+            "'error':{'code':'provider_error','message':'SECRET_should_not_log'}}\n"
+            "print(json.dumps(result))\n")
+
+    def make_native_exit_during_model(self, exit_code):
+        """Close native stdin after the second model call has actually begun."""
+        self.make_native(requests=2)
+        ready, closed = self.root / "model.ready", self.root / "stdin.closed"
+        self.binary.write_text(self.binary.read_text() +
+            "import os\n"
+            "context['attempt']=3\n"
+            "print('IFCN_AGENT_REQUEST '+json.dumps(context),flush=True)\n"
+            "deadline=time.monotonic()+2\n"
+            f"while not pathlib.Path({str(ready)!r}).exists():\n"
+            "    assert time.monotonic()<deadline, 'Model did not start'\n"
+            "    time.sleep(0.005)\n"
+            "os.close(0)\n"
+            f"pathlib.Path({str(closed)!r}).write_text('closed')\n"
+            f"sys.exit({exit_code})\n")
+        rendezvous = ("import pathlib\n"
+            "if request['context']['attempt']==3:\n"
+            f"    pathlib.Path({str(ready)!r}).write_text('ready')\n"
+            "    deadline=time.monotonic()+2\n"
+            f"    while not pathlib.Path({str(closed)!r}).exists():\n"
+            "        assert time.monotonic()<deadline, 'Native stdin stayed open'\n"
+            "        time.sleep(0.005)\n")
+        self.adapter.write_text(self.adapter.read_text().replace(
+            "request=json.load(sys.stdin)\n", "request=json.load(sys.stdin)\n" + rendezvous))
+
+    def execute(self, *extra):
+        args = ["--input", str(self.source), "--binary", str(self.binary), "--output-dir", str(self.output),
+                "--node", sys.executable, "--model-adapter", str(self.adapter), "--fcnpilot-root", str(self.root),
+                "--budget", "5", "--attempts", "12", "--max-model-calls", "4", "--model-timeout", "1", *extra]
+        with redirect_stdout(io.StringIO()), redirect_stderr(io.StringIO()):
+            code = multi_agent.main(args)
+        return code, json.loads((self.output / "summary.json").read_text())
+
+    def test_four_real_adapter_calls_follow_seed_and_drive_native_actions(self):
+        code, summary = self.execute()
+        self.assertEqual(code, 0, summary)
+        self.assertTrue(summary["layout_validated"])
+        self.assertEqual(summary["vectors_checked"], 4)
+        self.assertEqual(summary["completion_mode"], "model_guided")
+        calls = [entry for entry in summary["decisions"] if entry["role"]]
+        self.assertEqual([entry["role"] for entry in calls], list(multi_agent.ROLES))
+        self.assertEqual(summary["model_call_attempts"], 4)
+        self.assertEqual(summary["model_decisions_accepted"], 4)
+        self.assertEqual(summary["model_decisions_applied"], 4)
+        self.assertEqual(json.loads((self.output / "replies.json").read_text()),
+                         ["IFCN_AGENT_RESPONSE all"] + ["IFCN_AGENT_RESPONSE compact"] * 4 + ["IFCN_AGENT_RESPONSE all"])
+        self.assertEqual(summary["physical_waveform_status"], "not_run")
+        self.assertTrue((self.output / "layout.ifcn").is_file())
+
+    def test_provider_errors_fallback_and_are_never_reported_as_model_success(self):
+        self.make_adapter("error")
+        code, summary = self.execute()
+        self.assertEqual(code, 0, summary)
+        self.assertEqual(summary["model_decisions_accepted"], 0)
+        self.assertEqual(summary["model_call_attempts"], 4)
+        self.assertEqual(summary["completion_mode"], "deterministic_fallback")
+        self.assertNotIn("SECRET_should_not_log", (self.output / "summary.json").read_text())
+        self.assertTrue(all(reply == "IFCN_AGENT_RESPONSE all" for reply in json.loads((self.output / "replies.json").read_text())))
+
+    def test_model_action_outside_allowlist_is_rejected_without_execution(self):
+        self.make_adapter("invalid")
+        code, summary = self.execute()
+        self.assertEqual(code, 0)
+        self.assertEqual(summary["model_decisions_accepted"], 0)
+        calls = [entry for entry in summary["decisions"] if entry["role"]]
+        self.assertTrue(all(entry["error"] == "invalid_response" for entry in calls))
+        self.assertNotIn("__import__", (self.output / "summary.json").read_text())
+
+    def test_model_timeout_consumes_call_budget_and_falls_back(self):
+        self.make_adapter("timeout")
+        code, summary = self.execute("--model-timeout", "0.3", "--max-model-calls", "1")
+        self.assertEqual(code, 0, summary)
+        self.assertEqual(summary["model_call_attempts"], 1)
+        self.assertEqual(summary["model_decisions_accepted"], 0)
+        self.assertEqual([entry["error"] for entry in summary["decisions"] if entry["role"]], ["adapter_timeout"])
+        self.assertLess(summary["elapsed_seconds"], 2)
+
+    def test_total_timeout_rejects_incomplete_native_output(self):
+        self.make_native(sleep=True, requests=1)
+        started = time.monotonic()
+        code, summary = self.execute("--budget", "0.3", "--max-model-calls", "0")
+        self.assertEqual(code, 1)
+        self.assertEqual(summary["status"], "timeout")
+        self.assertTrue(summary["native_timed_out"])
+        self.assertFalse(summary["layout_validated"])
+        self.assertFalse((self.output / "layout.ifcn").exists())
+        self.assertLess(time.monotonic() - started, 2)
+
+    def test_zero_calls_is_offline_and_does_not_claim_llm_use(self):
+        self.make_adapter("timeout")
+        code, summary = self.execute("--max-model-calls", "0")
+        self.assertEqual(code, 0)
+        self.assertEqual(summary["model_call_attempts"], 0)
+        self.assertFalse(summary["model_used"])
+        self.assertEqual(summary["completion_mode"], "deterministic_fallback")
+
+    def test_accepted_response_without_native_execution_cannot_claim_model_use(self):
+        self.make_native(ignore_actions=True)
+        code, summary = self.execute()
+        self.assertEqual(code, 0)
+        self.assertEqual(summary["model_decisions_accepted"], 4)
+        self.assertEqual(summary["model_decisions_applied"], 0)
+        self.assertFalse(summary["model_used"])
+        self.assertEqual(summary["completion_mode"], "deterministic_fallback")
+
+    def test_native_exit_during_model_preserves_legal_incumbent(self):
+        self.make_native_exit_during_model(0)
+        code, summary = self.execute()
+        self.assertEqual(code, 0, summary)
+        self.assertTrue(summary["layout_validated"])
+        self.assertTrue((self.output / "layout.ifcn").exists())
+        self.assertEqual(summary["native_exit_code"], 0)
+        self.assertFalse(summary["native_timed_out"])
+        self.assertEqual(summary["model_call_attempts"], 2)
+        self.assertEqual(summary["model_decisions_accepted"], 2)
+        self.assertEqual(summary["model_decisions_applied"], 1)
+        self.assertFalse(summary["decisions"][-1]["native_applied"])
+        self.assertEqual(summary["candidate_audit_status"], "available")
+
+    def test_native_failure_during_model_retains_application_audit_without_approval(self):
+        self.candidate.update(routed=False, native_mapping_valid=False)
+        self.make_native_exit_during_model(10)
+        code, summary = self.execute()
+        self.assertEqual(code, 1, summary)
+        self.assertEqual(summary["status"], "native_failed")
+        self.assertEqual(summary["native_exit_code"], 10)
+        self.assertFalse(summary["layout_validated"])
+        self.assertFalse((self.output / "layout.ifcn").exists())
+        self.assertEqual(summary["model_call_attempts"], 2)
+        self.assertEqual(summary["model_decisions_applied"], 1)
+        self.assertTrue(summary["model_used"])
+        self.assertEqual(summary["candidate_audit_status"], "available")
+        self.assertEqual(summary["candidate_sha256"], multi_agent.sha256(self.output / "candidate.json"))
+        self.assertFalse(summary["decisions"][-1]["native_applied"])
+
+    def test_failed_process_cannot_be_approved_by_valid_candidate(self):
+        self.make_native(requests=2)
+        self.binary.write_text(self.binary.read_text() + "sys.exit(10)\n")
+        code, summary = self.execute()
+        self.assertEqual(code, 1, summary)
+        self.assertEqual(summary["status"], "native_failed")
+        self.assertEqual(summary["model_decisions_applied"], 1)
+        self.assertFalse(summary["layout_validated"])
+        self.assertFalse((self.output / "layout.ifcn").exists())
+
+    def test_missing_or_damaged_evidence_preserves_native_failure_and_unknown_application(self):
+        for name, damage in (
+            ("missing", "pathlib.Path(sys.argv[3]).unlink()\n"),
+            ("truncated", "pathlib.Path(sys.argv[3]).write_text('{')\n"),
+            ("wrong_schema", "candidate['schema']='other'; pathlib.Path(sys.argv[3]).write_text(json.dumps(candidate))\n"),
+            ("bad_events", "candidate['multi_agent']['events']=['bad']; pathlib.Path(sys.argv[3]).write_text(json.dumps(candidate))\n"),
+        ):
+            with self.subTest(name=name):
+                self.output = self.root / name
+                self.make_native(requests=2)
+                self.binary.write_text(self.binary.read_text() + damage + "sys.exit(10)\n")
+                code, summary = self.execute()
+                self.assertEqual(code, 1, summary)
+                self.assertEqual(summary["status"], "native_failed")
+                self.assertEqual(summary["candidate_audit_status"], "unavailable")
+                self.assertIsNone(summary["model_decisions_applied"])
+                self.assertIsNone(summary["model_used"])
+                self.assertEqual(summary["model_call_attempts"], 1)
+                self.assertIsNone(summary["decisions"][-1]["native_applied"])
+                self.assertFalse(summary["layout_validated"])
+                self.assertFalse((self.output / "layout.ifcn").exists())
+
+    def test_total_timeout_audits_existing_candidate_without_export(self):
+        self.make_native(requests=2)
+        self.binary.write_text(self.binary.read_text() + "time.sleep(10)\n")
+        code, summary = self.execute("--budget", "0.7")
+        self.assertEqual(code, 1, summary)
+        self.assertEqual(summary["status"], "timeout")
+        self.assertTrue(summary["native_timed_out"])
+        self.assertEqual(summary["candidate_audit_status"], "available")
+        self.assertEqual(summary["model_decisions_applied"], 1)
+        self.assertFalse(summary["layout_validated"])
+        self.assertFalse((self.output / "layout.ifcn").exists())
+
+    @unittest.skipUnless(Path("/proc").is_dir(), "Linux process-group cleanup check")
+    def test_finished_adapter_cannot_leave_a_transport_descendant_alive(self):
+        ready = self.root / "descendant.ready"
+        pid_file = self.root / "descendant.pid"
+        child = ("import pathlib,signal,time; signal.signal(signal.SIGTERM,signal.SIG_IGN); "
+                 f"pathlib.Path({str(ready)!r}).write_text('ready'); time.sleep(10)")
+        launch = ("import pathlib,subprocess,sys,time\n"
+                  f"child=subprocess.Popen([sys.executable,'-c',{child!r}],stdin=subprocess.DEVNULL,"
+                  "stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)\n"
+                  f"pathlib.Path({str(pid_file)!r}).write_text(str(child.pid))\n"
+                  f"while not pathlib.Path({str(ready)!r}).exists(): time.sleep(0.005)\n")
+        self.adapter.write_text(launch + self.adapter.read_text())
+        code, summary = self.execute("--max-model-calls", "1")
+        self.assertEqual(code, 0, summary)
+        pid = int(pid_file.read_text())
+        try:
+            status = Path(f"/proc/{pid}/stat")
+            for _ in range(50):
+                if not status.exists() or status.read_text().split()[2] == "Z":
+                    break
+                time.sleep(0.01)
+            self.assertTrue(not status.exists() or status.read_text().split()[2] == "Z", "Transport descendant survived cleanup")
+        finally:
+            try:
+                os.kill(pid, signal.SIGKILL)
+            except ProcessLookupError:
+                pass
+
+    def test_independent_truth_failure_prevents_ifcn_export(self):
+        self.source.write_text("module top(input a,input b,output y); assign y=~(a^b); endmodule\n")
+        code, summary = self.execute("--max-model-calls", "0")
+        self.assertEqual(code, 1)
+        self.assertEqual(summary["status"], "logic_rejected")
+        self.assertFalse((self.output / "layout.ifcn").exists())
+
+    def test_large_interface_dispatches_to_sat_and_records_proof_method(self):
+        proof = {"status": "equivalent", "equivalent": True, "method": "z3_boolean_miter", "vectors_checked": 0}
+        with patch.object(multi_agent, "verify_bytes", return_value={"reason_code": "input_limit_exceeded"}), \
+             patch("ifcn.verify_sat.verify_sat_bytes", return_value=proof) as verify:
+            code, summary = self.execute("--max-model-calls", "0", "--z3-root", str(self.root), "--logic-timeout", "3")
+        self.assertEqual(code, 0, summary)
+        self.assertEqual(summary["logic_method"], "z3_boolean_miter")
+        self.assertEqual(verify.call_args.kwargs, {"z3_root": self.root, "timeout_seconds": 3.0})
+
+    def test_unknown_sat_result_cannot_approve_or_export_layout(self):
+        with patch.object(multi_agent, "verify_bytes", return_value={"reason_code": "input_limit_exceeded"}), \
+             patch("ifcn.verify_sat.verify_sat_bytes", return_value={"status": "unknown", "method": "z3_boolean_miter"}):
+            code, summary = self.execute("--max-model-calls", "0")
+        self.assertEqual(code, 1)
+        self.assertEqual(summary["status"], "logic_rejected")
+        self.assertFalse((self.output / "layout.ifcn").exists())
+
+    def test_existing_run_is_not_overwritten(self):
+        self.execute("--max-model-calls", "0")
+        previous = (self.output / "summary.json").read_bytes()
+        with self.assertRaises(SystemExit):
+            self.execute("--max-model-calls", "0")
+        self.assertEqual((self.output / "summary.json").read_bytes(), previous)
+
+
+if __name__ == "__main__":
+    unittest.main()
