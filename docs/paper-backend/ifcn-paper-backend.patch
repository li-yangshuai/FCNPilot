+        contract.status = CombinationalClockStatus::Invalid;
+        std::string geometryError;
+        bool geometryValid = false;
+        try {
+            geometryValid = graph.loadProvidedIrregularRoutes(suppliedRoutes, &geometryError);
+            if (geometryValid) {
+                graph.assignPhases(4, 4);
+                if (graph.hasClockFeedback()) {
+                    std::map<position, std::size_t> tileIds;
+                    const auto& points = graph.getClockPositions();
+                    const auto& routeEdges = graph.getClockRouteEdges();
+                    for (std::size_t index = 0; index < points.size(); ++index) tileIds.emplace(points[index], index);
+                    std::vector<std::size_t> released;
+                    std::vector<CombinationalClockWindowQuery> queries;
+                    for (auto edge : order) {
+                        const auto found = std::find(routeEdges.begin(), routeEdges.end(),
+                            std::make_pair(static_cast<unsigned int>(edge.first), static_cast<unsigned int>(edge.second)));
+                        if (found == routeEdges.end()) throw std::runtime_error("released edge missing from clock route provenance");
+                        released.push_back(static_cast<std::size_t>(found - routeEdges.begin()));
+                        queries.push_back({tileIds.at(before.at(edge.first)), tileIds.at(before.at(edge.second))});
+                    }
+                    contract = solveCombinationalClockArrivalWindows(graph.getClockFeedback(), released, queries, [&]() {
+                        cancelled = cancelled || std::chrono::duration<double>(std::chrono::steady_clock::now() - started).count() >= budget;
+                        return cancelled;
+                    });
