+                return fail("unknown route edge or fewer than two coordinates");
+            if (path.front() != nodeIndex_pos.at(edge.first) || path.back() != nodeIndex_pos.at(edge.second))
+                return fail("provided route endpoints disagree with node positions");
+            if (!sinkPorts[edge.second].insert(path[path.size() - 2]).second)
+                return fail("multiple fanins share one physical gate port");
+            std::set<position> unique;
+            for (std::size_t index = 0; index < path.size(); ++index) {
