+    def test_witness_preservation_uses_actual_inequalities_not_route_or_bound_identity(self):
+        witness = [
+            {"from_position": [0, 0], "to_position": [1, 0], "upper": 0,
+             "bound_id": 10, "route_index": 0, "kind": "step_upper"},
+            {"from_position": [1, 0], "to_position": [0, 0], "upper": -1,
+             "bound_id": 11, "route_index": 1, "kind": "gate_input_advance"},
+        ]
+        previous = {"clock_feedback": {"status": "infeasible_fixed_geometry", "conflict_witness": witness}}
+        renamed = deepcopy(witness)
+        for bound in renamed:
+            bound.update(bound_id=999, route_index=999, kind="another_source")
+        current = {"clock_feedback": {"status": "infeasible_fixed_geometry", "constraints": renamed}}
+        self.assertEqual(cooperation.witness_change(previous, current),
+                         {"old_witness_preserved": True, "old_witness_changed_bounds": 0})
+        for change in ({"from_position": [0, 1]}, {"to_position": [1, 1]}, {"upper": 1}):
+            with self.subTest(change=change):
+                changed = deepcopy(current)
+                changed["clock_feedback"]["constraints"][0].update(change)
+                self.assertEqual(cooperation.witness_change(previous, changed),
+                                 {"old_witness_preserved": False, "old_witness_changed_bounds": 1})
+        # The virtual zero variable is not the physical tile at coordinate
+        # (0, 0), even when both have zero epoch in one feasible assignment.
+        anchor_proof = {"clock_feedback": {"status": "infeasible_fixed_geometry", "conflict_witness": [
+            {"from_position": None, "to_position": [0, 0], "upper": 0}]}}
+        physical = {"clock_feedback": {"status": "feasible", "constraints": [
+            {"from_position": [0, 0], "to_position": [0, 0], "upper": 0}]}}
+        self.assertFalse(cooperation.witness_change(anchor_proof, physical)["old_witness_preserved"])
