+                    clock, message = choose("clock", priced, sid, context, messages, round_index - 1,
+                                            preferred_index=preferred_index)
+                    message["quote_visible"] = not hidden
+                    current_messages.append(message)
+                    context["spatial_quotes"] = quoted
+                    context["responsibility_differs_from_unpriced_rank"] = clock["option_id"] != quoted[(round_index - 1) % len(quoted)]["option_id"]
