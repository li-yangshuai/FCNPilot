+            return options[0]["option_id"]
+        from .clock_repair_policy import select_repair_action
+        config = dict(model_config, max_calls=stage_allowances[stage] - stage_used[stage])
+        context = dict(context, action_kind="query_contract" if stage == "contract" else "evaluate_paths")
+        selected, trace = select_repair_action(condition, sid, options, context, config,
+                                               history=list(history), deadline=deadline)
+        attempts = trace.get("model_calls", len(trace.get("calls", [])))
+        stage_used[stage] += attempts
+        model_seconds += trace.get("seconds", 0.0)
+        model_calls.extend(trace.get("calls", []))
+        decision = {"stage": stage, "decision": len(policy_decisions) + 1,
+                    "elapsed_seconds": time.monotonic() - started, **trace}
+        policy_decisions.append(decision)
+        write_json(output / f"policy_decision_{len(policy_decisions):04d}.json", decision)
+        return selected
+    common_context = {"task": "Restore this frozen FCN clock-infeasible geometry without area or output-tick growth.",
+                      "nodes": base["nodes"], "edges": base["edges"],
+                      "fixed_original_routes": base["routes"], "output_epoch_caps": caps,
+                      "original_negative_cycle": base.get("clock_feedback", {}).get("conflict_witness", []),
+                      "permissions": "All node coordinates fixed. At most three explicit route replacements. "
+                                     "All unreleased routes frozen. Four phases, PI epoch zero, at most four same-phase tiles.",
+                      "certification": "Window tests are necessary only; native geometry/global clock and output caps certify each proposal."}
+    selected_path = None
+    first_success = None
+    selected_metrics = selected_epochs = None
+    calls = 0
+    focus = _witness_edges(base.get("clock_feedback", {}))
+    queue = [(e,) for e in focus[:4]]
+    seen = set()
+    while queue and len(contracts) < max_contracts and time.monotonic() - started < wall_seconds:
+        if model_condition and stage_used["contract"] < stage_allowances["contract"]:
+            choices, available = [], set()
+            for pending in queue:
+                pending = tuple(sorted(pending))
+                if pending in seen or pending in available:
+                    continue
+                available.add(pending)
+                choices.append({"option_id": "query_" + digest(pending), "action_kind": "query_contract",
+                                "release_edges": [list(e) for e in pending],
+                                "fanout_dependencies": fanout_release_requests(base, pending)})
+                if len(choices) == 24:
+                    break
+            if choices:
+                selected = choose("contract", choices, dict(common_context,
+                    stage="Select which exact release set to query next, using observed conflict and shared-trunk evidence.",
+                    observed_contracts=[{k: c[k] for k in ("release_edges", "status", "windows", "pool_count",
+                        "window_rejections", "routing_release_requests") if k in c} for c in contracts]))
+                chosen = next(o for o in choices if o["option_id"] == selected)
+                group = tuple(sorted(map(tuple, chosen["release_edges"])))
+                queue.remove(next(g for g in queue if tuple(sorted(g)) == group))
+                queue.insert(0, group)
+        group = tuple(sorted(queue.pop(0)))
+        if group in seen:
+            continue
+        seen.add(group)
+        folder = output / f"contract_{len(contracts) + 1:04d}"
+        folder.mkdir()
+        request = {"schema": "ifcn.clock_contract_request.v1", "snapshot_id": sid,
+                   "release_edges": [list(e) for e in group]}
+        write_json(folder / "request.json", request)
+        remaining = deadline - time.monotonic()
+        if remaining <= 0:
+            break
+        seconds = min(contract_seconds, remaining)
+        command = [str(binary), "clock-contract", str(source), str(snapshot), str(folder / "request.json"),
+                   str(folder / "contract.json"), "--budget", str(seconds)]
+        code, elapsed = _native(command, folder, seconds)
+        analysis_seconds += elapsed
+        path = folder / "contract.json"
+        contract = json.loads(path.read_text()) if path.exists() else {"status": "process_failed"}
+        bound = (contract.get("schema") == "ifcn.clock_contract.v1" and contract.get("snapshot_id") == sid and
+                 sorted(contract.get("release_edges", [])) == sorted(request["release_edges"]) and
+                 contract.get("geometry_valid") is True)
+        if not bound:
+            contract = {"status": "invalid_binding"}
+        entry = {"release_edges": request["release_edges"], "status": contract["status"],
+                 "path": str(path) if path.exists() else None, "seconds": elapsed, "exit_code": code,
+                 "windows": contract.get("windows", []), "elapsed_seconds": time.monotonic() - started}
+        contracts.append(entry)
+        if contract["status"] == "infeasible_fixed_geometry" and len(group) < 3:
+            # A surviving negative cycle requires releasing at least one of
+            # its route origins. This is a proof-guided coalition expansion.
+            for edge in _witness_edges(contract)[:4]:
+                if edge not in group:
+                    queue.append(tuple(sorted((*group, edge))))
+            queue.sort(key=lambda g: (len(g), g))
+        if contract["status"] not in ("feasible", "infeasible_fixed_geometry"):
+            continue
+        generation_start = time.monotonic()
+        generated = generate_path_pool(base, group, max_paths)
+        generation_seconds += time.monotonic() - generation_start
+        filtering_start = time.monotonic()
+        filtered = window_filter(base, generated, contract)
+        endpoint_reasons = {o["option_id"]: reason for o, reason in endpoint_filter(base, generated, contract)}
+        window_seconds += time.monotonic() - filtering_start
+        entry["pool_count"] = len(generated)
+        entry["window_rejections"] = sum(reason is not None for _, reason in filtered)
+        if (condition != "no_fanout" and contract["status"] == "feasible" and len(group) < 3 and
+                not any(reason is None for _, reason in filtered)):
+            dependencies = fanout_release_requests(base, group)[:3]
+            entry["routing_release_requests"] = dependencies
+            # A feasible clock demand with no concrete path is returned to
+            # Clock with a shared-tree dependency. Recompute before acting;
+            # the earlier window must never survive this release-set change.
+            for request in reversed(dependencies):
+                queue.insert(0, tuple(sorted((*group, tuple(request["edge"])))))
+        for option, reason in filtered:
+            pool.append(dict(option, contract_index=len(contracts), window_rejection=reason,
+                             endpoint_rejection=endpoint_reasons[option["option_id"]]))
+    pool.sort(key=lambda o: (o["wire_delta"], len(o["changed_edges"]), len(o["release_edges"]), o["option_id"]))
+    pool_sha = digest(pool)
+    write_json(output / "pool.json", {"schema": "ifcn.clock_repair_pool.v1", "snapshot_id": sid,
+                                      "pool_sha256": pool_sha, "contracts": contracts, "options": pool})
+    # Duplicate concrete edits under larger release sets do not buy extra calls.
+    evaluated = set()
+    selectable = []
+    queued_edits = set()
+    for option in pool:
+        rejection = (None if condition == "path_geometry" else option["endpoint_rejection"]
+                     if condition == "endpoint_window" else option["window_rejection"])
+        if rejection is None:
+            changed = [r for r in option["route_replacements"]
+                       if tuple(map(tuple, r["path"])) != old[(r["source"], r["target"])]]
+            edit_key = digest(changed)
+            if edit_key not in queued_edits:
+                queued_edits.add(edit_key)
+                selectable.append(option)
+    while selectable:
+        if calls >= max_evaluations or time.monotonic() - started >= wall_seconds:
+            break
+        selected = choose("path", [dict(o, action_kind="evaluate_paths",
+                       endpoint_windows=contracts[o["contract_index"] - 1].get("windows", []))
+                       for o in selectable[:24]], dict(common_context,
+                       stage="Select an exact concrete path bundle for full native validation. "
+                             "Every offered option passes the common necessary filters; this does not certify output timing.",
+                       observed_contracts=[{k: c[k] for k in ("release_edges", "status", "windows", "pool_count",
+                           "window_rejections", "routing_release_requests") if k in c} for c in contracts]),
+                       history=[{k: e[k] for k in ("option_id", "status", "release_edges", "output_epochs", "valid")
+                                 if k in e} for e in events])
+        index = next(i for i, o in enumerate(selectable) if o["option_id"] == selected)
+        option = selectable.pop(index)
+        changed = [r for r in option["route_replacements"]
+                   if tuple(map(tuple, r["path"])) != old[(r["source"], r["target"])]]
+        key = digest(changed)
+        if key in evaluated:
+            continue
+        evaluated.add(key)
+        calls += 1
+        folder = output / f"evaluation_{calls:04d}"
+        folder.mkdir()
+        proposal = {"schema": "ifcn.cooperation_proposal.v1", "snapshot_id": sid, "operations": [],
+                    "routing_order": sorted(base["edges"]), "route_replacements": option["route_replacements"],
+                    "rationale": "Replace only the explicit frozen-snapshot paths; retain every other path."}
+        write_json(folder / "proposal.json", proposal)
+        candidate_path = folder / "candidate.json"
+        remaining = deadline - time.monotonic()
+        if remaining <= 0:
