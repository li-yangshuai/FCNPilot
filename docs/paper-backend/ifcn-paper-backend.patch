index 0000000..8bfb6e2
--- /dev/null
+++ b/tests/MultiAgentLayoutUnitTest.cpp
@@ -0,0 +1,444 @@
+#include <autopr/algorithms/multiAgentLayout.h>
+#include <autopr/algorithms/combinationalClock.h>
+#include <autopr/graph/circuitGraph.h>
+#include <algorithm>
+#include <chrono>
+#include <cmath>
+#include <filesystem>
+#include <fstream>
+#include <iostream>
+#include <limits>
+#include <set>
+#include <stdexcept>
+#include <thread>
+#include <tuple>
+#include <unistd.h>
+
+namespace {
+using namespace fcngraph;
+
+void require(bool condition, const char* message)
+{
+    if (!condition) throw std::runtime_error(message);
+}
+
+auto objective(const CombinationalLayoutMetrics& metrics)
+{
+    return std::make_tuple(metrics.area, metrics.physicalCells, metrics.routeLength);
+}
+
+CombinationalLayoutMetrics check(Parse& parse, const std::string& source,
+                                 const GraphDrawCandidate& layout, int phases)
+{
+    GridChessboard board;
+    Astar router(board, false, 240.0);
+    CircuitGraph graph(parse, source, board, router);
+    graph.nodeIndex_pos = layout.nodePositions;
+    graph.routes = layout.routes;
+    board.gridMap = layout.gridCells;
+    return validateCombinationalLayout(parse, graph, phases, 4);
+}
+}
+
+int main()
+{
+    char temporary[] = "/tmp/ifcn-multi-agent-contract-XXXXXX";
+    if (!mkdtemp(temporary)) return 1;
+    const auto directory = std::filesystem::path(temporary);
+    struct Cleanup {
+        std::filesystem::path path;
+        ~Cleanup() { std::filesystem::remove_all(path); }
+    } cleanup{directory};
+    const auto source = directory / "and.v";
+    const auto majority = directory / "majority.v";
+    std::ofstream(source) << "module example(input a, input b, output y); assign y=a&b; endmodule\n";
+    std::ofstream(majority) << "module example(input a, input b, input c, output y); "
+                              "assign y=(a&b)|(a&c)|(b&c); endmodule\n";
+    try {
+        GridChessboard cancelledBoard, freshBoard;
+        Astar cancellable(cancelledBoard, false, 240.0), fresh(freshBoard, false, 240.0);
+        int cancellationChecks = 0;
+        cancellable.setCancellationCallback([&] { return ++cancellationChecks >= 2; });
+        require(cancellable.findPath({4, 4}, {104, 4}).empty() && cancellationChecks >= 2,
+                "A long single-net search did not honor inner cancellation");
+        cancellable.setCancellationCallback({});
+        const auto afterCancellation = cancellable.findPath({4, 4}, {104, 4});
+        require(!afterCancellation.empty() && afterCancellation == fresh.findPath({4, 4}, {104, 4}),
+                "Cancelled net search corrupted subsequent routing ownership");
+        CombinationalClockProblem clockProblem;
+        clockProblem.tileCount = 3;
+        clockProblem.routes = {{0, 1, 2}};
+        clockProblem.primaryInputs = {0};
+        std::vector<std::int64_t> epochs;
+        std::string clockError;
+        require(!solveCombinationalClockEpochs(clockProblem, epochs, &clockError, nullptr, 4, [] { return true; }) &&
+                epochs.empty() && clockError.find("cancelled") != std::string::npos,
+                "Cancelled clock search published a partial assignment");
+        require(solveCombinationalClockEpochs(clockProblem, epochs), "Clock cancellation corrupted a later solve");
+        IrregularLayoutOptions options;
+        options.timeBudgetSeconds = 3.0;
+        options.maxAttempts = 12;
+        std::vector<GraphDrawCandidate> observed;
+        std::vector<CombinationalLayoutMetrics> observedMetrics;
+        options.onCandidate = [&](Parse& parse, const GraphDrawCandidate& layout,
+                                  const CombinationalLayoutMetrics& metrics, const std::string& seed) {
+            require(metrics.valid && !seed.empty(), "Invalid candidate reached the observer");
+            const auto actual = check(parse, source.string(), layout, options.phaseCount);
+            require(actual.valid && objective(actual) == objective(metrics),
+                    "Observed candidate does not pass independent physical/clock DRC");
+            observed.push_back(layout);
+            observedMetrics.push_back(metrics);
+        };
+        const auto result = searchMultiAgentLayout(source.string(), options);
+        require(result.success && result.parse && !result.attempts.empty(), "No legal AND layout");
+        require(result.attempts.size() <= static_cast<std::size_t>(options.maxAttempts),
+                "Attempt limit is not a global proposal bound");
+        require(!observed.empty(), "Search did not publish its legal candidates");
+        bool winnerObserved = false;
+        for (std::size_t i = 0; i < observed.size(); ++i) {
+            require(objective(result.metrics) <= objective(observedMetrics[i]),
+                    "Winner violates the documented lexicographic objective");
+            const auto& candidate = observed[i];
+            if (candidate.nodePositions != result.layout.nodePositions || candidate.routes != result.layout.routes)
+                continue;
+            bool matching = candidate.gridCells.size() == result.layout.gridCells.size();
+            for (const auto& cell : result.layout.gridCells) {
+                const auto found = candidate.gridCells.find(cell.first);
+                matching = matching && found != candidate.gridCells.end() &&
+                    found->second.getPhase() == cell.second.getPhase() &&
+                    found->second.get_current_weight() == cell.second.get_current_weight();
+            }
+            winnerObserved |= matching;
+        }
+        require(winnerObserved, "Final winner changed after observation or was never observed");
+        const auto verified = check(*result.parse, source.string(), result.layout, options.phaseCount);
+        require(verified.valid && objective(verified) == objective(result.metrics),
+                "Later proposals corrupted the retained incumbent");
+        std::set<std::string> actors, proposals;
+        int accepted = 0, feedbackMessages = 0;
+        for (const auto& event : result.agentEvents) {
+            actors.insert(event.actor);
+            require(event.attempt > 0 && event.attempt <= options.maxAttempts &&
+                    !event.proposal.empty() && !event.feedback.empty(), "Malformed agent event");
+            if (!event.parent.empty()) {
+                require(proposals.count(event.parent), "Feedback refers to an unknown shared proposal");
+                ++feedbackMessages;
+            }
+            proposals.insert(event.proposal);
+            if (event.accepted) {
+                require(event.actor == "validation" && event.valid && event.metrics.valid,
+                        "An unvalidated proposal became incumbent");
+                ++accepted;
+            }
+        }
+        require(actors == std::set<std::string>{"placement", "routing", "clock", "validation"},
+                "Missing an operational agent");
+        require(accepted > 0 && feedbackMessages > 0,
+                "Agents did not exchange and act on shared candidate feedback");
+        require(proposals.size() == result.attempts.size(), "Event proposal accounting disagrees with attempts");
+        require(result.graphStats.topology == "optimized_compact" && result.graphStats.nodeCount >= 3 &&
+                result.graphStats.edgeCount >= 2 && result.graphStats.maxLayerWidth >= 2 &&
+                result.graphStats.topologicalDepth >= 2, "Circuit-scale reference stats are missing");
+        for (const auto& event : result.agentEvents) {
+            if (event.actor != "validation") continue;
+            const auto& diagnostic = event.diagnostics;
+            require(diagnostic.proposal == event.proposal && diagnostic.nodeCount > 0 && diagnostic.edgeCount > 0 &&
+                    diagnostic.routedEdges <= diagnostic.edgeCount &&
+                    diagnostic.missingEdges == diagnostic.edgeCount - diagnostic.routedEdges,
+                    "Retained routing diagnostics miscount missing versus observed edges");
+            if (event.valid) require(diagnostic.missingEdges == 0 && diagnostic.width > 0 && diagnostic.height > 0,
+                                     "A legal proposal reports incomplete geometry");
+        }
+        {
+            GridChessboard board;
+            Astar bounded(board, false, 0.0);
+            CircuitGraph blocked(*result.parse, source.string(), board, bounded);
+            blocked.nodeIndex_pos = result.layout.nodePositions;
+            const auto edges = result.parse->getEffectiveEdges();
+            const std::set<std::pair<int, int>> expected(edges.begin(), edges.end());
+            std::size_t actualConflicts = 0;
+            blocked.setRoutingConflictCallback([&](int from, int to, const std::string& reason) {
+                require(expected.count({from, to}) && (reason == "no_path" || reason == "intermediate_gate"),
+                        "Routing pressure reported an edge that was not actually attempted");
+                ++actualConflicts;
+            });
+            require(!blocked.routeGraphPlacement(4) && actualConflicts > 0,
+                    "A deliberately bounded failed route did not publish typed edge pressure");
+        }
+
+        {
+            // The reconvergent XOR used by the gate-port expansion regression
+            // needs real capacity cuts from a unit-spaced placement. Stop at
+            // the first committed legal cut, without a wall-clock race.
+            const auto repairSource = directory / "clock_repair.v";
+            std::ofstream(repairSource) <<
+                "module repair(input a,b,output y); wire w0,w1,w2; "
+                "assign w0=a|b; assign w1=a&b; assign w2=~w1; "
+                "assign y=w0&w2; endmodule\n";
+            Parse repairParse;
+            repairParse.parseVerilog(repairSource.string());
+            repairParse.optimizeAIOG_DRC(2, 2, 2, 2, 2, 2);
+            repairParse.optimizeBufferNode();
+            repairParse.caculateSameLayerNodeRoutePair();
+            std::vector<std::vector<int>> layers;
+            for (const auto& layer : repairParse.getlayerNodeDivVec())
+                layers.emplace_back(layer.begin(), layer.end());
+            GridChessboard board;
+            Astar router(board, false, 240.0);
+            router.setAllowInterSourceWireOverlap(false);
+            router.setOccupiedWirePenalty(0.0);
+            CircuitGraph graph(repairParse, repairSource.string(), board, router);
+            graph.sortNodesByFixedLayerOrder(layers, 1, 1, 4, 4);
+            const auto seedPositions = graph.nodeIndex_pos;
+            bool cancelAfterCommit = false;
+            GraphDrawCandidate committed;
+            graph.setCancellationCallback([&] { return cancelAfterCommit; });
+            graph.setStageCallback([&](const std::string& stage) {
+                if (stage.find("layout_insert_") != 0 ||
+                    !validateCombinationalLayout(repairParse, graph, 4, 4).valid)
+                    return;
+                committed.nodePositions = graph.nodeIndex_pos;
+                committed.routes = graph.routes;
+                committed.gridCells = board.gridMap;
+                cancelAfterCommit = true;
+            });
+            require(graph.routeWithCapacityExpansion(4, 12, 8, 240.0, 4) && cancelAfterCommit,
+                    "Cancellation discarded a legal capacity-cut trial before it was published");
