+            {"full_clock_feedback", fullClock}, {"positions", fullClock.at("positions")},
+            {"route_edges", fullClock.at("route_edges")}, {"tile_count", fullClock.at("tile_count")},
+            {"zero_variable", fullClock.at("zero_variable")}, {"release_edges", releasedEdges},
+            {"frozen_edges", frozenEdges}, {"retained_constraints", retained},
