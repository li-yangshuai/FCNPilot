diff --git a/include/autopr/algorithms/multiAgentLayout.cpp b/include/autopr/algorithms/multiAgentLayout.cpp
new file mode 100644
index 0000000..364733a
--- /dev/null
+++ b/include/autopr/algorithms/multiAgentLayout.cpp
@@ -0,0 +1,599 @@
+#include "multiAgentLayout.h"
+
+#include <autopr/graph/circuitGraph.h>
+#include <algorithm>
+#include <chrono>
+#include <cmath>
+#include <exception>
+#include <limits>
+#include <map>
+#include <stdexcept>
+#include <tuple>
+
+namespace fcngraph {
+namespace {
+using Clock = std::chrono::steady_clock;
+
+enum class Action { Graphviz, Elastic, Ordered, Repair, Compact, Reroute };
+
+struct Proposal {
+    Action action = Action::Elastic;
+    std::string name;
+    std::string parent;
+    std::string feedback;
+    std::shared_ptr<Parse> parse;
+    GraphDrawCandidate input;
+    bool layerBuffered = false;
+    unsigned int x = 1, y = 2;
+    bool horizontal = false;
+    unsigned int orderVariant = 0;
+    int depth = 0;
+    double retainedCoverage = 0.0;
+    std::uint64_t failedArea = 0;
+};
+
+struct Contender {
+    std::string name;
+    std::shared_ptr<Parse> parse;
+    GraphDrawCandidate layout;
+    CombinationalLayoutMetrics metrics;
+    int nextRefinement = 0;
+};
+
+auto score(const CombinationalLayoutMetrics& metrics)
+{
+    return std::make_tuple(metrics.area, metrics.physicalCells, metrics.routeLength);
+}
+
+std::shared_ptr<Parse> prepare(const std::string& source, bool buffered)
+{
+    // Parse copies share graph storage: each normalization needs a fresh parse.
+    auto parse = std::make_shared<Parse>();
+    parse->parseVerilog(source);
+    if (!parse->get_input_num() || !parse->get_output_num())
+        throw std::runtime_error("Circuit must have primary inputs and outputs");
+    parse->optimizeAIOG_DRC(2, 2, 2, 2, 2, 2);
+    if (buffered) parse->addLayerRedundancyNode();
+    else parse->optimizeBufferNode();
+    parse->caculateSameLayerNodeRoutePair();
+    return parse;
+}
+
+std::vector<std::vector<int>> orderedLayers(Parse& parse, unsigned int variant)
+{
+    std::vector<std::vector<int>> layers;
+    for (const auto& layer : parse.getlayerNodeDivVec()) layers.emplace_back(layer.begin(), layer.end());
+    std::map<int, std::vector<int>> incoming, outgoing;
+    for (const auto edge : parse.getEffectiveEdges()) {
+        incoming[edge.second].push_back(edge.first);
+        outgoing[edge.first].push_back(edge.second);
+    }
+    for (int sweep = 0; sweep < 8; ++sweep) {
+        const bool forward = sweep % 2 == 0;
+        const auto& adjacent = forward ? incoming : outgoing;
+        std::map<int, double> positions;
+        for (const auto& layer : layers)
+            for (std::size_t i = 0; i < layer.size(); ++i) positions[layer[i]] = i;
+        for (std::size_t step = 0; step < layers.size(); ++step) {
+            auto& layer = layers[forward ? step : layers.size() - 1 - step];
+            std::map<int, double> scores;
+            for (int node : layer) {
+                const auto found = adjacent.find(node);
+                double sum = 0;
+                if (found != adjacent.end()) for (int neighbor : found->second) sum += positions[neighbor];
+                scores[node] = found != adjacent.end() && !found->second.empty()
+                    ? sum / found->second.size() : positions[node];
+            }
+            std::stable_sort(layer.begin(), layer.end(), [&](int a, int b) { return scores[a] < scores[b]; });
+            for (std::size_t i = 0; i < layer.size(); ++i) positions[layer[i]] = i;
+        }
+    }
+    unsigned int bit = 0;
+    for (auto& layer : layers) {
+        if (layer.size() < 2 || bit == 3) continue;
+        if (variant & (1u << bit)) std::reverse(layer.begin(), layer.end());
+        ++bit;
+    }
+    return layers;
+}
+
+GraphDrawCandidate capture(const CircuitGraph& graph, const GridChessboard& board,
+                           const CombinationalLayoutMetrics& metrics)
+{
+    GraphDrawCandidate result;
+    result.nodePositions = graph.nodeIndex_pos;
+    result.routes = graph.routes;
+    result.gridCells = board.gridMap;
+    result.physicalCellCount = metrics.physicalCells;
+    result.routeLength = static_cast<int>(metrics.routeLength);
+    unsigned int minX = std::numeric_limits<unsigned int>::max(), minY = minX, maxX = 0, maxY = 0;
+    const auto include = [&](position point) {
+        minX = std::min(minX, point.first); minY = std::min(minY, point.second);
+        maxX = std::max(maxX, point.first); maxY = std::max(maxY, point.second);
+    };
+    for (const auto& node : graph.nodeIndex_pos) include(node.second);
+    for (const auto& route : graph.routes) {
+        int previous = -1, run = 0;
+        for (position point : route.second) {
+            include(point);
+            const int phase = board.gridMap.at(point).getPhase();
+            run = phase == previous ? run + 1 : 1;
+            result.phaseRuns.maxRun = std::max(result.phaseRuns.maxRun, run);
+            previous = phase;
+        }
+    }
+    result.bounds = {static_cast<int>(minX), static_cast<int>(maxX),
+                     static_cast<int>(minY), static_cast<int>(maxY),
+                     static_cast<int>(metrics.width), static_cast<int>(metrics.height),
+                     static_cast<int>(metrics.area)};
+    return result;
+}
+
+MultiAgentGraphStats graphStats(Parse& parse)
+{
+    MultiAgentGraphStats stats;
+    stats.edgeCount = parse.getEffectiveEdges().size();
+    for (const auto& layer : parse.getlayerNodeDivVec()) {
+        stats.nodeCount += layer.size();
+        stats.maxLayerWidth = std::max(stats.maxLayerWidth, layer.size());
+        if (!layer.empty()) ++stats.topologicalDepth;
+    }
+    return stats;
+}
+
+double routingCost(Parse& parse, const CircuitGraph& graph)
+{
+    std::uint64_t longest = 0;
+    for (const auto edge : parse.getEffectiveEdges()) {
+        const auto source = graph.nodeIndex_pos.find(edge.first);
+        const auto target = graph.nodeIndex_pos.find(edge.second);
+        if (source == graph.nodeIndex_pos.end() || target == graph.nodeIndex_pos.end()) continue;
+        const auto distance = [](unsigned int a, unsigned int b) {
+            return a > b ? static_cast<std::uint64_t>(a) - b : static_cast<std::uint64_t>(b) - a;
+        };
+        longest = std::max(longest, distance(source->second.first, target->second.first) +
+                                    distance(source->second.second, target->second.second));
+    }
+    // Respect actual net span without opening an unbounded A* search plane.
+    // Very long or congested nets may still fail and must be reported as such.
+    return std::clamp(2.0 * static_cast<double>(longest) + 32.0, 240.0, 800.0);
+}
+
+std::vector<Proposal> placementPortfolio(bool largeGraph)
+{
+    std::vector<Proposal> proposals;
+    const auto append = [&](Action action, const std::string& name,
+                            unsigned int x, unsigned int y, bool horizontal = false,
+                            unsigned int variant = 0, bool layerBuffered = true) {
+        Proposal item;
+        item.action = action; item.name = name; item.x = x; item.y = y;
+        item.horizontal = horizontal; item.orderVariant = variant;
+        item.layerBuffered = action == Action::Graphviz && layerBuffered;
+        item.feedback = "explore a different buffering, placement or flow basin";
+        proposals.push_back(std::move(item));
+    };
+    const auto compactGraphviz = [&](const std::string& name, unsigned int x, unsigned int y) {
+        append(Action::Graphviz, "graphviz_compact_" + name, x, y, false, 0, false);
+    };
+    // Keep the historical first proposal, including its buffered topology and
+    // cheap routing cost. The next Graphviz basin uses the compact graph;
+    // removing an oversized buffered topology must not remove this family.
+    append(Action::Graphviz, "graphviz_40x40", 40, 40);
+    compactGraphviz("40x40", 40, 40);
+    if (largeGraph) {
+        // Larger quantization divisors compress Graphviz geometry. Start
+        // with the historical 40 fallback, then give broad graphs capacity
+        // before spending time on the tight 1x2 small-circuit portfolio.
+        for (unsigned int scale : {32u, 24u, 20u}) {
+            append(Action::Graphviz, "graphviz_buffered_sparse_" + std::to_string(scale), scale, scale);
+            compactGraphviz("sparse_" + std::to_string(scale), scale, scale);
+        }
+        for (const auto spacing : std::vector<std::pair<unsigned int, unsigned int>>{{4,4}, {6,4}, {4,6}}) {
+            const auto scale = std::to_string(spacing.first) + "x" + std::to_string(spacing.second);
+            for (bool horizontal : {false, true}) {
+                append(Action::Ordered, "ordered_sparse_" + scale + (horizontal ? "_h" : "_v"),
+                       spacing.first, spacing.second, horizontal);
+                append(Action::Elastic, "elastic_sparse_" + scale + (horizontal ? "_h" : "_v"),
+                       spacing.first, spacing.second, horizontal);
+            }
+        }
+    }
+    for (const auto spacing : std::vector<std::pair<unsigned int, unsigned int>>{
+             {1,2}, {2,2}, {1,3}, {2,3}, {3,1}, {2,1}, {1,1}, {3,4}, {2,4}, {3,3}, {4,4}, {3,5}, {4,6}}) {
+        const auto scale = std::to_string(spacing.first) + "x" + std::to_string(spacing.second);
+        for (bool horizontal : {false, true}) {
+            append(Action::Elastic, "elastic_" + scale + (horizontal ? "_h" : "_v"),
+                   spacing.first, spacing.second, horizontal);
+            if (spacing.first <= 3 && spacing.second <= 3)
+                append(Action::Ordered, "ordered_" + scale + (horizontal ? "_h" : "_v"),
+                       spacing.first, spacing.second, horizontal);
+        }
+    }
+    for (unsigned int variant = 1; variant < 8; ++variant)
+        for (const auto spacing : std::vector<std::pair<unsigned int, unsigned int>>{{2,1}, {3,1}, {2,2}})
+            append(Action::Ordered, "reordered_" + std::to_string(variant) + "_" +
+                   std::to_string(spacing.first) + "x" + std::to_string(spacing.second),
+                   spacing.first, spacing.second, false, variant);
+    for (unsigned int scale : {32u, 48u, 56u, 64u, 80u, 96u}) {
+        append(Action::Graphviz, "graphviz_buffered_" + std::to_string(scale), scale, scale);
+        // The large profile already includes compact scale 32 near the front.
+        if (!largeGraph || scale != 32u)
+            compactGraphviz(std::to_string(scale), scale, scale);
+    }
+    compactGraphviz("48x64", 48, 64);
+    compactGraphviz("64x48", 64, 48);
+    return proposals;
+}
+} // namespace
+
+MultiAgentLayoutResult searchMultiAgentLayout(const std::string& sourceFile,
+                                             const IrregularLayoutOptions& options,
+                                             const GraphDrawSearchCallback& progress,
+                                             const MultiAgentPolicyCallback& policy,
+                                             const MultiAgentSearchOptions& controls)
+{
+    MultiAgentLayoutResult result;
+    result.feedbackEnabled = controls.feedbackEnabled;
+    const auto started = Clock::now();
+    const auto elapsed = [&] { return std::chrono::duration<double>(Clock::now() - started).count(); };
+    if (options.phaseCount < 3 || options.phaseCount > 4 || options.maxAttempts < 1 ||
+        !std::isfinite(options.timeBudgetSeconds) || options.timeBudgetSeconds <= 0) {
+        result.error = "Multi-agent layout requires 3/4 phases, positive attempts and a finite positive time budget";
+        return result;
+    }
+    if (!controls.feedbackEnabled && policy) {
+        result.error = "External feedback policy is incompatible with the no-feedback ablation";
+        return result;
+    }
+    const auto expired = [&] { return elapsed() >= options.timeBudgetSeconds; };
+    std::vector<Contender> beam;
+    std::vector<Proposal> repairs;
+    std::vector<Proposal> portfolio;
+    MultiAgentProposalDiagnostics lastProposal;
+    int updates = 0, feedbackTurns = 0;
+    double feedbackSeconds = 0.0;
+    // A stable slice lets later fresh seeds finish: remaining/6 previously
+    // shrank toward milliseconds after a few expensive failed repairs.
+    const double baseSlice = std::clamp(options.timeBudgetSeconds /
+        static_cast<double>(std::min(24, options.maxAttempts)), 0.1, 8.0);
+    const double minimumSlice = std::min(0.02, options.timeBudgetSeconds * 0.01);
+    const double explorationFeedbackLimit = options.timeBudgetSeconds * 0.4;
+    std::exception_ptr observerFailure;
+    std::exception_ptr policyFailure;
+    try {
+        auto compact = prepare(sourceFile, false);
+        result.graphStats = graphStats(*compact);
+        auto buffered = prepare(sourceFile, true);
+        const auto bufferedStats = graphStats(*buffered);
+        const bool compactAllowed = !options.maxCandidateNodes || result.graphStats.nodeCount <= options.maxCandidateNodes;
+        const bool bufferedAllowed = !options.maxCandidateNodes || bufferedStats.nodeCount <= options.maxCandidateNodes;
+        if (!compactAllowed && !bufferedAllowed)
+            throw std::runtime_error("Both prepared topologies exceed the maximum candidate node count " +
+                                     std::to_string(options.maxCandidateNodes));
+        // Buffer expansion and fanout can make a small compact reference
+        // graph congested. Give it the sparse family early as well.
+        result.largeGraphProfile = result.graphStats.nodeCount >= 50 || bufferedStats.nodeCount >= 50 ||
+                                   result.graphStats.edgeCount >= 60;
+        portfolio = placementPortfolio(result.largeGraphProfile);
+        portfolio.erase(std::remove_if(portfolio.begin(), portfolio.end(), [&](const Proposal& item) {
+            return item.layerBuffered ? !bufferedAllowed : !compactAllowed;
+        }), portfolio.end());
+        for (int index = 0; index < options.maxAttempts && !expired(); ++index) {
+            if (options.timeBudgetSeconds - elapsed() < minimumSlice) break;
+            Proposal proposal;
+            auto parent = beam.end();
+            for (auto candidate = beam.begin(); candidate != beam.end(); ++candidate)
+                if (candidate->nextRefinement < 3 &&
+                    (parent == beam.end() || candidate->nextRefinement < parent->nextRefinement))
+                    parent = candidate;
+            // Exploration receives every other turn. Feedback turns choose
+            // from actual failures or the shared legal beam, never a second
+            // independent copy of the baseline search.
+            // Reserve solver time for fresh geometry while the portfolio is
+            // nonempty. A controller sees only actions this budget can fund.
+            const bool feedbackAllowed = controls.feedbackEnabled && (portfolio.empty() ||
+                explorationFeedbackLimit - feedbackSeconds >= minimumSlice);
+            const bool feedbackTurn = feedbackAllowed && (index % 2 == 1 || portfolio.empty());
+            std::string suggested;
+            if (feedbackTurn) {
+                ++feedbackTurns;
+                if (!repairs.empty() && (beam.empty() || feedbackTurns % 3 == 0)) suggested = "repair";
+                else if (parent != beam.end()) suggested = parent->nextRefinement == 1 ? "reroute" : "compact";
+                else if (!repairs.empty()) suggested = "repair";
+            }
+            if (suggested.empty() && !portfolio.empty()) suggested = "explore";
+            if (suggested.empty()) break;
+
+            MultiAgentDecisionContext context;
+            context.attempt = index + 1;
+            context.attemptLimit = options.maxAttempts;
+            context.remainingSeconds = std::max(0.0, options.timeBudgetSeconds - elapsed());
+            context.hasIncumbent = result.success;
+            context.bestMetrics = result.metrics;
+            context.beamSize = beam.size();
+            context.pendingRepairs = repairs.size();
+            context.nodeCount = result.graphStats.nodeCount;
+            context.edgeCount = result.graphStats.edgeCount;
+            context.maxLayerWidth = result.graphStats.maxLayerWidth;
+            context.topologicalDepth = result.graphStats.topologicalDepth;
+            context.lastProposal = lastProposal;
+            context.suggestedAction = suggested;
+            if (!result.agentEvents.empty()) context.lastFeedback = result.agentEvents.back().feedback;
+            if (!portfolio.empty()) context.availableActions.push_back("explore");
+            for (const auto family : {std::make_pair(Action::Graphviz, "graphviz"),
+                                       std::make_pair(Action::Elastic, "elastic"),
+                                       std::make_pair(Action::Ordered, "ordered")})
+                if (std::any_of(portfolio.begin(), portfolio.end(), [&](const Proposal& item) { return item.action == family.first; }))
+                    context.availableActions.push_back(family.second);
+            if (feedbackAllowed && !repairs.empty()) context.availableActions.push_back("repair");
+            if (feedbackAllowed && parent != beam.end()) {
+                context.availableActions.push_back("compact");
+                context.availableActions.push_back("reroute");
+            }
+            std::string action = suggested, policyFeedback;
+            if (policy) {
+                std::string requested;
+                try { requested = policy(context); }
+                catch (...) { policyFailure = std::current_exception(); std::rethrow_exception(policyFailure); }
+                if (std::find(context.availableActions.begin(), context.availableActions.end(), requested) !=
+                    context.availableActions.end()) {
+                    action = requested;
+                    policyFeedback = "; external policy selected " + requested;
+                } else {
+                    policyFeedback = requested.empty() ? "; external policy deferred to " + suggested :
+                        "; unavailable external action '" + requested + "'; fell back to " + suggested;
+                }
+                // No new solver work is authorized after the controller has
+                // consumed the budget; an existing incumbent stays intact.
+                if (expired()) break;
+            }
+            if (action == "repair") {
+                proposal = std::move(repairs.front()); repairs.erase(repairs.begin());
+            } else if (action == "compact" || action == "reroute") {
+                proposal.parse = parent->parse;
+                proposal.input = parent->layout;
+                proposal.parent = parent->name;
+                proposal.depth = parent->nextRefinement++;
+                proposal.action = action == "compact" ? Action::Compact : Action::Reroute;
+                proposal.name = action;
+                proposal.feedback = action == "compact"
+                    ? "legal shared candidate: reduce occupied area and mapped cells"
+                    : "shared candidate: change routing cost before another placement refinement";
+            } else {
+                auto seed = portfolio.begin();
+                if (action != "explore") {
+                    const auto family = action == "graphviz" ? Action::Graphviz :
+                                        action == "elastic" ? Action::Elastic : Action::Ordered;
+                    seed = std::find_if(portfolio.begin(), portfolio.end(),
+                        [&](const Proposal& item) { return item.action == family; });
+                }
+                proposal = std::move(*seed);
+                portfolio.erase(seed);
+                proposal.parse = proposal.layerBuffered ? buffered : compact;
+            }
+            proposal.feedback += proposal.parse == buffered
+                ? "; topology=layer_buffered" : "; topology=optimized_compact";
+            proposal.feedback += policyFeedback;
+            proposal.name = "ma_" + std::to_string(index + 1) + "_" + proposal.name;
+            const auto attemptStarted = Clock::now();
+            const double remaining = options.timeBudgetSeconds - elapsed();
+            if (remaining < minimumSlice) break;
+            // Keep a difficult route or a refinement from monopolizing all
+            // agents. Helpers check cancellation between bounded searches.
+            double slice = std::min(remaining, baseSlice * (proposal.action == Action::Repair ? 2.0 : 1.0));
+            if (!proposal.parent.empty() && !portfolio.empty())
+                slice = std::min(slice, explorationFeedbackLimit - feedbackSeconds);
+            if (slice < minimumSlice) break;
+            const double stopAt = elapsed() + slice;
+            const auto cancelled = [&] { return expired() || elapsed() >= stopAt; };
+            MultiAgentProposalDiagnostics diagnostics;
+            diagnostics.proposal = proposal.name;
+            diagnostics.timeSliceSeconds = slice;
+            const auto actualStats = graphStats(*proposal.parse);
+            diagnostics.nodeCount = actualStats.nodeCount;
+            diagnostics.edgeCount = actualStats.edgeCount;
+            const auto message = [&](const std::string& actor, const std::string& feedback,
+                                     bool valid = false, bool accepted = false,
+                                     const CombinationalLayoutMetrics& metrics = {}) {
+                result.agentEvents.push_back({index + 1, actor, proposal.name, proposal.parent,
+                                              feedback, valid, accepted, metrics, elapsed(), diagnostics});
+            };
+            message("placement", proposal.feedback);
+            GridChessboard board;
+            Astar router(board, false, 240.0);
+            router.setAllowInterSourceWireOverlap(false);
+            CircuitGraph graph(*proposal.parse, sourceFile, board, router);
+            graph.setCancellationCallback(cancelled);
+            std::map<std::pair<int, int>, MultiAgentRoutingConflict> conflicts;
+            graph.setStageCallback([&](const std::string& stage) {
+                if (stage == "clock_rejected") ++diagnostics.clockRejections;
+            });
+            graph.setRoutingConflictCallback([&](int source, int target, const std::string&) {
+                ++diagnostics.routingConflicts;
+                auto& conflict = conflicts[{source, target}];
+                conflict.source = source; conflict.target = target;
+                ++conflict.observations;
+                const auto from = graph.nodeIndex_pos.find(source), to = graph.nodeIndex_pos.find(target);
+                if (from != graph.nodeIndex_pos.end()) {
+                    conflict.sourceX = from->second.first; conflict.sourceY = from->second.second;
+                }
+                if (to != graph.nodeIndex_pos.end()) {
+                    conflict.targetX = to->second.first; conflict.targetY = to->second.second;
+                }
+            });
+            const auto collectDiagnostics = [&] {
+                diagnostics.routedEdges = graph.routes.size();
+                diagnostics.missingEdges = diagnostics.edgeCount > diagnostics.routedEdges
+                    ? diagnostics.edgeCount - diagnostics.routedEdges : 0;
+                unsigned int minX = std::numeric_limits<unsigned int>::max(), minY = minX, maxX = 0, maxY = 0;
+                const auto include = [&](position point) {
+                    minX = std::min(minX, point.first); minY = std::min(minY, point.second);
+                    maxX = std::max(maxX, point.first); maxY = std::max(maxY, point.second);
+                };
+                for (const auto& node : graph.nodeIndex_pos) include(node.second);
+                for (const auto& route : graph.routes) for (position point : route.second) include(point);
+                if (!graph.nodeIndex_pos.empty()) {
+                    diagnostics.width = static_cast<std::uint64_t>(maxX) - minX + 1;
+                    diagnostics.height = static_cast<std::uint64_t>(maxY) - minY + 1;
+                }
+                diagnostics.insertedRows = graph.getAdaptiveExpansionStats().insertedRows;
+                diagnostics.insertedColumns = graph.getAdaptiveExpansionStats().insertedColumns;
+                diagnostics.conflicts.clear();
+                for (const auto& conflict : conflicts) diagnostics.conflicts.push_back(conflict.second);
+                std::stable_sort(diagnostics.conflicts.begin(), diagnostics.conflicts.end(),
+                    [](const auto& a, const auto& b) { return a.observations > b.observations; });
+                if (diagnostics.conflicts.size() > 8) diagnostics.conflicts.resize(8);
+            };
+            IrregularLayoutAttempt attempt;
+            attempt.seed = proposal.name;
+            bool routed = false;
+            try {
+                if (proposal.action == Action::Compact) {
+                    graph.nodeIndex_pos = proposal.input.nodePositions;
+                    graph.routes = proposal.input.routes;
+                    board.gridMap = proposal.input.gridCells;
+                    if (result.largeGraphProfile) router.setMaxSearchCost(routingCost(*proposal.parse, graph));
+                    routed = graph.compactMappedLayout(options.phaseCount,
+                        proposal.depth == 0 ? 4 : 12, proposal.depth == 0 ? 48 : 128, 8);
+                } else if (proposal.action == Action::Repair) {
+                    graph.nodeIndex_pos = proposal.input.nodePositions;
+                    routed = graph.routeWithCapacityExpansion(options.phaseCount, 8, 4,
+                        result.largeGraphProfile ? routingCost(*proposal.parse, graph) : 240.0, 4);
+                } else if (proposal.action == Action::Reroute) {
+                    graph.nodeIndex_pos = proposal.input.nodePositions;
+                    router.setOccupiedWirePenalty(0.0);
+                    if (result.largeGraphProfile) router.setMaxSearchCost(routingCost(*proposal.parse, graph));
+                    routed = graph.routeGraphPlacement(options.phaseCount);
+                } else if (proposal.action == Action::Graphviz) {
+                    router.setMaxSearchCost(80.0);
+                    // Preserve only the legacy buffered 40x40 fallback's
+                    // cost. Compact geometry can span several layers per net
+                    // without balancing buffers, so measure its actual span.
+                    if (!proposal.layerBuffered ||
+                        (result.largeGraphProfile && (proposal.x != 40 || proposal.y != 40))) {
+                        graph.processAndGenerateGraph(false, true, true, true);
+                        graph.sortNodesByYThenXCoordinate(proposal.x, proposal.y);
+                        router.setMaxSearchCost(routingCost(*proposal.parse, graph));
+                    }
+                    routed = graph.routeGraphvizSeedAnisotropic(options.phaseCount,
+                        proposal.x, proposal.y, 12, 4);
+                } else {
+                    if (proposal.action == Action::Elastic) {
+                        graph.processAndGenerateGraph(false, true, true, true);
+                        graph.sortNodesByElasticLayeredGrid(proposal.x, proposal.y, 4, 4);
+                    } else {
+                        graph.sortNodesByFixedLayerOrder(orderedLayers(*proposal.parse, proposal.orderVariant),
+                                                        proposal.x, proposal.y, 4, 4);
+                    }
+                    if (proposal.horizontal)
+                        for (auto& node : graph.nodeIndex_pos) std::swap(node.second.first, node.second.second);
+                    if (result.largeGraphProfile) router.setMaxSearchCost(routingCost(*proposal.parse, graph));
+                    routed = graph.routeGraphPlacement(options.phaseCount);
+                }
+                collectDiagnostics();
+                message("routing", routed ? "completed route and coupled clock closure" :
+                    "route/clock closure failed; observed conflicts=" + std::to_string(diagnostics.routingConflicts), routed);
+                if (routed) {
+                    // Clock closure participates in routing acceptance so a
+                    // rejected clock assignment can change route order. The
+                    // clock agent independently checks its global result.
+                    const bool clockValid = graph.validateAssignedRoutePhases(options.phaseCount, 4);
+                    message("clock", clockValid ? "global epochs and gate phase boundaries verified" :
+                            "global clock constraint rejection; request another geometry", clockValid);
+                    if (clockValid) attempt.metrics = validateCombinationalLayout(*proposal.parse, graph, options.phaseCount, 4);
+                    else attempt.metrics.error = "Global clock validation failed";
+                    attempt.valid = attempt.metrics.valid;
+                    attempt.error = attempt.metrics.error;
+                } else attempt.error = cancelled() ? "Proposal time slice exhausted" : "No legal routed clock assignment";
+            } catch (const std::exception& error) {
+                attempt.error = error.what();
+                collectDiagnostics();
+                message("routing", attempt.error);
+            }
+
+            bool improved = false;
+            if (attempt.valid) {
+                auto candidate = capture(graph, board, attempt.metrics);
+                improved = !result.success || score(attempt.metrics) < score(result.metrics);
+                if (improved) {
+                    result.success = true;
+                    result.selectedSeed = proposal.name;
+                    result.parse = proposal.parse;
+                    result.metrics = attempt.metrics;
+                    result.layout = candidate;
+                    ++updates;
+                }
+                // A rejected/stagnant proposal cannot mutate a parent's
+                // graph or board. Distinct basins survive for future agents.
+                const bool duplicate = std::any_of(beam.begin(), beam.end(), [&](const Contender& entry) {
+                    return entry.parse == proposal.parse && entry.layout.nodePositions == candidate.nodePositions &&
+                           entry.layout.routes == candidate.routes;
+                });
+                if (controls.feedbackEnabled && !duplicate) {
+                    beam.push_back({proposal.name, proposal.parse, candidate, attempt.metrics, 0});
+                    std::stable_sort(beam.begin(), beam.end(), [](const Contender& a, const Contender& b) {
+                        return score(a.metrics) < score(b.metrics);
+                    });
+                    if (beam.size() > 4) beam.pop_back();
+                }
+                if (options.onCandidate) {
+                    try { options.onCandidate(*proposal.parse, candidate, attempt.metrics, proposal.name); }
+                    catch (...) { observerFailure = std::current_exception(); }
+                }
+            } else if (controls.feedbackEnabled && proposal.parent.empty() && !graph.nodeIndex_pos.empty()) {
+                // Only fresh seeds need expansion. Retain the actual failed
+                // geometry, not just its name; the routing agent's feedback
+                // becomes the placement agent's next capacity-cut proposal.
+                Proposal repair;
+                repair.action = Action::Repair;
+                repair.name = "capacity_repair";
+                repair.parent = proposal.name;
+                repair.parse = proposal.parse;
+                repair.input.nodePositions = graph.nodeIndex_pos;
+                repair.retainedCoverage = diagnostics.edgeCount
+                    ? static_cast<double>(diagnostics.routedEdges) / diagnostics.edgeCount : 0.0;
+                repair.failedArea = diagnostics.width * diagnostics.height;
+                repair.feedback = "failed shared placement: " + attempt.error +
+                    "; insert rows/columns at routing pressure before retrying";
+                repairs.push_back(std::move(repair));
+                std::stable_sort(repairs.begin(), repairs.end(), [](const Proposal& left, const Proposal& right) {
+                    if (left.retainedCoverage != right.retainedCoverage)
+                        return left.retainedCoverage > right.retainedCoverage;
+                    return left.failedArea < right.failedArea;
+                });
+                if (repairs.size() > 4) repairs.pop_back();
+            }
+            diagnostics.reason = attempt.valid ? "validated legal candidate" : attempt.error;
+            lastProposal = diagnostics;
+            message("validation", attempt.valid ? (improved ? "accepted best legal objective" :
+                "legal alternative; incumbent objective retained") : attempt.error,
+                attempt.valid, improved, attempt.metrics);
+            attempt.elapsedSeconds = std::chrono::duration<double>(Clock::now() - attemptStarted).count();
+            if (!proposal.parent.empty()) feedbackSeconds += attempt.elapsedSeconds;
+            attempt.budgetExpired = cancelled();
+            result.attempts.push_back(std::move(attempt));
+            if (observerFailure) std::rethrow_exception(observerFailure);
+            if (progress) {
+                GraphDrawSearchProgress event;
+                event.attempt = index + 1;
+                event.attemptLimit = options.maxAttempts;
+                event.bestUpdates = updates;
+                event.improved = improved;
+                event.refining = !proposal.parent.empty();
+                event.best = result.success ? &result.layout : nullptr;
+                event.message = "Multi-agent " + proposal.name + ": " +
+                    (improved ? "accepted smaller DRC-clean layout" :
+                     result.attempts.back().valid ? "incumbent retained" : result.attempts.back().error);
+                progress(event);
+            }
+        }
+    } catch (const std::exception& error) { result.error = error.what(); }
+    if (observerFailure) std::rethrow_exception(observerFailure);
+    if (policyFailure) std::rethrow_exception(policyFailure);
+    result.elapsedSeconds = elapsed();
+    result.budgetExpired = expired();
+    if (result.success) result.error.clear();
+    else if (result.error.empty()) result.error = "No multi-agent proposal passed routing, global clock and physical mapping validation";
+    return result;
+}
+} // namespace fcngraph
