+"""Run native cooperative P&R with bounded, tool-free Pi specialist decisions.
+
+Usage: PYTHONPATH=src/python python -m ifcn.multi_agent --input circuit.v
+       --binary build-multi-agent/ifcn_combinational_pnr --output-dir output/run
+       --fcnpilot-root ../FCNPilot
+"""
+from __future__ import annotations
+
+import argparse
+from datetime import datetime, timezone
+import hashlib
+import json
+import math
+import os
+from pathlib import Path
+import selectors
+import shutil
+import signal
+import subprocess
+import sys
+import time
+
+from ifcn import REPOSITORY_ROOT
+from ifcn.frontend import normalize_verilog
+from ifcn.layout_validation import dag_from_candidate, export_native_ifcn, validate_candidate
+from ifcn.verify_logic import verify_bytes
+
+ROLES = ("placement", "routing", "clock", "validation")
+ACTIONS = frozenset(("explore", "graphviz", "elastic", "ordered", "repair", "compact", "reroute"))
+REQUEST_PREFIX = b"IFCN_AGENT_REQUEST "
+MAX_REQUEST_BYTES = 1024 * 1024
+ERROR_CODES = frozenset(("invalid_input", "model_configuration", "model_unavailable", "invalid_response",
+                        "timeout", "provider_error", "adapter_failed", "adapter_timeout", "adapter_unavailable"))
+SCOPE = ("Native mapping acceptance plus independent route/global-clock DRC and exhaustive original-source "
+         "versus routed-DAG truth up to 11 inputs, or optional SAT equivalence for larger interfaces. "
+         "Physical waveforms, energy and throughput are not tested. "
+         "LLMs choose bounded native search actions; they cannot certify or modify a candidate directly.")
+
+
+def write_json(path, value):
+    temporary = path.with_suffix(path.suffix + ".tmp")
+    temporary.write_text(json.dumps(value, indent=2, ensure_ascii=False, allow_nan=False) + "\n")
+    temporary.replace(path)
+
+
+def sha256(path):
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def parse_json(text):
+    def reject(value):
+        raise ValueError("Nonfinite JSON value")
+    def number(value):
+        parsed = float(value)
+        if not math.isfinite(parsed):
+            raise ValueError("Nonfinite JSON value")
+        return parsed
+    return json.loads(text, parse_constant=reject, parse_float=number)
+
+
+def stop_process(process):
+    """Stop the whole isolated process group, including a timed-out transport."""
+    try:
+        os.killpg(process.pid, signal.SIGTERM)
+    except ProcessLookupError:
+        pass
+    try:
+        process.wait(timeout=0.25)
+    except subprocess.TimeoutExpired:
+        pass
+    # A completed leader can leave descendants that ignored TERM. Kill its
+    # process group even when wait() already returned, then reap our child.
+    try:
+        os.killpg(process.pid, signal.SIGKILL)
+    except ProcessLookupError:
+        pass
+    process.wait(timeout=1)
+
+
+def close_stdin(stream):
+    # A failed reply flush can leave bytes buffered. Closing the stream then
+    # retries that flush after native has exited; preserve its result/telemetry.
+    if stream is not None:
+        try:
+            stream.close()
+        except BrokenPipeError:
+            pass
+
+
+def safe_model_result(value, role, actions):
+    """Keep a bounded audit allowlist; never preserve provider error bodies."""
+    if not isinstance(value, dict) or value.get("schema") != "ifcn.agent_model_result.v1":
+        raise ValueError("Invalid adapter result")
+    result = {"status": "error", "provider": None, "model": None, "usage": None,
+              "model_call_started": value.get("model_call_started") is True, "decision": None,
+              "error": "invalid_response", "response_sha256": None}
+    for key in ("provider", "model"):
+        text = value.get(key)
+        if isinstance(text, str) and 0 < len(text) <= 200 and not any(ord(char) < 32 for char in text):
+            result[key] = text
+    digest = value.get("response_sha256")
+    if isinstance(digest, str) and len(digest) == 64 and all(char in "0123456789abcdef" for char in digest):
+        result["response_sha256"] = digest
+    usage = value.get("usage")
+    if isinstance(usage, dict):
+        result["usage"] = {key: usage[key] for key in ("input", "output", "cacheRead", "cacheWrite", "reasoning", "totalTokens")
+                           if isinstance(usage.get(key), (int, float)) and not isinstance(usage[key], bool)
+                           and math.isfinite(usage[key]) and usage[key] >= 0}
+    if value.get("status") != "ok":
+        error = value.get("error")
+        code = error.get("code") if isinstance(error, dict) else None
+        result["error"] = code if code in ERROR_CODES else "provider_error"
+        return result
+    decision = value.get("decision")
+    if (value.get("role") != role or value.get("tools_enabled") != [] or not result["model_call_started"]
+            or not result["provider"] or not result["model"] or not isinstance(decision, dict)
+            or set(decision) != {"schema", "action", "rationale"}
+            or decision.get("schema") != "ifcn.agent_decision.v1"
+            or decision.get("action") not in actions or decision.get("action") not in ACTIONS
+            or not isinstance(decision.get("rationale"), str) or not 0 < len(decision["rationale"]) <= 500):
+        return result
+    result.update(status="ok", decision=decision, error=None)
+    return result
+
+
+def call_model(args, context, role, previous, timeout):
+    started = time.monotonic()
+    request = {"schema": "ifcn.agent_model_request.v1", "role": role, "context": context,
+               "previous_decisions": previous[-4:], "fcnpilot_root": str(args.fcnpilot_root),
+               "max_tokens": args.max_model_tokens, "timeout_ms": max(1, int((timeout - min(0.2, timeout / 10)) * 1000))}
+    if args.model is not None:
+        provider, model_id = args.model.split("/", 1)
+        request["model"] = {"provider": provider, "modelId": model_id}
+    fallback = {"status": "error", "provider": None, "model": None, "usage": None,
+                "model_call_started": False, "decision": None, "error": "adapter_failed"}
+    process = None
+    try:
+        process = subprocess.Popen([args.node, str(args.model_adapter)], stdin=subprocess.PIPE,
+                                   stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, start_new_session=True)
+        stdout, _ = process.communicate(json.dumps(request, allow_nan=False).encode(), timeout=timeout)
+        if len(stdout) > 65536:
+            raise ValueError("Oversized adapter result")
+        result = safe_model_result(parse_json(stdout), role, context["available_actions"])
+        if process.returncode != 0 and result["status"] == "ok":
+            raise ValueError("Adapter failed after a success response")
+    except subprocess.TimeoutExpired:
+        stop_process(process)
+        result = {**fallback, "error": "adapter_timeout"}
+    except OSError:
+        result = {**fallback, "error": "adapter_unavailable"}
+    except (ValueError, TypeError, UnicodeError):
+        result = {**fallback, "error": "invalid_response"}
+    finally:
+        if process is not None:
+            stop_process(process)
+            close_stdin(process.stdin)
+            if process.stdout:
+                process.stdout.close()
+    result["latency_seconds"] = round(time.monotonic() - started, 6)
+    return result
+
+
+def native_search(args, output, native_budget, summary):
+    deadline = time.monotonic() + args.budget
+    reserve = args.budget - native_budget
+    command = [str(args.binary), "multi_agent", str(output / "normalized.v"), str(output / "candidate.json"),
+               "--budget", str(native_budget), "--attempts", str(args.attempts), "--agent-control"]
+    if getattr(args, "max_nodes", None) is not None:
+        command += ["--max-nodes", str(args.max_nodes)]
+    summary["native_command"] = command
+    summary["native_solver_budget_seconds"] = native_budget
+    decisions = []
+    attempts = 0
+    timed_out = False
+    process = None
+    buffer = b""
+    with (output / "native.log").open("wb") as log, selectors.DefaultSelector() as selector:
+        try:
+            process = subprocess.Popen(command, cwd=output, stdin=subprocess.PIPE, stdout=subprocess.PIPE,
+                                       stderr=log, start_new_session=True)
+            selector.register(process.stdout, selectors.EVENT_READ)
+
+            def handle(line):
+                nonlocal attempts
+                if not line.startswith(REQUEST_PREFIX):
+                    log.write(line + b"\n")
+                    log.flush()
+                    return
+                entry = {"request_index": len(decisions) + 1, "role": None, "status": "fallback",
+                         "action": None, "native_response": "all", "error": None}
+                context = None
+                try:
+                    context = parse_json(line[len(REQUEST_PREFIX):])
+                    if (not isinstance(context, dict) or context.get("schema") != "ifcn.agent_control.v1"
+                            or not isinstance(context.get("available_actions"), list)
+                            or not context["available_actions"] or any(action not in ACTIONS for action in context["available_actions"])):
+                        raise ValueError("Unsupported native request")
+                    entry["context"] = context
+                    entry["action"] = context.get("suggested_action")
+                    if context.get("attempt", 0) <= 1 or not (context.get("has_incumbent") or context.get("last_feedback")):
+                        entry["error"] = "initial_native_seed"
+                    elif attempts >= args.max_model_calls:
+                        entry["error"] = "model_call_limit"
+                    else:
+                        remaining = deadline - time.monotonic() - reserve
+                        native_remaining = context.get("remaining_seconds", remaining)
+                        if not isinstance(native_remaining, (int, float)) or not math.isfinite(native_remaining):
+                            raise ValueError("Invalid native time budget")
+                        # Native control has a 30-second read deadline. Leave
+                        # room to terminate an unresponsive model transport.
+                        timeout = min(args.model_timeout, 29.0, remaining - 0.1, native_remaining - 0.1)
+                        if timeout < 0.25:
+                            entry["error"] = "insufficient_time"
+                        else:
+                            role = ROLES[attempts % len(ROLES)]
+                            attempts += 1  # Errors/timeouts consume the same bounded call allowance.
+                            entry.update(role=role, model_call_attempt=attempts, call_timeout_seconds=timeout)
+                            previous = [{key: decision.get(key) for key in ("role", "status", "action", "error")}
+                                        for decision in decisions if decision.get("role")]
+                            result = call_model(args, context, role, previous, timeout)
+                            entry.update(result)
+                            if result["status"] == "ok":
+                                entry.update(status="model_selected", action=result["decision"]["action"],
+                                             native_response=result["decision"]["action"])
+                            else:
+                                entry["status"] = "fallback"
+                except (ValueError, TypeError, UnicodeError):
+                    entry["error"] = "invalid_native_request"
+                decisions.append(entry)
+                summary["decisions"] = decisions
+                summary["model_call_attempts"] = attempts
+                write_json(output / "agent_decisions.json", decisions)
+                print(json.dumps({key: entry.get(key) for key in
+                    ("request_index", "role", "status", "action", "provider", "model", "error", "latency_seconds")}), flush=True)
+                try:
+                    process.stdin.write(("IFCN_AGENT_RESPONSE " + entry["native_response"] + "\n").encode())
+                    process.stdin.flush()
+                except BrokenPipeError:
+                    pass
+
+            while selector.get_map():
+                remaining = deadline - time.monotonic()
+                if remaining <= 0:
+                    timed_out = True
+                    stop_process(process)
+                    break
+                ready = selector.select(min(remaining, 0.2))
+                if not ready:
+                    continue
+                chunk = os.read(process.stdout.fileno(), 65536)
+                if not chunk:
+                    selector.unregister(process.stdout)
+                    if buffer:
+                        handle(buffer)
+                        buffer = b""
+                    break
+                buffer += chunk
+                while b"\n" in buffer:
+                    line, buffer = buffer.split(b"\n", 1)
+                    if len(line) > MAX_REQUEST_BYTES:
+                        raise ValueError("Native output line exceeds protocol limit")
+                    handle(line)
+                if len(buffer) > MAX_REQUEST_BYTES:
+                    raise ValueError("Native output line exceeds protocol limit")
+            if not timed_out:
+                remaining = deadline - time.monotonic()
+                if remaining <= 0:
+                    timed_out = True
+                    stop_process(process)
+                else:
+                    try:
+                        process.wait(timeout=remaining)
+                    except subprocess.TimeoutExpired:
+                        timed_out = True
+                        stop_process(process)
+            summary["native_exit_code"] = process.returncode
+        finally:
+            if process is not None:
+                stop_process(process)
+                close_stdin(process.stdin)
+                if process.stdout:
+                    process.stdout.close()
+    summary["native_timed_out"] = timed_out
+    summary["model_call_attempts"] = attempts
+    summary["model_decisions_accepted"] = sum(entry["status"] == "model_selected" for entry in decisions)
+    summary["model_calls_started_reported"] = sum(entry.get("model_call_started") is True for entry in decisions)
+    summary["decisions"] = decisions
+    write_json(output / "agent_decisions.json", decisions)
+    return not timed_out and summary["native_exit_code"] == 0
+
+
+def reconcile_applied_decisions(summary, candidate):
+    """A model response counts as applied only with matching native evidence."""
+    native = candidate.get("multi_agent", {})
+    controls = native.get("control_events", [])
+    events = native.get("events", [])
+    for decision in summary["decisions"]:
+        attempt = decision.get("context", {}).get("attempt")
+        selected = any(event.get("attempt") == attempt and event.get("status") == "selected"
+                       and event.get("action") == decision.get("action") for event in controls)
+        executed = any(event.get("attempt") == attempt and event.get("actor") == "placement" for event in events)
+        decision["native_applied"] = decision["status"] == "model_selected" and selected and executed
+    summary["model_decisions_applied"] = sum(decision["native_applied"] for decision in summary["decisions"])
+    summary["model_used"] = summary["model_decisions_applied"] > 0
+    summary["completion_mode"] = "model_guided" if summary["model_used"] else "deterministic_fallback"
+
+
+def run(args):
+    output = args.output_dir
+    output.mkdir(parents=True, exist_ok=True)
+    started = time.monotonic()
+    summary = {"schema": "ifcn.llm_multi_agent_run.v1", "created_at": datetime.now(timezone.utc).isoformat(),
+               "status": "running", "algorithm": "multi_agent", "coordination": "pi_llm_native_action_control",
+               "roles": ROLES, "budget_seconds": args.budget, "attempt_limit": args.attempts,
+               "max_model_calls": args.max_model_calls, "model_timeout_seconds": args.model_timeout,
+               "max_model_tokens": args.max_model_tokens, "requested_model": args.model,
+               "model_configuration": "external FCNPilot/Pi configuration; credentials are neither copied nor logged",
+               "scope": SCOPE, "physical_waveform_status": "not_run", "layout_validated": False,
+               "source": str(args.input), "binary": str(args.binary), "fcnpilot_root": str(args.fcnpilot_root),
+               "model_adapter": str(args.model_adapter), "decisions": [], "error": None}
+    try:
+        source = args.input.read_bytes()
+        (output / "source.v").write_bytes(source)
+        normalized, frontend = normalize_verilog(source.decode("utf-8-sig"))
+        (output / "normalized.v").write_text(normalized)
+        summary.update(source_sha256=sha256(output / "source.v"), normalized_sha256=sha256(output / "normalized.v"),
+                       binary_sha256=sha256(args.binary), model_adapter_sha256=sha256(args.model_adapter), frontend=frontend)
+        native_budget = args.budget - min(2.0, args.budget * 0.1)
+        write_json(output / "summary.json", summary)
+        native_success = native_search(args, output, native_budget, summary)
+        candidate_path = output / "candidate.json"
+        try:
+            candidate_bytes = candidate_path.read_bytes()
+            summary["candidate_sha256"] = hashlib.sha256(candidate_bytes).hexdigest()
+            candidate = parse_json(candidate_bytes)
+            if (not isinstance(candidate, dict) or candidate.get("schema") != "ifcn.native_candidate.v1"
+                    or candidate.get("algorithm") != "multi_agent"):
+                raise ValueError("Invalid native candidate identity")
+            telemetry = candidate.get("multi_agent")
+            if (not isinstance(telemetry, dict) or any(
+                    not isinstance(telemetry.get(key), list)
+                    or any(not isinstance(event, dict) for event in telemetry[key])
+                    for key in ("events", "control_events"))):
+                raise ValueError("Missing or invalid native application evidence")
+            reconcile_applied_decisions(summary, candidate)
+            summary["candidate_audit_status"] = "available"
+        except (OSError, ValueError, TypeError, KeyError, UnicodeError) as error:
+            if native_success:
+                raise
+            # Missing/truncated evidence cannot change the process failure or
+            # establish whether a model choice actually reached native search.
+            summary.update(candidate_audit_status="unavailable",
+                           candidate_audit_error="local_" + type(error).__name__,
+                           model_decisions_applied=None, model_used=None,
+                           completion_mode="unverified_native_failure")
+            for decision in summary["decisions"]:
+                decision["native_applied"] = None
+        write_json(output / "agent_decisions.json", summary["decisions"])
+        if not native_success:
+            summary["status"] = "timeout" if summary.get("native_timed_out") else "native_failed"
+            return summary
+        if candidate.get("algorithm") != "multi_agent" or candidate.get("routed") is not True or candidate.get("native_mapping_valid") is not True:
+            summary.update(status="native_rejected", error="native_candidate_not_validated")
+            return summary
+        validation = validate_candidate(candidate, source_crossings=False)
+        write_json(output / "drc.json", validation)
+        if not validation["passed"]:
+            summary.update(status="drc_rejected", error="independent_route_or_clock_check_failed")
+            return summary
+        dag = dag_from_candidate(candidate, validation)
+        write_json(output / "routed_dag.json", dag)
+        dag_bytes = (output / "routed_dag.json").read_bytes()
+        logic = verify_bytes(source, dag_bytes, max_inputs=11)
+        if logic.get("reason_code") == "input_limit_exceeded":
+            from ifcn.verify_sat import verify_sat_bytes
+            logic = verify_sat_bytes(source, dag_bytes, z3_root=args.z3_root, timeout_seconds=args.logic_timeout)
+        write_json(output / "logic.json", logic)
+        summary.update(source_dag_status=logic["status"], vectors_checked=logic.get("vectors_checked", 0),
+                       logic_method=logic.get("method", "exhaustive_truth_table"))
+        if logic["status"] != "equivalent":
+            summary.update(status="logic_rejected", error="original_source_not_proven_equivalent")
+            return summary
+        width, height = export_native_ifcn(candidate, output / "layout.ifcn", "multi_agent")
+        summary.update(status="validated", layout_validated=True, width=width, height=height, area_tiles=width * height,
+                       route_length=sum(len(route["path"]) - 1 for route in candidate["routes"]),
+                       native_metrics=candidate.get("metrics"), native_seconds=candidate.get("run_time_s"),
+                       ifcn=str(output / "layout.ifcn"))
+    except (OSError, ValueError, TypeError, KeyError, UnicodeError) as error:
+        # Provider/SDK exceptions never reach here; local failures get stable categories only.
+        summary.update(status="error", error="local_" + type(error).__name__)
+    finally:
+        summary["elapsed_seconds"] = round(time.monotonic() - started, 6)
+        write_json(output / "summary.json", summary)
+    return summary
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--input", type=Path, required=True)
+    parser.add_argument("--binary", type=Path, default=REPOSITORY_ROOT / "build-multi-agent/ifcn_combinational_pnr")
+    parser.add_argument("--output-dir", type=Path, required=True, help="Fresh run directory; existing evidence is preserved")
+    parser.add_argument("--fcnpilot-root", type=Path, default=REPOSITORY_ROOT.parent / "FCNPilot")
+    parser.add_argument("--model", help="Existing Pi provider/model ID; otherwise use configured FCNPilot/Pi default")
+    parser.add_argument("--budget", type=float, default=90.0, help="Native wall-clock seconds including model waits")
+    parser.add_argument("--attempts", type=int, default=64)
+    parser.add_argument("--max-nodes", type=int, help="Disable any native candidate topology above this node count")
+    parser.add_argument("--max-model-calls", type=int, default=4, help="At most this many calls, including errors/timeouts; zero is offline")
+    parser.add_argument("--model-timeout", type=float, default=15.0)
+    parser.add_argument("--max-model-tokens", type=int, default=512)
+    parser.add_argument("--z3-root", type=Path, help="Optional existing Z3 extraction for SAT equivalence of >11-input circuits")
+    parser.add_argument("--logic-timeout", type=float, default=30.0, help="Independent SAT audit timeout after native search")
+    parser.add_argument("--node", default=shutil.which("node") or "node")
+    parser.add_argument("--model-adapter", type=Path, default=REPOSITORY_ROOT / "scripts/ifcn_multi_agent_model.mjs")
+    args = parser.parse_args(argv)
+    for name in ("input", "binary", "output_dir", "fcnpilot_root", "model_adapter"):
+        setattr(args, name, getattr(args, name).resolve())
+    if args.z3_root is not None:
+        args.z3_root = args.z3_root.resolve()
+    if (not math.isfinite(args.budget) or args.budget <= 0 or not math.isfinite(args.model_timeout)
+            or not 0 < args.model_timeout <= 300 or args.attempts < 1 or (args.max_nodes is not None and args.max_nodes < 1) or not 0 <= args.max_model_calls <= 64
+            or not 64 <= args.max_model_tokens <= 4096 or not math.isfinite(args.logic_timeout) or args.logic_timeout <= 0):
+        parser.error("Positive finite budgets/attempts, 0..64 model calls and 64..4096 model tokens are required")
+    if args.model is not None and ("/" not in args.model or not all(args.model.split("/", 1)) or len(args.model) > 401):
+        parser.error("model must be provider/model_id")
+    if not args.input.is_file() or not args.binary.is_file() or not os.access(args.binary, os.X_OK) or not args.model_adapter.is_file():
+        parser.error("input, executable binary and model-adapter must exist")
+    if args.output_dir.exists() and (not args.output_dir.is_dir() or any(args.output_dir.iterdir())):
+        parser.error("output-dir must be empty; existing artifacts are never overwritten")
+    summary = run(args)
+    print(json.dumps({key: summary.get(key) for key in ("status", "completion_mode", "area_tiles", "route_length",
+        "model_call_attempts", "model_decisions_accepted", "model_decisions_applied", "elapsed_seconds", "error")}), flush=True)
+    return 0 if summary["layout_validated"] else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
