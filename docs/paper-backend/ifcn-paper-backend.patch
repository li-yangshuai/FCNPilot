+    }
+    if (!parser) throw std::invalid_argument("baseline DAG identities, edges or layers differ from source");
+    auto& parse = *parser;
+    std::set<Edge> oldRouteEdges;
+    CircuitGraph::ProvidedRoutes suppliedRoutes;
+    for (const auto& value : baseline.at("routes").as_array()) {
+        const auto& route = value.as_object();
