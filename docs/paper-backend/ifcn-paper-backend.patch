+"""Contract checks for the cooperative solver's existing Python workflow."""
+import json
+from pathlib import Path
+import sys
+import tempfile
+from types import SimpleNamespace
+import unittest
+from unittest.mock import patch
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT / "src/python"))
+from ifcn import backend, workflow
+
+
+def candidate(algorithm="multi_agent"):
+    return {
+        "algorithm": algorithm, "routed": True, "native_mapping_valid": True,
+        "layers": [[0], [1]],
+        "nodes": [
+            {"id": 0, "name": "a", "type": "input", "is_input": True,
+             "is_output": False, "x": 0, "y": 0},
+            {"id": 1, "name": "y", "type": "not", "is_input": False,
+             "is_output": True, "x": 0, "y": 2}],
+        "edges": [[0, 1]],
+        "routes": [{"source": 0, "target": 1, "path": [[0, 0], [0, 1], [0, 2]]}],
+        "cells": [{"x": 0, "y": y, "phase": y + 1} for y in range(3)],
+        "multi_agent": {"events": [{"actor": "validation", "accepted": True}]},
+    }
+
+
+class MultiAgentBackendTests(unittest.TestCase):
+    def run_native(self, output, value, algorithm="multi_agent"):
+        calls = []
+
+        def native(command, **kwargs):
+            calls.append(command)
+            Path(command[3]).write_text(json.dumps(value))
+            return SimpleNamespace(returncode=0)
+
+        summary = {"algorithm": algorithm}
+        args = SimpleNamespace(algorithm=algorithm, input="input.v", budget=4)
+        with patch.object(backend, "native_binary", return_value=Path(sys.executable)), \
+                patch.object(backend.subprocess, "run", side_effect=native):
+            backend.run_native(args, output, summary)
+        return calls, summary
+
+    def test_dispatch_exports_algorithm_and_preserves_irregular_clock(self):
+        for algorithm in ("irregular", "multi_agent"):
+            with self.subTest(algorithm=algorithm), tempfile.TemporaryDirectory() as tmp:
+                out = Path(tmp)
+                value = candidate(algorithm)
+                calls, summary = self.run_native(out, value, algorithm)
+                self.assertEqual(calls[0][1], algorithm)
+                self.assertTrue(summary["validation"]["passed"])
+                self.assertEqual(summary["clock_scheme"], "irregular")
+                self.assertEqual(summary["area_tiles"], 3)
+                exported = (out / "layout.ifcn").read_text()
+                self.assertIn(f"#algorithm: {algorithm}", exported)
+                self.assertIn("#clock scheme: irregular", exported)
+                self.assertTrue((out / "routed_dag.json").is_file())
+                if algorithm == "multi_agent":
+                    self.assertEqual(summary["native_search"]["multi_agent"], value["multi_agent"])
+                else:
+                    self.assertNotIn("multi_agent", summary["native_search"])
+
+    def test_native_success_does_not_bypass_independent_clock_validation(self):
+        value = candidate()
+        value["cells"][1]["phase"] = 4
+        with tempfile.TemporaryDirectory() as tmp:
+            out = Path(tmp)
+            with self.assertRaisesRegex(RuntimeError, "multi_agent candidate failed validation"):
+                self.run_native(out, value)
+            self.assertFalse((out / "layout.ifcn").exists())
+            summary = json.loads((out / "pnr.json").read_text())
+            self.assertFalse(summary["layout_legal"])
+
+    def test_wrong_solver_result_is_rejected(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            out = Path(tmp)
+            with self.assertRaisesRegex(RuntimeError, "different algorithm"):
+                self.run_native(out, candidate("irregular"))
+            self.assertFalse((out / "layout.ifcn").exists())
+
+
+class MultiAgentWorkflowTests(unittest.TestCase):
+    def test_capabilities_expose_opt_in_solver_without_changing_auto_policy(self):
+        config = {"python": sys.executable, "native_pnr_binary": sys.executable}
+        available = {item["id"]: item for item in workflow.algorithm_capabilities(config)}
+        self.assertTrue(available["multi_agent"]["available"])
+        self.assertEqual(available["multi_agent"]["clock_scheme"], "irregular")
+        self.assertIn("multi_agent", backend.ALGORITHMS)
+        self.assertIn("multi_agent", workflow.ALGORITHMS)
+        self.assertEqual(workflow.AUTO_ALGORITHMS, ("normal_2ddwave", "irregular"))
+
+    def test_explicit_workflow_selects_and_validates_multi_agent_artifacts(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            root = Path(tmp)
+            out = root / "pnr"
+            out.mkdir()
+            source = "module m(input a, output y); assign y=~a; endmodule"
+            for name in ("source.v", "normalized.v"):
+                (root / name).write_text(source)
+            manifest = {
+                "configuration": {"python": sys.executable, "native_pnr_binary": sys.executable,
+                                  "backend": "fixture-backend", "energy_binary": "fixture-energy"},
+                "parameters": {"algorithm": "multi_agent", "timeout_s": 30, "seed": 1},
+                "artifacts": {name: {"path": name} for name in ("source.v", "normalized.v")},
+                "frontend": {"inputs": ["a"], "outputs": ["y"]},
+                "metrics": {}, "validation": {},
+            }
+            selected = []
+
+            def execute(command, path, step, state, timeout_s):
+                if command[0] == "fixture-energy":
+                    Path(str(command[2]) + "_energy_input.qca").write_text(
+                        "[TYPE:QCADCell]\ncell_function=QCAD_CELL_INPUT\n"
+                        "[TYPE:QCADCell]\ncell_function=QCAD_CELL_OUTPUT\n")
+                    return
+                algorithm = command[command.index("--algorithm") + 1]
+                selected.append(algorithm)
+                target = Path(command[command.index("--output") + 1])
+                value = candidate(algorithm)
+                validation = backend.validate_candidate(value)
+                backend.export_native_ifcn(value, target / "layout.ifcn", algorithm)
+                backend.write_json(target / "routed_dag.json", backend.dag_from_candidate(value, validation))
+                backend.write_json(target / "pnr.json", {
+                    "algorithm": algorithm, "layout_legal": True, "failed_edge_count": 0,
+                    "clock_legal": True, "clock_template_ok": None, "validation": validation,
+                    "ifcn": str(target / "layout.ifcn")})
+
+            with patch.object(workflow, "execute", side_effect=execute):
+                workflow.run_pnr(out, root, manifest)
+            self.assertEqual(selected, ["multi_agent"])
+            self.assertEqual(manifest["metrics"]["algorithm_selection"]["selected_algorithm"], "multi_agent")
+            self.assertEqual(manifest["validation"]["rtl_equivalence"], "exhaustive_scalar_source_vs_routed_dag")
+            self.assertIn("layout.ifcn", manifest["artifacts"])
+            self.assertIn("validated_device.qca", manifest["artifacts"])
+
+
+if __name__ == "__main__":
+    unittest.main()
