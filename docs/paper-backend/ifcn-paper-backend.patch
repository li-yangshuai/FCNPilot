+inline bool sameBound(const CombinationalClockBound &a, const CombinationalClockBound &b)
+{
+    return a.boundId == b.boundId && a.from == b.from && a.to == b.to &&
+           a.upper == b.upper && a.kind == b.kind && a.routeIndex == b.routeIndex &&
+           a.segmentBegin == b.segmentBegin && a.segmentEnd == b.segmentEnd;
+}
