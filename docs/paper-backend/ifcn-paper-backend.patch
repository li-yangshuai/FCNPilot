+import json
+import os
+from pathlib import Path
+import sys
+import unittest
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT / "src/python"))
+from ifcn.verify_sat import source_structure, verify_sat_bytes
+from ifcn.sequential.solve_global_clock_z3 import DEFAULT_Z3_ROOT, load_z3
+
+Z3_ROOT = Path(os.environ.get("IFCN_TEST_Z3_ROOT", str(DEFAULT_Z3_ROOT)))
+try:
+    load_z3(Z3_ROOT)
+    HAS_Z3 = True
+except RuntimeError:
+    HAS_Z3 = False
+
+
+def chain(count=32):
+    inputs = [f"a{i}" for i in range(count)]
+    gates = [f"w{i}" for i in range(count - 2)] + ["y"]
+    source = ("module m(" + ",".join(inputs + ["y"]) + "); input " + ",".join(inputs)
+              + "; output y; wire " + ",".join(gates[:-1]) + ";\n")
+    nodes = [{"id": i, "name": name, "type": "input", "is_input": True, "is_output": False}
+             for i, name in enumerate(inputs)]
+    edges = []
+    for index, gate in enumerate(gates):
+        left = "a0" if index == 0 else gates[index - 1]
+        source += f"assign {gate} = {left} & a{index + 1};\n"
+        nodes.append({"id": count + index, "name": gate, "type": "and", "is_input": False, "is_output": gate == "y"})
+        edges.extend([[0 if index == 0 else count + index - 1, count + index], [index + 1, count + index]])
+    return (source + "endmodule").encode(), {"schema": "ifcn.dag.v1", "nodes": nodes, "edges": edges,
+                                              "input_count": count, "output_count": 1}
+
+
+class StructureTests(unittest.TestCase):
+    def test_parse_large_source_without_truth_table(self):
+        source, _ = chain(64)
+        parsed = source_structure(source)
+        self.assertEqual(len(parsed["input_ports"]), 64)
+        self.assertEqual(len(parsed["order"]), 63)
+        self.assertNotIn("truth_table", parsed)
+
+    def test_ansi_and_constants_are_parsed_without_lowering(self):
+        parsed = source_structure(b"module m(input a,b, output y); assign y=(a ^ b) | 1'b0; endmodule")
+        self.assertEqual(parsed["input_ports"], ["a", "b"])
+        self.assertEqual(parsed["assignments"]["y"][0], "|")
+
+    def test_rejects_invalid_source(self):
+        for source in (b"module m(a,y); input a; output y; assign y=z; endmodule",
+                       b"module m(a,y); input a; output y; assign y=~y; endmodule",
+                       b"module m(a,y); input a; output y; assign a=y; endmodule",
+                       b"module m(a,y); input a; output y; assign y=a; assign y=~a; endmodule"):
+            with self.subTest(source=source), self.assertRaises(ValueError):
+                source_structure(source)
+
