+    def test_all_subpath_gate_boundaries_match_exhaustive_steps(self):
+        # Freeze exactly two contacts at a candidate epoch difference. A
+        # rejection must be equivalent to impossibility in the local binary
+        # advance system, including contact pairs away from both gates.
+        for length in range(1, 8):
+            for primary_input in (True, False):
+                path = [(x, 0) for x in range(length + 1)]
+                valid_steps = []
+                for steps in product((0, 1), repeat=length):
+                    if not steps[-1] or (not primary_input and not steps[0]):
+                        continue
+                    if any(not any(steps[k:k + 4]) for k in range(length - 3)):
+                        continue
+                    valid_steps.append(steps)
+                for start in range(length):
+                    for end in range(start + 1, length + 1):
+                        local_values = {sum(s[start:end]) for s in valid_steps}
+                        for advance in range(end - start + 2):
+                            contract = anchored_contract([path[start], path[end]], {0: 0, 1: advance})
+                            rejected = clock_repair.ContactWindows(contract).reject(path, primary_input)
+                            with self.subTest(length=length, primary_input=primary_input,
+                                              start=start, end=end, advance=advance):
+                                self.assertEqual(rejected is None, advance in local_values)
