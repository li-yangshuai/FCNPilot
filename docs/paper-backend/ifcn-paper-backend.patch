+"""Budgeted model policies for concrete clock-contract repair actions.
+
+The action executor supplies one immutable slate and the same public evidence
+to all policies. Models select a tool-generated action; they neither modify its
+payload nor certify it. Three calls vote under a common aggregation rule. Only
+the role schedule and visibility of current-decision messages differ.
+"""
+from __future__ import annotations
+
+from collections import Counter
+from copy import deepcopy
+import math
+import time
+
+from .cooperation import digest, model_choice
+
+CONDITIONS = ("llm_single", "llm_independent", "llm_negotiated")
+ROLE_SCHEDULES = {
+    "llm_single": ("planner", "planner", "planner"),
+    "llm_independent": ("clock", "routing", "planner"),
+    "llm_negotiated": ("clock", "routing", "planner"),
+}
+USAGE_KEYS = ("input", "output", "cacheRead", "cacheWrite", "reasoning", "totalTokens")
+
+
+def _identifier(value):
+    return (isinstance(value, str) and 0 < len(value) <= 160 and value == value.strip()
+            and not any(ord(c) < 32 or ord(c) == 127 for c in value))
+
+
+def _valid_result(result, snapshot_id, role, option_ids):
+    if not isinstance(result, dict):
+        return False
+    decision = result.get("decision")
+    return (result.get("schema") == "ifcn.cooperation_model_result.v1"
+            and result.get("status") == "ok" and result.get("model_call_started") is True
+            and result.get("tools_enabled") == [] and isinstance(decision, dict)
+            and set(decision) == {"schema", "snapshot_id", "role", "option_id", "rationale"}
+            and decision.get("schema") == "ifcn.cooperation_decision.v1"
+            and decision.get("snapshot_id") == snapshot_id and decision.get("role") == role
+            and decision.get("option_id") in option_ids
+            and isinstance(decision.get("rationale"), str)
+            and 0 < len(decision["rationale"]) <= 500 and bool(decision["rationale"].strip()))
+
+
+def select_repair_action(condition, snapshot_id, options, context, model_config,
+                         *, history=None, deadline=None):
+    """Select a release query or explicit path bundle from a common slate.
+
+    ``max_calls`` in model_config is the *remaining run allowance*, charged
+    conservatively for every adapter attempt, including failures. At most three
+    calls are made here; the caller subtracts ``trace['model_calls']`` before
+    the next decision. ``deadline`` is an absolute ``time.monotonic()`` value.
+
+    ``history`` contains public native execution feedback shared with every
+    policy, not earlier private model discussion. The independent policy gets
+    no prior model messages. A single planner gets its own current-decision
+    messages, and the negotiated policy gets its peers' messages. Every vote
+    contributes through plurality; ties follow the original action order.
+    """
+    if condition not in CONDITIONS:
+        raise ValueError("Unknown repair model policy")
+    if not _identifier(snapshot_id) or not isinstance(context, dict):
+        raise ValueError("A bounded snapshot identifier and evidence object are required")
+    if not isinstance(options, (list, tuple)) or not 1 <= len(options) <= 64:
+        raise ValueError("One to 64 concrete action options are required")
+    slate = deepcopy(list(options))
+    ids = [o.get("option_id") if isinstance(o, dict) else None for o in slate]
+    if any(not _identifier(i) for i in ids) or len(set(ids)) != len(ids):
+        raise ValueError("Action identifiers must be unique and bounded")
+    if not isinstance(model_config, dict):
+        raise ValueError("An explicit model configuration is required")
+    remaining = model_config.get("max_calls", 3)
+    if type(remaining) is not int or remaining < 0:
+        raise ValueError("Remaining model call allowance must be a nonnegative integer")
+    timeout = model_config.get("timeout_seconds", 20.0)
+    if isinstance(timeout, bool) or not isinstance(timeout, (int, float)) or not math.isfinite(timeout) or timeout <= 0:
+        raise ValueError("Model timeout must be positive and finite")
+    if deadline is not None and (isinstance(deadline, bool) or not isinstance(deadline, (int, float))
+                                 or not math.isfinite(deadline)):
+        raise ValueError("Deadline must be a finite monotonic timestamp")
+    if history is not None and not isinstance(history, (list, tuple)):
+        raise ValueError("Shared execution history must be a sequence")
+    evidence = deepcopy(context)
+    # model_choice owns the actual options field; prevent a stale caller field
+    # from confusing the recorded context hash or the audit of equal evidence.
+    evidence.pop("options", None)
+    evidence["execution_history"] = deepcopy(list(history or [])[-12:])
+    evidence["selection_protocol"] = {
+        "objective": "Select the offered exact repair action most likely to produce a legal repair within the stated budgets.",
+        "aggregation": "Three proposals use plurality voting; ties follow the original option order.",
+        "message_rule": "If prior messages are supplied, consider their concrete constraints and revise a proposal when justified. They are not feasibility certificates.",
+        "authority": "Only the native executor and independent verification can accept a repair; an action may request a new conditional contract rather than evaluate a path.",
+    }
+    options_hash = digest(slate)
+    context_hash = digest(evidence)
+    # Digest also rejects non-JSON data and NaN before making any network call.
+    started = time.monotonic()
+    calls, votes, messages = [], [], []
+    usage = {key: 0 for key in USAGE_KEYS}
+    reason = "completed"
+    allowance = min(3, remaining)
+    if len(slate) == 1:
+        allowance, reason = 0, "single_available_action"
+    elif remaining == 0:
+        reason = "model_budget_exhausted"
+    for index, role in enumerate(ROLE_SCHEDULES[condition][:allowance], 1):
+        seconds = timeout if deadline is None else min(timeout, deadline - time.monotonic())
+        if seconds <= 0:
+            reason = "wall_budget_exhausted"
+            break
+        prior = [] if condition == "llm_independent" else deepcopy(messages)
+        result = model_choice(model_config, role, snapshot_id, deepcopy(slate),
+                              deepcopy(evidence), prior, seconds)
+        # A parent-side transport failure does not tell us whether its child
+        # had already started the provider request. The adapter's initialized
+        # False is not an observed zero-call outcome when no adapter response
+        # arrived. Preserve explicit pre-provider failures from a completed,
+        # schema-tagged adapter response; mark only unobserved starts unknown.
+        error = result.get("error") if isinstance(result, dict) else None
+        if (isinstance(result, dict) and result.get("model_call_started") is False
+                and isinstance(error, dict) and error.get("code") in ("adapter_timeout", "adapter_failed")
+                and result.get("schema") != "ifcn.cooperation_model_result.v1"):
+            result = deepcopy(result)
+            result["model_call_started"] = None
+            result["accounting_note"] = "Provider call start is unknown after parent-side adapter failure; missing usage is not zero usage."
+        valid = _valid_result(result, snapshot_id, role, set(ids))
+        if not isinstance(result, dict):
+            result = {"status": "error", "error": {"code": "invalid_result"},
+                      "model_call_started": False}
+        decision = result["decision"] if valid else None
+        option_id = decision["option_id"] if valid else ids[0]
+        rationale = decision["rationale"] if valid else "Deterministic first-option fallback after an invalid or failed model response."
+        visible = prior[-1].get("option_id") if prior else None
+        message = {"snapshot_id": snapshot_id, "role": role, "option_id": option_id,
+                   "rationale": rationale, "source": "model" if valid else "deterministic_fallback"}
+        calls.append({"call_index": index, "role": role, "snapshot_id": snapshot_id,
+                      "options_sha256": options_hash, "context_sha256": context_hash,
+                      "option_ids": list(ids), "prior_messages": deepcopy(prior),
+                      "response": deepcopy(result), "valid": valid, "fallback": not valid,
+                      "option_id": option_id, "visible_previous_option": visible,
+                      "changed_from_visible_proposal": visible is not None and option_id != visible,
+                      "timeout_seconds": seconds})
+        votes.append(option_id)
+        messages.append(message)
+        record_usage = result.get("usage")
+        if isinstance(record_usage, dict):
+            for key in USAGE_KEYS:
+                value = record_usage.get(key)
+                if type(value) in (int, float) and math.isfinite(value) and value >= 0:
+                    usage[key] += value
+    if len(calls) == allowance and allowance < 3 and len(slate) > 1 and reason == "completed":
+        reason = "model_budget_exhausted"
+    counts = Counter(votes)
+    selected = min(ids, key=lambda option: (-counts[option], ids.index(option)))
+    trace = {
+        "schema": "ifcn.clock_repair_policy.v1", "condition": condition,
+        "snapshot_id": snapshot_id, "action_kind": context.get("action_kind"),
+        "options_sha256": options_hash, "context_sha256": context_hash,
+        "option_ids": ids, "context": evidence, "options": slate,
+        "max_calls_remaining_at_start": remaining, "decision_call_allowance": allowance,
+        "model_calls": len(calls), "provider_calls_started": sum(c["response"].get("model_call_started") is True for c in calls),
+        "actual_model_calls": sum(c["response"].get("model_call_started") is True for c in calls),
+        "unknown_model_calls": sum(c["response"].get("model_call_started") is None for c in calls),
+        "valid_responses": sum(c["valid"] for c in calls), "fallbacks": sum(c["fallback"] for c in calls),
+        "usage": usage, "seconds": time.monotonic() - started,
+        "reported_model_seconds": sum(c["response"].get("elapsed_seconds", 0) or 0 for c in calls),
+        "calls": calls, "messages": messages, "votes": dict(counts),
+        "selected_option_id": selected, "selected_by_rule": "plurality_then_original_option_order",
+        "disagreement": len(counts) > 1,
+        "visible_proposal_revisions": sum(c["changed_from_visible_proposal"] for c in calls),
+        "termination_reason": reason,
+        "scope": "Common concrete actions and tool evidence; only role specialization and message visibility differ. Selection does not certify feasibility.",
+    }
+    return selected, trace
+
+
+# The path-specific name remains available to callers using only path actions.
+select_path_option = select_repair_action
