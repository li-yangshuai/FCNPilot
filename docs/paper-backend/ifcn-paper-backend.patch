+        requested[id] = {exactInteger(operation.at("x"), 0, 4095), exactInteger(operation.at("y"), 0, 4095)};
+    }
+    std::set<position> occupied;
+    for (const auto& node : requested)
+        if (!occupied.insert(node.second).second) throw std::invalid_argument("joint moves contain a node collision");
+    std::vector<Edge> order;
+    std::set<Edge> orderSet;
+    const auto& requestedEdges = contractMode ? proposal.at("release_edges").as_array() : proposal.at("routing_order").as_array();
+    for (const auto& value : requestedEdges) {
+        const auto& pair = value.as_array();
+        if (pair.size() != 2) throw std::invalid_argument("malformed routing order edge");
+        const Edge edge{exactInteger(pair[0], 0, 1000000), exactInteger(pair[1], 0, 1000000)};
+        if (!declaredEdges.count(edge) || !orderSet.insert(edge).second)
+            throw std::invalid_argument("unknown or duplicate routing order edge");
+        order.push_back(edge);
+    }
+    if (contractMode) {
+        if (order.empty() || order.size() > 3) throw std::invalid_argument("release_edges requires 1..3 unique effective edges");
+    } else if (orderSet != declaredEdges) throw std::invalid_argument("routing order must include every edge exactly once");
+    std::set<Edge> replacedEdges, changedEdges;
+    if (replacementMode) {
+        const auto& replacements = proposal.at("route_replacements").as_array();
+        if (replacements.empty() || replacements.size() > 3)
+            throw std::invalid_argument("route_replacements requires 1..3 unique effective edges");
+        for (const auto& value : replacements) {
+            const auto& route = value.as_object();
