+                if (index && std::abs(static_cast<long long>(point.first) - path[index - 1].first) +
+                    std::abs(static_cast<long long>(point.second) - path[index - 1].second) != 1)
+                    return fail("provided route is not four-connected");
+                if (index && index + 1 < path.size() && nodeCells.count(point))
+                    return fail("provided route traverses an intermediate gate");
+                routeSources[point].insert(edge.first);
+            }
+            links[{path.front(), parse.getNodeType(edge.first)}].second.push_back(path[1]);
+            links[{path.back(), parse.getNodeType(edge.second)}].first.push_back(path[path.size() - 2]);
+            geometry.push_back(path);
+        }
+        for (const auto& usage : routeSources) {
+            if (cancellationRequested()) return fail("provided-route validation cancelled");
+            if (nodeCells.count(usage.first)) continue;
+            if (usage.second.size() > 2) return fail("more than two source trees share a tile");
+            for (std::size_t count = 0; count < usage.second.size(); ++count) {
+                if (!chessboard.is_addWire(usage.first)) return fail("provided routes exceed tile capacity");
+                chessboard.addWire(usage.first);
+            }
+        }
