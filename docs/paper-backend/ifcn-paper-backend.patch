+                                 evaluation={"status": "routing_failed"})
+            candidate["evaluation"]["snapshot_id"] = "wrong-parent" if stale else proposal["snapshot_id"]
+            cooperation.write_json(Path(command[5]), candidate)
+            return subprocess.CompletedProcess(command, 0 if len(observed) > 1 else 1,
+                                               stdout=b"", stderr=b"")
+        # Supply a fixed partial-action pool to isolate scheduler accounting
+        # and acceptance from the quality of each policy's search heuristics.
+        route = {"option_id": "fixed_route", "focus_edge": [1, 2],
+                 "routing_order": [[0, 2], [1, 2]] if duplicate else [[1, 2], [0, 2]],
+                 "node_free_cells": [], "corridor": [[0, 1]]}
