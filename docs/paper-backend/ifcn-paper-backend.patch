+#!/usr/bin/env python3
+"""Validate cooperative-search output and exported candidates independently."""
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "src/python"))
+from ifcn.layout_validation import dag_from_candidate, validate_candidate
+from ifcn.verify_logic import verify_bytes
+
+SOURCE = b"module example(a,b,y); input a,b; output y; assign y=a&b; endmodule\n"
+
+
+def topology(candidate):
+    return {
+        "layers": candidate["layers"],
+        "nodes": sorted(candidate["nodes"], key=lambda node: node["id"]),
+        "edges": sorted(candidate["edges"]),
+        "routes": sorted(candidate["routes"], key=lambda route: (route["source"], route["target"])),
+        "cells": sorted(candidate["cells"], key=lambda cell: (cell["x"], cell["y"])),
+        "metrics": candidate["metrics"],
+    }
+
+
+def validate(candidate):
+    assert candidate["schema"] == "ifcn.native_candidate.v1"
+    assert candidate["algorithm"] == "multi_agent"
+    assert candidate["routed"] is True and candidate["native_mapping_valid"] is True
+    assert not candidate["native_validation_error"]
+    assert candidate["selected_seed"]
+    assert candidate["metrics"]["area_tiles"] > 0 and candidate["metrics"]["physical_cells"] > 0
+    assert {node["name"] for node in candidate["nodes"] if node["is_input"]} == {"a", "b"}
+    assert {node["name"] for node in candidate["nodes"] if node["is_output"]} == {"y"}
+    checked = validate_candidate(candidate, source_crossings=False)
+    assert checked["passed"], checked["errors"]
+    truth = verify_bytes(SOURCE, json.dumps(dag_from_candidate(candidate, checked)).encode(), max_inputs=2)
+    assert truth["status"] == "equivalent", truth
+    assert truth["vectors_checked"] == 4, truth
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--binary", type=Path, required=True)
+    args = parser.parse_args()
+    binary = args.binary.resolve()
+    with tempfile.TemporaryDirectory(prefix="ifcn-multi-agent-export-") as temporary:
+        directory = Path(temporary)
+        source = directory / "and.v"
+        source.write_bytes(SOURCE)
+        final = directory / "winner.json"
+        alternatives = directory / "alternatives"
+
+        def run(output, *extra):
+            return subprocess.run([str(binary), "multi_agent", str(source), str(output),
+                                   "--budget", "3", "--attempts", "12", *map(str, extra)],
+                                  cwd=directory, capture_output=True, text=True, timeout=15)
+
+        result = run(final, "--candidates-dir", alternatives)
+        assert result.returncode == 0, result.stdout + result.stderr
+        winner = json.loads(final.read_text())
+        validate(winner)
+        events = winner["multi_agent"]["events"]
+        assert events and {event["actor"] for event in events} == {"placement", "routing", "clock", "validation"}
+        assert all(isinstance(event["feedback"], str) and event["feedback"] for event in events)
+        assert all(isinstance(event["proposal"], str) and event["proposal"] for event in events)
+        accepted = [event for event in events if event["accepted"]]
+        assert accepted and all(event["actor"] == "validation" and event["valid"] for event in accepted)
+        seen = set()
+        feedback_reused = False
+        for event in events:
+            assert isinstance(event["attempt"], int) and 0 <= event["attempt"] <= 12
+            if event["actor"] == "routing" and event["parent"] and event["parent"] in seen:
+                feedback_reused = True
+            seen.add(event["proposal"])
+        assert feedback_reused, "No routing proposal refers to an earlier shared candidate or failed placement"
+        files = sorted(alternatives.iterdir())
+        assert files, "No legal candidates were exported"
+        assert [path.name for path in files] == [f"candidate_{number:06d}.json" for number in range(1, len(files) + 1)]
+        winner_seen = False
+        for path in files:
+            candidate = json.loads(path.read_text())
+            validate(candidate)
+            winner_seen |= topology(candidate) == topology(winner)
+        assert winner_seen, "Final winner geometry, clocks and metrics were not observed"
+
+        # Rejected output requests cannot destroy either the original winner or its candidates.
+        saved = {path.name: path.read_bytes() for path in files}
+        saved_winner = final.read_bytes()
+        duplicate = run(final, "--candidates-dir", alternatives)
+        assert duplicate.returncode != 0
+        assert final.read_bytes() == saved_winner
+        assert {path.name: path.read_bytes() for path in alternatives.iterdir()} == saved
+        occupied = directory / "occupied"
+        occupied.mkdir()
+        (occupied / "keep.txt").write_text("preserve me")
+        result = run(directory / "rejected.json", "--candidates-dir", occupied)
+        assert result.returncode != 0 and not (directory / "rejected.json").exists()
+        assert (occupied / "keep.txt").read_text() == "preserve me"
+        reserved = directory / "reserved"
+        result = run(reserved / "candidate_000001.json", "--candidates-dir", reserved)
+        assert result.returncode != 0 and not any(reserved.iterdir())
+
+        for flag, value in (("--budget", "0"), ("--attempts", "0")):
+            tag = flag.removeprefix("--")
+            failed = directory / f"invalid-{tag}.json"
+            invalid_pool = directory / f"invalid-{tag}"
+            result = run(failed, "--candidates-dir", invalid_pool, flag, value)
+            assert result.returncode != 0 and not any(invalid_pool.iterdir())
+            diagnostic = json.loads(failed.read_text())
+            assert diagnostic["algorithm"] == "multi_agent" and diagnostic["routed"] is False
+            assert diagnostic["multi_agent"]["events"] == []
+
+        plain = directory / "plain"
+        plain.mkdir()
+        result = run(plain / "winner.json")
+        assert result.returncode == 0, result.stdout + result.stderr
+        validate(json.loads((plain / "winner.json").read_text()))
+        assert sorted(path.name for path in plain.iterdir()) == ["winner.json"]
+        print(json.dumps({"passed": True, "legal_candidates_checked": len(files),
+                          "events_checked": len(events), "feedback_reused": feedback_reused,
+                          "winner_observed": winner_seen, "source_vectors_per_candidate": 4,
+                          "overwrite_protection": True}))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tests/test_multi_agent_control.py b/tests/test_multi_agent_control.py
new file mode 100644
index 0000000..ef8ffc1
--- /dev/null
+++ b/tests/test_multi_agent_control.py
@@ -0,0 +1,195 @@
+#!/usr/bin/env python3
+"""Replay the native controller protocol without any model/API dependency."""
+import argparse
+import json
+from pathlib import Path
+import subprocess
+import tempfile
+import time
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--binary", type=Path, required=True)
+    args = parser.parse_args()
+    with tempfile.TemporaryDirectory(prefix="ifcn-control-") as tmp:
+        directory = Path(tmp)
+        source = directory / "and.v"
+        source.write_text("module m(input a,b, output y); assign y=a&b; endmodule\n")
+
+        def command(name, *, control=True, feedback=True, attempts=1, budget=0.5, algorithm="multi_agent", max_nodes=None):
+            output = directory / (name + ".json")
+            argv = [str(args.binary.resolve()), algorithm, str(source), str(output),
+                    "--attempts", str(attempts), "--budget", str(budget)]
+            if control:
+                argv.append("--agent-control")
+            if not feedback:
+                argv.append("--no-feedback")
+            if max_nodes is not None:
+                argv += ["--max-nodes", str(max_nodes)]
+            return argv, output
+
+        def run(name, response="", **kwargs):
+            argv, output = command(name, **kwargs)
+            result = subprocess.run(argv, input=response, capture_output=True, text=True,
+                                    cwd=directory, timeout=5)
+            assert result.returncode in (0, 10), result.stdout + result.stderr
+            candidate = json.loads(output.read_text())
+            stats = candidate["multi_agent"]["graph_stats"]
+            assert stats["topology"] == "optimized_compact"
+            assert all(stats[key] > 0 for key in ("nodes", "edges", "max_layer_width", "topological_depth"))
+            assert candidate["multi_agent"]["large_graph_profile"] is False
+            requests = [json.loads(line.removeprefix("IFCN_AGENT_REQUEST "))
+                        for line in result.stdout.splitlines() if line.startswith("IFCN_AGENT_REQUEST ")]
+            for request in requests:
+                assert request["schema"] == "ifcn.agent_control.v1"
+                assert request["suggested_action"] in request["available_actions"]
+                assert request["remaining_seconds"] >= 0
+                assert request["graph_stats"] == stats
+                detail = request["last_proposal"]
+                assert detail["missing_edges_scope"] == "unrouted_including_unattempted"
+                assert detail["route_count_scope"] == "last_retained_ordering"
+                assert len(detail["observed_conflicts"]) <= 8
+                if detail["proposal"]:
+                    assert detail["reason"]
+                    assert detail["routed_edges"] + detail["missing_edges"] == detail["edges"]
+                    assert detail["nodes"] > 0 and detail["width"] > 0 and detail["height"] > 0
+                    assert all(item["observations"] > 0 for item in detail["observed_conflicts"])
+            return candidate, requests
+
+        baseline, requests = run("local", control=False)
+        inspected = subprocess.run([str(args.binary.resolve()), "inspect", str(source)],
+                                   capture_output=True, text=True, check=True, timeout=5)
+        topology_counts = json.loads(inspected.stdout)
+        assert topology_counts["schema"] == "ifcn.netlist_size.v1"
+        assert topology_counts["topologies"][0] == baseline["multi_agent"]["graph_stats"]
+        assert topology_counts["max_candidate_nodes"] == max(item["nodes"] for item in topology_counts["topologies"])
+        assert len(baseline["nodes"]) <= topology_counts["max_candidate_nodes"]
+        assert not requests
+        assert "control_events" not in baseline["multi_agent"]
+        assert baseline["multi_agent"]["feedback_enabled"] is True
+        baseline_first = baseline["multi_agent"]["events"][0]
+        assert "graphviz" in baseline_first["proposal"]
+
+        chosen, requests = run("ordered", "IFCN_AGENT_RESPONSE ordered\n")
+        assert "ordered" in requests[0]["available_actions"]
+        first = chosen["multi_agent"]["events"][0]
+        assert "ordered" in first["proposal"] and "graphviz" not in first["proposal"]
+        assert "external policy selected ordered" in first["feedback"]
+        assert chosen["multi_agent"]["control_events"][0]["status"] == "selected"
+
+        default, requests = run("default", "IFCN_AGENT_RESPONSE all\n" * 2, attempts=2)
+        event = default["multi_agent"]["control_events"][0]
+        assert event["status"] == "default_requested"
+        assert event["action"] == requests[0]["suggested_action"]
+        assert "unavailable" not in default["multi_agent"]["events"][0]["feedback"]
+        assert len(requests) == 2
+        assert requests[1]["last_proposal"]["proposal"] == default["multi_agent"]["events"][0]["proposal"]
+        validations = [item for item in default["multi_agent"]["events"] if item["actor"] == "validation"]
+        assert requests[1]["last_proposal"] == validations[0]["diagnostics"]
+
+        independent, requests = run("no-feedback", control=False, feedback=False, attempts=4)
+        assert not requests
+        assert independent["multi_agent"]["feedback_enabled"] is False
+        assert independent["multi_agent"]["coordination"] == "independent_portfolio"
+        assert all(not item["parent"] for item in independent["multi_agent"]["events"])
+        assert len(independent["attempts"]) == 4
+        assert all("repair" not in item["seed"] and not item["seed"].endswith(("_compact", "_reroute"))
+                   for item in independent["attempts"])
+        assert independent["multi_agent"]["graph_stats"] == baseline["multi_agent"]["graph_stats"]
+
+        rejected, requests = run("oversized-topologies", max_nodes=2)
+        assert not requests and not rejected["attempts"] and not rejected["multi_agent"]["events"]
+        assert "maximum candidate node count" in rejected["native_validation_error"]
+        for value in (0, -1, "three"):
+            argv, output = command("bad-node-limit-" + str(value), control=False, max_nodes=value)
+            result = subprocess.run(argv, capture_output=True, text=True, timeout=3)
+            assert result.returncode == 1 and not output.exists()
+
+        compact_source = directory / "compact_only.v"
+        compact_source.write_text("module m(input a,b,output y); wire w0,w1; "
+                                  "assign w0=a&b; assign w1=w0&b; assign y=w1&b; endmodule\n")
+        inspected = subprocess.run([str(args.binary.resolve()), "inspect", str(compact_source)],
+                                   capture_output=True, text=True, check=True, timeout=3)
+        sizes = {item["topology"]: item["nodes"] for item in json.loads(inspected.stdout)["topologies"]}
+        assert sizes["optimized_compact"] < sizes["layer_buffered"]
+        limit = sizes["optimized_compact"]
+        for algorithm in ("multi_agent", "irregular"):
+            argv, output = command("compact-only-" + algorithm, algorithm=algorithm, control=False,
+                                   max_nodes=limit, attempts=12)
+            argv[2] = str(compact_source)
+            snapshots = directory / ("compact-snapshots-" + algorithm)
+            result = subprocess.run(argv + ["--candidates-dir", str(snapshots)],
+                                    capture_output=True, text=True, timeout=5)
+            assert result.returncode in (0, 10), result.stdout + result.stderr
+            value = json.loads(output.read_text())
+            assert value["attempts"], "Allowed compact topology was not searched"
+            assert len(value["nodes"]) <= limit
+            assert all("graphviz_buffered" not in attempt["seed"] and
+                       not attempt["seed"].endswith("_graphviz_40x40") for attempt in value["attempts"])
+            for path in snapshots.glob("candidate_*.json"):
+                assert len(json.loads(path.read_text())["nodes"]) <= limit
+            if algorithm == "multi_agent":
+                assert all(item["diagnostics"]["nodes"] <= limit for item in value["multi_agent"]["events"])
+                assert all(item["diagnostics"]["time_slice_seconds"] > 0 for item in value["multi_agent"]["events"])
+
+        for name, response, status in (
+            ("eof", "", "eof_fallback"),
+            ("unknown", "IFCN_AGENT_RESPONSE imaginary\n", "invalid_action_fallback"),
+            ("unavailable", "IFCN_AGENT_RESPONSE repair\n", "invalid_action_fallback"),
+            ("oversized", "x" * 400 + "\nIFCN_AGENT_RESPONSE ordered\n", "response_too_large_fallback"),
+        ):
+            value, requests = run(name, response, attempts=2)
+            control = value["multi_agent"]["control_events"]
+            assert control[0]["status"] == status, control
+            assert control[0]["action"] == requests[0]["suggested_action"]
+            assert "graphviz" in value["multi_agent"]["events"][0]["proposal"]
+            if name == "unavailable":
+                assert requests[0]["pending_repairs"] == 0
+                assert "repair" not in requests[0]["available_actions"]
+            if name in ("eof", "oversized"):
+                assert len(control) == len(requests) == 1, "Disabled input was reused on another proposal"
+
+        # Leave stdin open without a reply; the native deadline must stop the
+        # wait even when there is no Python supervisor to terminate the child.
+        argv, output = command("timeout", budget=0.15)
+        started = time.monotonic()
+        process = subprocess.Popen(argv, stdin=subprocess.PIPE, stdout=subprocess.PIPE,
+                                   stderr=subprocess.PIPE, text=True, cwd=directory)
+        try:
+            process.wait(timeout=3)
+            stdout, stderr = process.communicate(timeout=1)
+        finally:
+            if process.poll() is None:
+                process.kill()
+                process.communicate()
+        assert time.monotonic() - started < 3
+        value = json.loads(output.read_text())
+        assert value["multi_agent"]["control_events"][0]["status"] == "timeout_fallback", stdout + stderr
+        assert value["search_budget_expired"] is True
+        assert value["multi_agent"]["graph_stats"] == baseline["multi_agent"]["graph_stats"]
+
+        argv, output = command("wrong-algorithm", algorithm="irregular")
+        result = subprocess.run(argv, input="", capture_output=True, text=True, timeout=3)
+        assert result.returncode != 0 and "requires multi_agent" in result.stderr
+        assert not output.exists()
+        for name, options, error in (
+            ("no-feedback-wrong-algorithm", {"algorithm": "irregular", "control": False, "feedback": False},
+             "--no-feedback requires multi_agent"),
+            ("incompatible-controls", {"feedback": False}, "cannot be combined"),
+        ):
+            argv, output = command(name, **options)
+            result = subprocess.run(argv, input="", capture_output=True, text=True, timeout=3)
+            assert result.returncode != 0 and error in result.stderr
+            assert not output.exists()
+        print(json.dumps({"passed": True, "protocol_cases": 12,
+                          "node_limit_cases": 6,
+                          "selected_action_changes_native_proposal": True,
+                          "graph_and_proposal_diagnostics": True,
+                          "feedback_ablation_has_no_shared_proposals": True,
+                          "node_limit_filters_each_topology_before_routing": True,
+                          "eof_invalid_unavailable_oversized_timeout_fallback": True}))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tests/test_multi_agent_llm.py b/tests/test_multi_agent_llm.py
new file mode 100644
