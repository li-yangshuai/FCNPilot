@@ -0,0 +1,101 @@
+#pragma once
+
+#include "irregularLayout.h"
+
+namespace fcngraph {
+
+struct MultiAgentGraphStats {
+    // Stable circuit-scale reference: optimizeAIOG_DRC + optimizeBufferNode.
+    // Buffered candidates can have more nodes; each proposal reports its own.
+    std::string topology = "optimized_compact";
+    std::size_t nodeCount = 0;
+    std::size_t edgeCount = 0;
+    std::size_t maxLayerWidth = 0;
+    std::size_t topologicalDepth = 0;
+};
+
+struct MultiAgentRoutingConflict {
+    int source = -1, target = -1;
+    unsigned int sourceX = 0, sourceY = 0, targetX = 0, targetY = 0;
+    std::size_t observations = 0;
+};
+
+struct MultiAgentProposalDiagnostics {
+    std::string proposal;
+    std::string reason;
+    std::size_t nodeCount = 0, edgeCount = 0;
+    // The last retained route ordering, not a claim that all missing edges
+    // were attempted or failed. Conflicts below are actual observed failures.
+    std::size_t routedEdges = 0, missingEdges = 0;
+    std::uint64_t width = 0, height = 0;
+    std::size_t routingConflicts = 0, clockRejections = 0;
+    int insertedRows = 0, insertedColumns = 0;
+    double timeSliceSeconds = 0.0;
+    std::vector<MultiAgentRoutingConflict> conflicts;
+};
+
+// An auditable message on the cooperative search's shared candidate board.
+// attempt identifies one bounded proposal (several agents may discuss it).
+struct MultiAgentEvent {
+    int attempt = 0;
+    std::string actor;
+    std::string proposal;
+    std::string parent;
+    std::string feedback;
+    bool valid = false;
+    bool accepted = false;
+    CombinationalLayoutMetrics metrics;
+    double elapsedSeconds = 0.0;
+    MultiAgentProposalDiagnostics diagnostics;
+};
+
+struct MultiAgentLayoutResult : IrregularLayoutResult {
+    std::vector<MultiAgentEvent> agentEvents;
+    MultiAgentGraphStats graphStats;
+    bool feedbackEnabled = true;
+    bool largeGraphProfile = false;
+};
+
+struct MultiAgentDecisionContext {
+    int attempt = 0;
+    int attemptLimit = 0;
+    double remainingSeconds = 0.0;
+    bool hasIncumbent = false;
+    CombinationalLayoutMetrics bestMetrics;
+    std::size_t beamSize = 0;
+    std::size_t pendingRepairs = 0;
+    std::vector<std::string> availableActions;
+    std::string suggestedAction;
+    std::string lastFeedback;
+    std::size_t nodeCount = 0, edgeCount = 0, maxLayerWidth = 0, topologicalDepth = 0;
+    MultiAgentProposalDiagnostics lastProposal;
+};
+
+struct MultiAgentSearchOptions {
+    // Ablation: identical fresh-placement portfolio and exact acceptance,
+    // but no shared-candidate refinement or failed-placement repair.
+    // External feedback policies are incompatible with this ablation.
+    bool feedbackEnabled = true;
+};
+
+// Optional external controller (for example an LLM JSONL bridge). It selects
+// one advertised action: explore/graphviz/elastic/ordered/repair/compact/reroute.
+// Graphviz explores compact and layer-buffered topologies independently;
+// the node cap can remove one topology while leaving the action available.
+// Empty or unavailable responses retain the suggested action and are logged.
+// Exceptions propagate to the caller; policy time counts against the budget.
+using MultiAgentPolicyCallback = std::function<std::string(const MultiAgentDecisionContext&)>;
+
+// Deterministic, feedback-driven algorithmic agents; no network/model service.
+// maxAttempts bounds the total proposals, not each agent's separate budget.
+// Only globally clock-consistent, physically DRC-clean candidates enter the
+// shared beam or reach onCandidate. Source truth/physical dynamics remain
+// separate checks, as with searchIrregularLayout.
+MultiAgentLayoutResult searchMultiAgentLayout(
+    const std::string& sourceFile,
+    const IrregularLayoutOptions& options = {},
+    const GraphDrawSearchCallback& progress = {},
+    const MultiAgentPolicyCallback& policy = {},
+    const MultiAgentSearchOptions& controls = {});
+
+} // namespace fcngraph
