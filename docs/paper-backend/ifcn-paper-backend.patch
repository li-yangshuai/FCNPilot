+    assert.deepEqual(evidence.context.options, cooperationRequest.context.options);
+    assert.deepEqual(evidence.prior_messages, cooperationRequest.prior_messages);
+    assert.equal(evidence.snapshot_id, cooperationRequest.snapshot_id);
+  }
+  assert.deepEqual(cooperationRequest, before);
+  assert.match(prompts[0].systemPrompt, /reassigning phases alone cannot repair/);
+});
+
+test("cooperation auto-dispatch returns a bounded role-owned option with usage", async () => {
+  const result = await decide(cooperationRequest, { runtimeFactory: factory({ stopReason: "stop",
+    content: [{ type: "text", text: JSON.stringify(cooperationDecision) }], usage: { input: 31, output: 9 } }) });
+  assert.equal(result.schema, "ifcn.cooperation_model_result.v1");
+  assert.equal(result.status, "ok");
+  assert.deepEqual(result.decision, cooperationDecision);
+  assert.equal(result.model_call_started, true);
+  assert.equal(result.usage.input, 31);
+  assert.match(result.response_sha256, /^[a-f0-9]{64}$/);
+});
+
+test("cooperation omits the SDK reasoning option while legacy control keeps minimal", async () => {
+  for (const [input, output, expected] of [
+    [cooperationRequest, cooperationDecision, "omitted"], [request, decision, "minimal"],
+  ]) {
+    let captured;
+    const result = await decide(input, { runtimeFactory: async () => ({ provider: "offline-test", model: "fake",
+      complete: async (_prompt, options) => {
+        captured = options;
+        return { stopReason: "stop", content: [{ type: "text", text: JSON.stringify(output) }] };
+      },
+    }) });
+    assert.equal(result.status, "ok");
+    assert.equal(result.parameters.reasoning, expected);
+    if (expected === "omitted") assert.equal(Object.hasOwn(captured, "reasoning"), false);
+    else assert.equal(captured.reasoning, "minimal");
+    assert.equal(captured.maxTokens, 128);
+    assert.equal(captured.maxRetries, 0);
+  }
+});
+
+test("cooperation rejects fabricated options, role or snapshot drift, and action overrides", () => {
+  for (const override of [
+    { option_id: "invented-route" }, { role: "placement" }, { snapshot_id: "different-geometry" },
+    { schema: "ifcn.agent_decision.v1" }, { moves: [{ node: 2, x: 9, y: 9 }] }, { rationale: "   " },
+  ]) assert.throws(() => validateCooperationDecision({ ...cooperationDecision, ...override }, cooperationRequest),
+    error => error.code === "invalid_response");
+  assert.deepEqual(validateCooperationDecision(cooperationDecision, cooperationRequest), cooperationDecision);
+});
+
+test("malformed cooperation evidence is rejected before starting a model call", async () => {
+  const cases = [
+    { context: { options: [] } },
+    { context: { options: [{ option_id: "same" }, { option_id: "same" }] } },
+    { context: { options: Array.from({ length: 65 }, (_, i) => ({ option_id: `option-${i}` })) } },
+    { context: { options: ["not-an-option-object"] } },
+    { context: { options: [{ option_id: "bad\nid" }] } },
+    { context: { options: [{ option_id: "ok", oversized: "a".repeat(1024 * 1024) }] } },
+    { prior_messages: [{ ...cooperationRequest.prior_messages[0], snapshot_id: "stale-geometry" }] },
+    { prior_messages: [{ ...cooperationRequest.prior_messages[0], role: "unrecognized" }] },
+    { prior_messages: Array(25).fill(cooperationRequest.prior_messages[0]) },
+    { role: "validation" }, { snapshot_id: "" },
+  ];
+  for (const override of cases) {
+    let started = false;
+    const result = await decide({ ...cooperationRequest, ...override }, { runtimeFactory: async () => {
+      started = true;
+      throw new Error("Should not reach runtime for invalid evidence");
+    } });
+    assert.equal(started, false);
+    assert.equal(result.schema, "ifcn.cooperation_model_result.v1");
+    assert.equal(result.error.code, "invalid_input");
+    assert.equal(result.model_call_started, false);
+  }
+});
+
+test("cooperation cannot execute a stale completion and keeps provider errors sanitized", async () => {
+  const result = await decide(cooperationRequest, { runtimeFactory: factory({ stopReason: "stop",
+    content: [{ type: "text", text: JSON.stringify({ ...cooperationDecision, snapshot_id: "stale" }) }] }) });
+  assert.equal(result.status, "error");
+  assert.equal(result.error.code, "invalid_response");
