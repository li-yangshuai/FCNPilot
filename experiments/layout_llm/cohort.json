    {
      "at": "2026-09-08T03:35:57.915572+00:00",
      "before_sha256": "b47783266577c22e99867e5e455b8cfaf4b3a0439378373929632c3681344675",
      "after_sha256": "422914c409b8bc0ec0041f31d1682a6335bf58e335027b2538868aa4b41203b9",
      "old_usage_function": "def usage_total(rounds, run_id, policy):\n    values = [r.get(\"proposal\", {}).get(\"usage\") for r in rounds\n              if policy == \"llm\" and (RUNS / run_id / \"rounds\" / f\"{r['id']:02d}\" / \"request.json\").is_file()]\n    if not values:\n        return None\n    return {\"reported_calls\": sum(isinstance(v, dict) for v in values), \"missing_calls\": sum(not isinstance(v, dict) for v in values),\n            **{key: sum(v.get(key, 0) for v in values if isinstance(v, dict)) for key in (\"input\", \"output\", \"cacheRead\", \"cacheWrite\", \"reasoning\", \"totalTokens\")}}\n",
      "new_usage_function": "def usage_total(rounds, run_id, policy):\n    values = []\n    for row in rounds:\n        directory = RUNS / run_id / \"rounds\" / f\"{row['id']:02d}\"\n        if policy != \"llm\" or not (directory / \"request.json\").is_file():\n            continue\n        response = directory / \"response.json\"\n        audit = json.loads(response.read_text()) if response.is_file() else {}\n        usage = audit.get(\"usage\")\n        # SDK default zero counters after a provider error are not evidence of\n        # zero billed tokens. Preserve that response but report usage unknown.\n        if not isinstance(usage, dict) or (audit.get(\"status\") != \"ok\" and not usage.get(\"totalTokens\")):\n            usage = None\n        values.append(usage)\n    if not values:\n        return None\n    keys = (\"input\", \"output\", \"cacheRead\", \"cacheWrite\", \"reasoning\", \"totalTokens\")\n    numeric = lambda value: isinstance(value, (int, float)) and not isinstance(value, bool)\n    known = {key: sum(v[key] for v in values if isinstance(v, dict) and numeric(v.get(key))) for key in keys}\n    complete = {key: all(isinstance(v, dict) and numeric(v.get(key)) for v in values) for key in keys}\n    return {\"calls\": len(values), \"reported_calls\": sum(isinstance(v, dict) for v in values),\n            \"missing_calls\": sum(not isinstance(v, dict) for v in values), \"known_totals\": known,\n            **{key: known[key] if complete[key] else None for key in keys}}\n",
      "reason": "Reporting-only fix for provider-error null reasoning/default-zero usage: classify missing usage as unknown and keep reported lower bounds. Existing eight campaigns are not rerun; no model retries."
    }
  ],
